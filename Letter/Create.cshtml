    <script>
        $(document).ready(function() {
            // اطمینان از باز شدن مودال سایر گیرندگان
            $(document).on('click', '#girandeganselect', function(){
                const el = document.getElementById('Copyreciversmodal');
                if (window.bootstrap && bootstrap.Modal) {
                    bootstrap.Modal.getOrCreateInstance(el).show();
                }
            });

            // داده کامل درخت سازمان‌ها برای سایر گیرندگان (برای فیلتر بر اساس گیرنده اصلی)
            var allOrgNodes = [
                @foreach (var main in orgs.Where(o=>o.IsMain)) {
                    @: { id: "@main.Id", parent: "#", text: "@main.Name", icon: "fas fa-building" },
                    foreach (var sub in orgs.Where(o=>o.ParentId==main.Id)) {
                        @: { id: "@sub.Id", parent: "@main.Id", text: "@sub.Name", icon: "fas fa-sitemap" },
                        foreach (var child in orgs.Where(o=>o.ParentId==sub.Id)) {
                            @: { id: "@child.Id", parent: "@sub.Id", text: "@child.Name", icon: "fas fa-sitemap" },
                            foreach (var leaf in orgs.Where(o=>o.ParentId==child.Id)) {
                                @: { id: "@leaf.Id", parent: "@child.Id", text: "@leaf.Name", icon: "fas fa-sitemap" },
                            }
                        }
                    }
                }
            ];

            function buildCopyTree(excludedId){
                try {
                    if ($.jstree.reference('#organizationTreeJs')) {
                        $('#organizationTreeJs').jstree('destroy');
                    }
                } catch(e){}
                var data = allOrgNodes.slice();
                // اگر قرار است صرفا نمایش داده نشود، آن گره را hide می‌کنیم بعد از init
                $('#organizationTreeJs').jstree({
                    core: { data: data, themes: { stripes: true } },
                    checkbox: { keep_selected_style: false, three_state: true },
                    plugins: ['checkbox', 'search']
                }).on('ready.jstree', function(){
                    if (excludedId) {
                        var core = $('#organizationTreeJs').jstree(true);
                        try { core.hide_node(excludedId.toString()); } catch(e){}
                    }
                });
            }

            // مقداردهی اولیه درخت رونوشت با حذف گیرنده اصلی در صورت وجود
            buildCopyTree($('#Receiver').val());

            function isNodeDisabled(id){
                try {
                    var core = $('#organizationTreeJs').jstree(true);
                    return core && core.is_disabled(id);
                } catch(e){ return false; }
            }

            // نمایش فیلد پیام برای انتخاب‌ها (به‌جز نودهای غیرفعال)
            $('#organizationTreeJs').on('changed.jstree', function (e, data) {
                var selected = data.selected || [];
                var $notes = $('#selectedNotes');
                $notes.empty();
                selected.forEach(function(id){
                    if (isNodeDisabled(id)) return;
                    var node = data.instance.get_node(id);
                    // ساخت مسیر کامل سلسله مراتبی برای برچسب
                    var label = (function getFullPath(n){
                        var names = [n.text];
                        var parent = data.instance.get_node(n.parent);
                        while (parent && parent.id !== '#') {
                            names.unshift(parent.text);
                            parent = data.instance.get_node(parent.parent);
                        }
                        return names.join('-');
                    })(node);
                    var inputId = 'note-'+id;
                    var item = '<div class="note-item">' +
                        '<label for="'+inputId+'">' +
                            '<i class="fas fa-building me-2"></i>' + label +
                        '</label>' +
                        '<input type="text" class="form-control form-control-sm org-note" ' +
                        'data-org-id="'+id+'" id="'+inputId+'" ' +
                        'placeholder="پیام اختصاصی برای '+label+'" ' +
                        'maxlength="200" />' +
                        '<div class="note-counter">0/200</div>' +
                    '</div>';
                                    $notes.append(item);
                
                // اضافه کردن event listener برای شمارنده کاراکترها
                var $input = $('#' + inputId);
                var $counter = $input.siblings('.note-counter');
                
                $input.on('input', function() {
                    var length = $(this).val().length;
                    $counter.text(length + '/200');
                    
                    if (length > 180) {
                        $counter.addClass('text-warning');
                    } else {
                        $counter.removeClass('text-warning');
                    }
                    
                    if (length > 195) {
                        $counter.addClass('text-danger');
                    } else {
                        $counter.removeClass('text-danger');
                    }
                });
            });
        });

            // jstree برای انتخاب گیرنده اصلی

            $("#confirmSelection").click(function() {
                var selectedOrgs = [];
                var selectedIds = $('#organizationTreeJs').jstree(true).get_selected();
                selectedIds.forEach(function(id){
                    if (isNodeDisabled(id)) return; // حذف گیرنده اصلی
                    var note = $('#selectedNotes').find('input.org-note[data-org-id="'+id+'"]').val() || '';
                    var node = $('#organizationTreeJs').jstree(true).get_node(id);
                    selectedOrgs.push({ id: id, name: node ? node.text : id, note: note });
                });
                var idsOnly = selectedOrgs.map(function(o){ return o.id; });
                $("#selectedOrganizations").val(idsOnly.join(','));
                $("#selectedOrganizationsNotes").val(JSON.stringify(selectedOrgs));
                const el = document.getElementById('Copyreciversmodal');
                if (window.bootstrap && bootstrap.Modal) {
                    bootstrap.Modal.getOrCreateInstance(el).hide();
                }
            });

            // حذف تمام رویدادهای تغییر که باعث انتخاب خودکار می‌شدند
        });
    </script>
