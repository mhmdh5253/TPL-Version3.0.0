            });

            // مقداردهی درخت گیرنده اصلی و انتخاب آن
            try {
                var receiverTreeData = [
                    @foreach (var main in orgs.Where(o=>o.IsMain)) {
                        @: { "id": "@main.Id", "parent": "#", "text": "@main.Name", "icon": "fas fa-building", "full": "@main.Name" },
                        foreach (var sub in orgs.Where(o=>o.ParentId==main.Id)) {
                            @: { "id": "@sub.Id", "parent": "@main.Id", "text": "@sub.Name", "icon": "fas fa-sitemap", "full": "@main.Name-@sub.Name" },
                            foreach (var child in orgs.Where(o=>o.ParentId==sub.Id)) {
                                @: { "id": "@child.Id", "parent": "@sub.Id", "text": "@child.Name", "icon": "fas fa-sitemap", "full": "@main.Name-@sub.Name-@child.Name" },
                                foreach (var leaf in orgs.Where(o=>o.ParentId==child.Id)) {
                                    @: { "id": "@leaf.Id", "parent": "@child.Id", "text": "@leaf.Name", "icon": "fas fa-sitemap", "full": "@main.Name-@sub.Name-@child.Name-@leaf.Name" },
                                }
                            }
                        }
                    }
                ];

                $('#ReceiverTree').jstree({
                    core: { data: receiverTreeData, themes: { stripes: true } },
                    plugins: ['search']
                });

                $('#ReceiverTree').off('select_node.jstree').on('select_node.jstree', function (e, data) {
                    var id = data.node.id;
                    var node = data.instance.get_node(id);
                    var full = (node && node.original && node.original.full) ? node.original.full : data.node.text;
                    $('#Receiver').val(id);
                    $('#ReceiverText').val(full);
                    // بازسازی درخت رونوشت بدون نمایش گیرنده اصلی
                    buildCopyTree(id);
                    const el = document.getElementById('ReceiverSelectModal');
                    if (window.bootstrap && bootstrap.Modal) {
                        bootstrap.Modal.getOrCreateInstance(el).hide();
                    }
                });
