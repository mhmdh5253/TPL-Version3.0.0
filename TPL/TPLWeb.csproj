<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<!-- فعال کردن آنالایزرها برای بهبود کیفیت کد -->
		<RunAnalyzers>true</RunAnalyzers>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<WarningsAsErrors />
	</PropertyGroup>
	<PropertyGroup>
		<Nullable>enable</Nullable>
		<!-- حذف NoWarn برای مشاهده تمام warnings -->
	</PropertyGroup>
	<PropertyGroup>
		<StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<TypeScriptTarget>ES6</TypeScriptTarget>
		<TypeScriptToolsVersion>5.4</TypeScriptToolsVersion>
		<DebugType>portable</DebugType>
		<Optimize>False</Optimize>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<TypeScriptTarget>ES6</TypeScriptTarget>
		<TypeScriptToolsVersion>5.4</TypeScriptToolsVersion>
		<DebugType>none</DebugType>
		<Optimize>True</Optimize>
	</PropertyGroup>

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>cfeb7449-2c04-4985-9101-cfb2860540f2</UserSecretsId>
		<PublishAot>False</PublishAot>
		<ApplicationIcon>wwwroot\CompanyVariables\favicon\favicon.ico</ApplicationIcon>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<AllowUnsafeBlocks>False</AllowUnsafeBlocks>
		<Copyright>All Rights Reserved For TPL</Copyright>
		<AssemblyVersion>2.0.0.3</AssemblyVersion>
		<FileVersion>2.0.0.3</FileVersion>
		<RunAnalyzersDuringBuild>True</RunAnalyzersDuringBuild>
	</PropertyGroup>
	

	<PropertyGroup>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>
	<!--Pre-build events for frontend assets-->
	<Target Name="PreBuild" BeforeTargets="PreBuildEvent">
		<Exec Command="npm install" WorkingDirectory="$(ProjectDir)" ContinueOnError="false" />
		<Exec Command="npm run build" WorkingDirectory="$(ProjectDir)" ContinueOnError="false" />
		<Exec Command="npm run gulp:build" WorkingDirectory="$(ProjectDir)" ContinueOnError="false" />
	</Target>


