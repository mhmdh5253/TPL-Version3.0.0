<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <!-- حذف هدرهای CSP را به برنامه می‌سپاریم (NWebsec). اگر پراکسی بالادستی CSP اضافه می‌کند، اینجا می‌توانید آن را remove کنید. -->
        <!-- نمونه: <remove name="Content-Security-Policy" /> -->
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
