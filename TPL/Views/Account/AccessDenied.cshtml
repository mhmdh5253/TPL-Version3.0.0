@{
    ViewData["Title"] = "دسترسی غیر مجاز";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="~/CompanyVariables/favicon/favicon.ico" />
    <!-- فونت ایران سنس -->
    <link rel="stylesheet" href="~/assets/vendor/fonts/IRANSans.css" />

    <!-- آیکون‌های FontAwesome -->
    <link href="@Url.Content("~/libs/@fortawesome/fontawesome-free/css/all.min.css")" rel="stylesheet" />
    <link rel="manifest" href="/manifest.json" />
    <link href="~/modified/accessdenied.css" rel="stylesheet" />
    <!-- استایل‌های سفارشی -->

</head>

<body>
    <div class="error-container">
        <div class="error-icon floating-icon">
            <i class="fas fa-lock fa-3x"></i>
        </div>

        <h1 class="error-code">403</h1>
        <h2 class="error-title">دسترسی غیرمجاز</h2>
        <br />
        <div class="security-badge">
            <i class="fas fa-shield-alt"></i>
            <span>منطقه امنیتی</span>
        </div>

        <p class="error-message">
            <i class="fas fa-exclamation-triangle" style="color: var(--error-color);"></i>
            دسترسی به این بخش فقط برای کاربران با سطح دسترسی مدیریت امکان‌پذیر است.
            <br>
            لطفاً در صورت نیاز به دسترسی، با مسئول سیستم تماس بگیرید.
        </p>

        <div class="error-details">
            <i class="fas fa-info-circle" style="color: var(--error-color); margin-left: 5px;"></i>
            این صفحه حاوی اطلاعات حساس و محرمانه است و طبق سیاست‌های امنیتی سیستم،
            دسترسی به آن محدود شده است.
        </div>

        <a asp-controller="Home" asp-action="Index" class="btn-return">
            <i class="fas fa-home"></i>
            بازگشت به صفحه اصلی
        </a>
    </div>

    <!-- اسکریپت‌های ساده -->
    <script src="~/assets/vendor/libs/jquery/jquery.js"></script>
    <script src="@Url.Content("~/libs/@fortawesome/fontawesome-free/js/all.min.js")"></script>
    
    <!-- Disable Service Worker for error pages -->
    <script>
        // Disable service worker registration on error pages
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.getRegistrations().then(function(registrations) {
                for(let registration of registrations) {
                    registration.unregister();
                }
            });
        }
        

    </script>
    
    <script>
        $(document).ready(function() {
            // انیمیشن ظاهر شدن
            $('.error-container').hide().fadeIn(600);

            // افکت هنگام هاور روی دکمه
            $('.btn-return').hover(
                function() {
                    $(this).css('transform', 'translateY(-3px)');
                },
                function() {
                    $(this).css('transform', 'translateY(0)');
                }
            );
        });
    </script>
</body>
</html>