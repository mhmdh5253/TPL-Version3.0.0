@using Microsoft.AspNetCore.Mvc.TagHelpers
@model TPLWeb.Models.RegisterWhitPhone
<!DOCTYPE html>
@{
    ViewData["Title"] = "تایید موبایل";
    Layout = null;
    bool resetpassword = ViewBag.resetpassword;
}
<html lang="en" class="light-style" dir="rtl" data-theme="theme-default" data-assets-path="../../assets/" data-template="vertical-menu-template">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="~/CompanyVariables/favicon/favicon.ico" />
    <link rel="manifest" href="/manifest.json" />
    <link href="@Url.Content("~/libs/@fortawesome/fontawesome-free/css/all.min.css")" rel="stylesheet" />
    <link rel="stylesheet" href="~/assets/vendor/css/rtl/core.css" class="template-customizer-core-css" />
    <link rel="stylesheet" href="~/assets/vendor/css/rtl/theme-default.css" class="template-customizer-theme-css" />
    <link rel="stylesheet" href="~/assets/vendor/fonts/IRANSans.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/formvalidation/dist/css/formValidation.min.css" />
    <link rel="stylesheet" href="~/assets/vendor/css/pages/page-auth.css">
</head>
<style>
    .DIRLTR {
        direction: ltr;
    }

</style>
<body>
    <div class="position-relative">
        <div class="authentication-wrapper authentication-basic container-p-y">
            <div class="authentication-inner py-4">

                <!-- Login -->
                <div class="card p-2">
                    <!-- Logo -->
                    <div class="row">
                        <div class="input-field col">
                            <img style="display: block; margin-left: auto; margin-right: auto; width: 50%;" width="100" src="~/CompanyVariables/favicon/logo.png" alt="">
                            <h5 style="text-align: center;">شرکت شیلنگ های مسلح قم</h5>
                        </div>
                        <span class="text-danger">@Html.ValidationSummary()</span>
                    </div>
                    <!-- /Logo -->
                    <div class="card-body mt-2">
                        <form asp-controller="Account" asp-action="ConfirmMobile" class="mb-3" asp-route-returnurl="@ViewData["ReturnUrl"]" asp-route-resetpass="@resetpassword" method="post">
                            <input hidden asp-for="Phone" />
                            <input hidden asp-for="Code" />
                            @Html.AntiForgeryToken()
                            <div class="form-floating form-floating-outline mb-3">
                                <input asp-for="SmsCode" type="text" class="form-control DIRLTR" maxlength="6"
                                       placeholder="000-000" autofocus>
                                <label asp-for="SmsCode">لطفا کد ارسالی را وارد نمایید</label>
                                <span asp-validation-for="SmsCode"></span>
                            </div>
                            <div class="mb-3">
                                <button class="btn btn-primary d-grid w-100" type="submit">ارسال</button>
                            </div>
                            
                            <!-- Resend OTP Section -->
                            <div class="text-center mb-3">
                                <div id="resend-section" style="display: none;">
                                    <button type="button" id="resend-btn" class="btn btn-outline-secondary btn-sm">
                                        <i class="fas fa-redo me-1"></i>ارسال مجدد کد تایید
                                    </button>
                                </div>
                                <div id="timer-section">
                                    <small class="text-muted">
                                        ارسال مجدد کد تایید در <span id="countdown">120</span> ثانیه
                                    </small>
                                </div>
                            </div>
                        </form>

                    </div>
                    <hr class="mt-0" />
                    <div class="d-flex justify-content-between align-items-center" style="font-family: Arial, sans-serif; font-size: 14px; padding: 10px;">
                        <a href="@Url.Action("Login","Account")" style="text-decoration: none; color: #007bff; font-weight: bold; margin-right: 10px;">
                            ورود یا نام کاربری
                        </a>
                        <hr class="mt-0" style="flex-grow: 1; margin: 0 10px; border: 1px solid #ddd;">
                        <a href="@Url.Action("LoginWhitPhone","Account")" style="text-decoration: none; color: #007bff; font-weight: bold; margin-left: 10px;">
                            ورود با موبایل
                        </a>
                    </div>
                </div>
                <!-- /Login -->
                <img alt="mask" src="~/assets/img/illustrations/auth-basic-login-mask-light.png"
                     class="authentication-image d-none d-lg-block"
                     data-app-light-img="illustrations/auth-basic-login-mask-light.png"
                     data-app-dark-img="illustrations/auth-basic-login-mask-dark.png" />
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/assets/vendor/libs/popper/popper.js"></script>
    <script src="~/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="~/assets/vendor/libs/node-waves/node-waves.js"></script>
    <script src="~/assets/vendor/js/bootstrap.js"></script>
    <script src="~/assets/vendor/js/helpers.js"></script>
    <script src="~/assets/vendor/js/template-customizer.js"></script>
    <script src="~/assets/js/config.js"></script>

    <script src="~/assets/vendor/libs/hammer/hammer.js"></script>
    <script src="~/assets/vendor/libs/i18n/i18n.js"></script>
    <script src="~/assets/vendor/libs/typeahead-js/typeahead.js"></script>
    <script src="~/assets/vendor/libs/formvalidation/dist/js/FormValidation.min.js"></script>
    <script src="~/assets/vendor/libs/formvalidation/dist/js/plugins/Bootstrap5.min.js"></script>
    <script src="~/assets/vendor/libs/formvalidation/dist/js/plugins/AutoFocus.min.js"></script>
    <script src="~/assets/js/main.js"></script>
    <script src="@Url.Content("~/libs/@fortawesome/fontawesome-free/js/all.min.js")"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <!-- Disable Service Worker for login pages -->
    <script>
        // Disable service worker registration on login pages
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.getRegistrations().then(function(registrations) {
                for(let registration of registrations) {
                    registration.unregister();
                }
            });
        }
        
        // OTP Resend Timer and Functionality
        $(document).ready(function() {
            let countdown = 120; // 2 minutes in seconds
            const phoneNumber = '@Model.Phone';
            
            // Start countdown timer
            const timer = setInterval(function() {
                countdown--;
                $('#countdown').text(countdown);
                
                if (countdown <= 0) {
                    clearInterval(timer);
                    $('#timer-section').hide();
                    $('#resend-section').show();
                }
            }, 1000);
            
            // Handle resend button click
            $('#resend-btn').on('click', function() {
                const $btn = $(this);
                const $timerSection = $('#timer-section');
                const $resendSection = $('#resend-section');
                
                // Disable button and show loading
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i>در حال ارسال...');
                
                // Send AJAX request to resend OTP
                $.ajax({
                    url: '@Url.Action("ResendOtp", "Account")',
                    type: 'POST',
                    data: {
                        phoneNumber: phoneNumber,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            // Show success message
                            Swal.fire({
                                icon: 'success',
                                title: 'موفقیت',
                                text: response.message,
                                timer: 2000,
                                showConfirmButton: false
                            });
                            
                            // Reset timer and hide resend button
                            countdown = 120;
                            $timerSection.show();
                            $resendSection.hide();
                            
                            // Restart countdown
                            const newTimer = setInterval(function() {
                                countdown--;
                                $('#countdown').text(countdown);
                                
                                if (countdown <= 0) {
                                    clearInterval(newTimer);
                                    $timerSection.hide();
                                    $resendSection.show();
                                }
                            }, 1000);
                        } else {
                            // Show error message
                            Swal.fire({
                                icon: 'error',
                                title: 'خطا',
                                text: response.message
                            });
                        }
                    },
                    error: function() {
                        // Show error message
                        Swal.fire({
                            icon: 'error',
                            title: 'خطا',
                            text: 'خطا در ارتباط با سرور'
                        });
                    },
                    complete: function() {
                        // Re-enable button
                        $btn.prop('disabled', false).html('<i class="fas fa-redo me-1"></i>ارسال مجدد کد تایید');
                    }
                });
            });
        });
    </script>
</body>
</html>
