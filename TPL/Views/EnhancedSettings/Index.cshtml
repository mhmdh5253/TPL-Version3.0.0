@{
    ViewData["Title"] = "تنظیمات پیشرفته";
    Layout = "_LayoutAdmin";
}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-title-box d-flex align-items-center justify-content-between">
                <h4 class="mb-0">
                    <i class="fas fa-cogs me-2"></i>تنظیمات سامانه پیامکی
                </h4>
            </div>
        </div>
    </div>
    <br>
    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <ul class="nav nav-tabs card-header-tabs" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" data-bs-toggle="tab" href="#sms-settings" role="tab">
                                <i class="fas fa-sms me-2"></i>تنظیمات پیامک
                            </a>
                        </li>
                        <div class="ms-auto">
                            <button class="btn btn-success btn-sm" onclick="checkAllServices()">
                                <i class="fas fa-check-circle me-2"></i>بررسی وضعیت همه سرویس‌ها
                            </button>
                        </div>
                    </ul>
                </div>
                <div class="card-body">
                    <div class="tab-content">
                        <!-- SMS Settings Tab -->
                        <div class="tab-pane fade show active" id="sms-settings" role="tabpanel">
                            <div class="row">
                                <!-- Provider Selection Card -->
                                <div class="col-md-4">
                                    <div class="card border-primary">
                                        <div class="card-header bg-primary text-white">
                                            <h6 class="mb-0"><i class="fas fa-server me-2"></i>انتخاب سامانه پیامکی</h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="mb-3">
                                                <label for="sms-provider" class="form-label fw-bold">سامانه پیامکی</label>
                                                <select class="form-select form-select-lg" id="sms-provider" name="Provider" onchange="changeProvider()">
                                                    <option value="ParsGreen" selected>🌐 ParsGreen</option>
                                                </select>
                                                <div class="form-text">ParsGreen (فعال)</div>
                                                <input type="hidden" id="sms-provider-hidden" name="Provider" value="ParsGreen" />
                                            </div>

                                            <!-- Provider Info -->
                                            <div id="provider-info" class="mt-3">
                                                <div class="alert alert-info">
                                                    <h6><i class="fas fa-info-circle me-2"></i>اطلاعات سامانه</h6>
                                                    <div id="provider-details">
                                                        <p class="mb-1"><strong>نوع احراز هویت:</strong> API Key</p>
                                                        <p class="mb-1"><strong>فرمت پیام:</strong> JSON</p>
                                                        <p class="mb-0"><strong>پشتیبانی از:</strong> OTP, پیامک تکی و گروهی</p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Dynamic Settings Form -->
                                <div class="col-md-8">
                                    <div class="card border-success">
                                        <div class="card-header bg-success text-white">
                                            <h6 class="mb-0"><i class="fas fa-cog me-2"></i>تنظیمات سامانه</h6>
                                        </div>
                                        <div class="card-body">
                                            <form asp-action="UpdateSmsSettings" method="post" asp-antiforgery="true" id="sms-settings-form">
                                                <!-- ParsGreen Settings -->
                                                <div id="parsgreen-settings" class="provider-settings">
                                                    <div class="row">
                                                        <div class="col-md-12">
                                                            <div class="mb-3">
                                                                <label for="sms-bearer-token" class="form-label fw-bold">API Key</label>
                                                                <input type="text" class="form-control" id="sms-bearer-token" name="BearerToken"
                                                                       value="@ViewBag.SmsBearerToken" placeholder="کلید API ParsGreen">
                                                                <div class="form-text">کلید API که از پنل ParsGreen دریافت می‌کنید</div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>



                                                <!-- Common Settings -->
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <div class="mb-3">
                                                            <label for="sms-sender" class="form-label fw-bold">شماره فرستنده</label>
                                                            <input type="text" class="form-control" id="sms-sender" name="Sender"
                                                                   value="@ViewBag.SmsSender" placeholder="شماره فرستنده">
                                                            <div class="form-text">شماره تلفن فرستنده پیامک</div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <div class="mb-3">
                                                            <label for="sms-otp-pattern" class="form-label fw-bold">کد قالب OTP</label>
                                                            <input type="text" class="form-control" id="sms-otp-pattern" name="OtpPattern"
                                                                   value="@ViewBag.SmsOtpPattern" placeholder="کد قالب OTP">
                                                            <div class="form-text">کد قالب یا پترن برای ارسال OTP</div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="form-check form-switch mb-3">
                                                    <input class="form-check-input" type="checkbox" id="sms-is-active" @(ViewBag.SmsIsActive == true ? "checked" : "")>
                                                    <label class="form-check-label fw-bold" for="sms-is-active">فعال‌سازی سامانه پیامکی</label>
                                                    <input type="hidden" id="sms-is-active-hidden" name="IsActive" value="@(ViewBag.SmsIsActive == true ? "true" : "false")" />
                                                </div>

                                                <div class="text-center">
                                                    <button type="submit" class="btn btn-primary btn-lg px-5">
                                                        <i class="fas fa-save me-2"></i>ذخیره تنظیمات
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Status and Test Cards -->
                            <div class="row mt-4">
                                <!-- Service Status Card -->
                                <div class="col-md-6">
                                    <div class="card border-info">
                                        <div class="card-header bg-info text-white">
                                            <h6 class="mb-0"><i class="fas fa-chart-line me-2"></i>وضعیت سرویس</h6>
                                        </div>
                                        <div class="card-body">
                                            <div id="provider-status">
                                                <div class="text-center">
                                                    <div class="spinner-border text-info" role="status">
                                                        <span class="visually-hidden">در حال بارگذاری...</span>
                                                    </div>
                                                    <p class="mt-2 text-muted">در حال بررسی وضعیت...</p>
                                                </div>
                                            </div>

                                            <!-- Provider Status Table -->
                                            <div id="providers-table" style="display: none;">
                                                <div class="table-responsive">
                                                    <table class="table table-sm table-hover">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th>سامانه</th>
                                                                <th>وضعیت</th>
                                                                <th>اولویت</th>
                                                                <th>عملیات</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody id="providers-tbody">
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Test SMS Card -->
                                <div class="col-md-6">
                                    <div class="card border-warning">
                                        <div class="card-header bg-warning text-white">
                                            <h6 class="mb-0"><i class="fas fa-paper-plane me-2"></i>تست ارسال کد تایید</h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="alert alert-info mb-3">
                                                <i class="fas fa-info-circle me-2"></i>
                                                <strong>سامانه فعال:</strong> <span id="active-provider-display">ParsGreen</span>
                                                <br>
                                                <small>کد تایید تست از طریق سامانه فعال ارسال خواهد شد</small>
                                            </div>
                                            <div class="mb-3">
                                                <label for="test-phone" class="form-label fw-bold">شماره تلفن</label>
                                                <div class="input-group">
                                                    <span class="input-group-text"><i class="fas fa-phone"></i></span>
                                                    <input type="tel" class="form-control" id="test-phone" placeholder="09xxxxxxxxx">
                                                </div>
                                            </div>
                                            <div class="d-grid">
                                                <button type="button" class="btn btn-warning btn-lg" id="test-sms-btn">
                                                    <i class="fas fa-paper-plane me-2"></i>ارسال کد تایید تست
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section pagejs {
    <script>
        $(document).ready(function () {
            // Set default SMS provider
            const defaultProvider = '@(ViewBag.SmsProvider ?? "ParsGreen")' || 'ParsGreen';
            $('#sms-provider').val(defaultProvider);
            $('#sms-provider-hidden').val(defaultProvider);
            changeProvider();

            // Load provider status on page load
            loadProviderStatus();

            // Set initial active provider display
            updateActiveProviderDisplay(defaultProvider);

            // Test SMS functionality
            $('#test-sms-btn').on('click', function() {
                const phoneNumber = $('#test-phone').val().trim();

                if (!phoneNumber) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'هشدار',
                        text: 'لطفاً شماره تلفن را وارد کنید'
                    });
                    return;
                }

                testSmsProvider(phoneNumber);
            });

            // Form validation for SMS settings
            $('#sms-settings-form').on('submit', function(e) {
                const provider = $('#sms-provider').val();
                const bearerToken = $('#sms-bearer-token').val().trim();
                const sender = $('#sms-sender').val().trim();

                if (provider === 'ParsGreen') {
                    if (!bearerToken) {
                        e.preventDefault();
                        Swal.fire({
                            icon: 'warning',
                            title: 'هشدار',
                            text: 'لطفاً API Key را وارد کنید'
                        });
                        return false;
                    }
                }

                if (!sender) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'warning',
                        title: 'هشدار',
                        text: 'لطفاً شماره فرستنده را وارد کنید'
                    });
                    return false;
                }

                // sync hidden fields for post
                $('#sms-provider-hidden').val(provider);
                $('#sms-is-active-hidden').val($('#sms-is-active').is(':checked'));
            });
        });

        function changeProvider() {
            const provider = $('#sms-provider').val();

            $('.provider-settings').hide();

            $('#parsgreen-settings').show();
            updateProviderInfo('ParsGreen', 'API Key', 'JSON', 'OTP، پیامک تکی و گروهی');

            // Update active provider display
            updateActiveProviderDisplay(provider);
            $('#sms-provider-hidden').val(provider);

            // Update provider status after change
            loadProviderStatus();
        }

        function updateActiveProviderDisplay(provider) {
            $('#active-provider-display').text('🌐 ParsGreen');
        }



        function updateProviderInfo(name, auth, format, support) {
            $('#provider-details').html(`
                <p class="mb-1"><strong>نوع احراز هویت:</strong> ${auth}</p>
                <p class="mb-1"><strong>فرمت پیام:</strong> ${format}</p>
                <p class="mb-0"><strong>پشتیبانی از:</strong> ${support}</p>
            `);
        }

        function loadProviderStatus() {
            $.get('@Url.Action("GetSmsProviderStatus", "EnhancedSettings")')
                .done(function(response) {
                    if (response.success) {
                        displayProviderStatus(response.data);
                    } else {
                        $('#provider-status').html('<div class="text-danger">خطا در دریافت وضعیت</div>');
                    }
                })
                .fail(function() {
                    $('#provider-status').html('<div class="text-danger">خطا در اتصال به سرور</div>');
                });
        }

        function displayProviderStatus(providers) {
            // Hide loading spinner
            $('#provider-status .text-center').hide();

            // Show providers table
            $('#providers-table').show();

            let tableHtml = '';
            providers.forEach(function(provider) {
                const statusClass = provider.IsActive ? 'success' : 'secondary';
                const statusIcon = provider.IsActive ? 'check-circle' : 'times-circle';
                const priorityClass = provider.Priority === 'اول' ? 'primary' : 'secondary';

                tableHtml += `
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <span class="status-indicator status-${statusClass} me-2"></span>
                                <strong>${provider.DisplayName}</strong>
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-${statusClass}">
                                <i class="fas fa-${statusIcon} me-1"></i>${provider.Status}
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-${priorityClass}">${provider.Priority}</span>
                        </td>
                        <td>
                            <span class="badge bg-success">
                                <i class="fas fa-check me-1"></i>فعال
                            </span>
                        </td>
                    </tr>
                `;
            });

            $('#providers-tbody').html(tableHtml);
        }

        function testSmsProvider(phoneNumber) {
            const provider = $('#sms-provider').val();

            Swal.fire({
                title: 'در حال ارسال کد تایید تست...',
                text: `ارسال کد تایید تست به شماره ${phoneNumber} از طریق ${provider}`,
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            $.post('@Url.Action("TestSmsProvider", "EnhancedSettings")', {
                phoneNumber: phoneNumber,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            })
                .done(function(response) {
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'موفقیت',
                            text: response.message
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'خطا',
                            text: response.message
                        });
                    }
                })
                .fail(function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'خطا',
                        text: 'خطا در اتصال به سرور'
                    });
                });
        }

        function checkAllServices() {
            Swal.fire({
                title: 'بررسی وضعیت سرویس‌ها',
                text: 'در حال بررسی وضعیت همه سرویس‌های پیامکی...',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            loadProviderStatus();

            setTimeout(() => {
                Swal.fire({
                    icon: 'success',
                    title: 'تکمیل شد',
                    text: 'وضعیت همه سرویس‌ها بررسی شد'
                });
            }, 2000);
        }
    </script>
}

<style>
    .status-indicator {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        display: inline-block;
        box-shadow: 0 0 4px rgba(0,0,0,0.2);
    }

    .status-success {
        background-color: #28a745;
    }

    .status-danger {
        background-color: #dc3545;
    }

    .status-warning {
        background-color: #ffc107;
    }

    .status-info {
        background-color: #17a2b8;
    }

    .status-secondary {
        background-color: #6c757d;
    }

    .card {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        border: none;
        margin-bottom: 1rem;
    }

    .card-header {
        border-bottom: none;
        font-weight: 600;
    }

    .form-control, .form-select {
        border-radius: 0.5rem;
        border: 1px solid #dee2e6;
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }

        .form-control:focus, .form-select:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }

    .btn {
        border-radius: 0.5rem;
        font-weight: 500;
        transition: all 0.15s ease-in-out;
    }

        .btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }

    .nav-tabs .nav-link {
        border: none;
        border-radius: 0.5rem 0.5rem 0 0;
        color: #6c757d;
        font-weight: 500;
    }

        .nav-tabs .nav-link.active {
            background-color: #fff;
            color: #495057;
            border-bottom: 3px solid #0d6efd;
        }

    .alert {
        border-radius: 0.5rem;
        border: none;
    }

    .spinner-border {
        width: 2rem;
        height: 2rem;
    }
</style>
