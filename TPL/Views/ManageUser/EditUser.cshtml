@using Microsoft.AspNetCore.Mvc.TagHelpers
@using TPLWeb.Models.ManageUser
@model TPLWeb.Models.ManageUser.EditViewModel

@{
    ViewData["Title"] = "ویرایش کاربر";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    
    // تابع کمکی برای تبدیل نوع سازمان به متن فارسی
    string GetOrganizationTypeText(string? orgType)
    {
        return orgType switch
        {
            "main" => "سازمان اصلی",
            "department" => "اداره",
            "unit" => "واحد",
            "section" => "بخش",
            _ => orgType ?? "نامشخص"
        };
    }
    

}

@section pagecss {
    <style>
        .form-group {
            margin-bottom: 1rem;
        }

        .password-toggle {
            cursor: pointer;
            position: absolute;
            top: 50%;
            left: 10px;
            transform: translateY(-50%);
            z-index: 5;
        }

        .password-input-container {
            position: relative;
        }

        /* Signature preview styles */
        .signature-container {
            display: none;
            margin-top: 15px;
            border: 1px dashed #ddd;
            padding: 10px;
            border-radius: 5px;
            text-align: center;
        }

        .signature-preview {
            max-width: 100%;
            max-height: 150px;
            display: block;
            margin: 0 auto;
        }

        .signature-placeholder {
            color: #999;
            font-style: italic;
        }

        /* Improved card styling */
        .card {
            border-radius: 10px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        }

        .card-header {
            border-radius: 10px 10px 0 0 !important;
            font-weight: 600;
            padding: 1.25rem 1.5rem;
        }

        .form-floating-outline .form-control {
            border-radius: 8px;
            padding: 12px 15px;
        }

        .form-floating-outline label {
            padding: 0.5rem 0.75rem;
        }

        /* Role checkboxes styling */
        .role-checkbox-container {
            background: #f8f9fa;
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 10px;
        }

        .form-check-input:checked {
            background-color: #7367f0;
            border-color: #7367f0;
        }
    </style>
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <h5 class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <div>
                    <i class="fas fa-user-edit me-2"></i>ویرایش کاربر
                </div>
                <div>
                    <a href="/UserOrganization" class="btn btn-light btn-sm">
                        <i class="fas fa-building me-2"></i>مدیریت سازمان کاربران
                    </a>
                </div>
            </h5>
            <div class="card-body">
                <form asp-controller="ManageUser" asp-action="EditUser" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <!-- تصویر پروفایل و امضا (نصف-نصف و هم‌راستا) -->
                        <div class="col-12 mb-3">
                            <div class="row g-3 align-items-center">
                                <div class="col-md-6">
                                    <label class="form-label d-block">تصویر پروفایل</label>
                                    @{
                                        var currentAvatar = "/CompanyVariables/avatars/1.png";
                                        if (!string.IsNullOrWhiteSpace(Model.Avatar))
                                        {
                                            currentAvatar = Model.Avatar.StartsWith("/") || Model.Avatar.StartsWith("http")
                                                ? Model.Avatar
                                                : $"/CompanyVariables/avatars/{Model.Avatar}";
                                        }
                                    }
                                    <input type="file" class="d-none" id="adminAvatarInput" accept="image/*" asp-for="AvatarPic" />
                                    <label for="adminAvatarInput" class="d-inline-block" title="برای تغییر عکس کلیک کنید" style="cursor:pointer;">
                                        <img id="adminAvatarImg" src="@currentAvatar" class="rounded-circle border" style="width:120px;height:120px;object-fit:cover;" alt="avatar" />
                                        <div class="text-center small mt-1">تصویر پروفایل</div>
                                    </label>
                                    <small class="text-muted d-block">فرمت‌های مجاز: jpg, png. حداکثر 2MB</small>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label d-block">تصویر امضا</label>
                                    @{ var signaturePathTop = string.IsNullOrWhiteSpace(Model.Emza) ? Url.Content("~/CompanyVariables/signatures/default-signature.png") : Url.Content($"~/CompanyVariables/signatures/{Model.Emza}"); }
                                    <input type="file" class="d-none" id="adminSignatureInput" accept="image/*" asp-for="EmzaPic" />
                                    <label for="adminSignatureInput" class="d-inline-block" title="برای تغییر امضا کلیک کنید" style="cursor:pointer;">
                                        <img id="adminSignatureImg" src="@signaturePathTop" class="img-thumbnail bg-white" style="width:120px;height:120px;object-fit:contain;" alt="signature" />
                                        <div class="text-center small mt-1">تصویر امضا</div>
                                    </label>
                                    <small class="text-muted d-block">راهنما: فرمت‌های مجاز jpg، png. حداکثر 2MB. تصویر واضح از امضا بارگذاری شود.</small>
                                </div>
                            </div>
                        </div>

                        <!-- اطلاعات شخصی -->
                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline mb-3">
                                <input type="text" maxlength="30" asp-for="FirstName" class="form-control" placeholder="نام" />
                                <label asp-for="FirstName">نام</label>
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline mb-3">
                                <input type="text" maxlength="30" asp-for="LastName" class="form-control" placeholder="نام خانوادگی" />
                                <label asp-for="LastName">نام خانوادگی</label>
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline mb-3">
                                <select asp-for="Ostan" class="form-select">
                                    <option value="" disabled selected>لطفا انتخاب کنید</option>
                                    <option value="آذربایجان شرقی">آذربایجان شرقی</option>
                                    <option value="آذربایجان غربی">آذربایجان غربی</option>
                                    <option value="اردبیل">اردبیل</option>
                                    <option value="اصفهان">اصفهان</option>
                                    <option value="البرز">البرز</option>
                                    <option value="ایلام">ایلام</option>
                                    <option value="بوشهر">بوشهر</option>
                                    <option value="تهران">تهران</option>
                                    <option value="چهارمحال و بختیاری">چهارمحال و بختیاری</option>
                                    <option value="خراسان جنوبی">خراسان جنوبی</option>
                                    <option value="خراسان رضوی">خراسان رضوی</option>
                                    <option value="خراسان شمالی">خراسان شمالی</option>
                                    <option value="خوزستان">خوزستان</option>
                                    <option value="زنجان">زنجان</option>
                                    <option value="سمنان">سمنان</option>
                                    <option value="سیستان و بلوچستان">سیستان و بلوچستان</option>
                                    <option value="فارس">فارس</option>
                                    <option value="قزوین">قزوین</option>
                                    <option value="قم">قم</option>
                                    <option value="کردستان">کردستان</option>
                                    <option value="کرمان">کرمان</option>
                                    <option value="کرمانشاه">کرمانشاه</option>
                                    <option value="کهگیلویه و بویراحمد">کهگیلویه و بویراحمد</option>
                                    <option value="گلستان">گلستان</option>
                                    <option value="گیلان">گیلان</option>
                                    <option value="لرستان">لرستان</option>
                                    <option value="مازندران">مازندران</option>
                                    <option value="مرکزی">مرکزی</option>
                                    <option value="هرمزگان">هرمزگان</option>
                                    <option value="همدان">همدان</option>
                                    <option value="یزد">یزد</option>
                                </select>
                                <label asp-for="Ostan">استان</label>
                            </div>
                        </div>

                        <!-- اطلاعات حساب کاربری -->
                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline mb-3">
                                <input type="text" maxlength="30" asp-for="UserName" class="form-control" placeholder="نام کاربری" />
                                <label asp-for="UserName">نام کاربری</label>
                                <span asp-validation-for="UserName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline mb-3">
                                <input type="email" maxlength="60" asp-for="Email" class="form-control" placeholder="ایمیل" />
                                <label asp-for="Email">ایمیل</label>
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline mb-3">
                                <input type="text" maxlength="30" asp-for="Phone" class="form-control" placeholder="موبایل" />
                                <label asp-for="Phone">موبایل</label>
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline mb-3 password-input-container">
                                <input type="password" maxlength="30" asp-for="Password" class="form-control" placeholder="رمز عبور" id="passwordField" />
                                <label asp-for="Password">رمز عبور جدید</label>
                                <i class="fas fa-eye password-toggle" id="togglePassword" style="top: 25px;"></i>
                                <span asp-validation-for="Password" class="text-danger"></span>
                                <small class="text-muted">در صورت عدم نیاز به تغییر رمز، این فیلد را خالی بگذارید</small>
                            </div>
                        </div>

                        <!-- نوع حساب و آدرس -->
                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline mb-3">
                                <select class="form-select" asp-for="AccountType">
                                    <option value="">لطفا انتخاب نمایید</option>
                                    <option value="شخصی">شخصی</option>
                                    <option value="سازمانی">سازمانی</option>
                                </select>
                                <label asp-for="AccountType">نوع حساب</label>
                                <span asp-validation-for="AccountType" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline mb-3">
                                <input type="text" class="form-control" placeholder="آدرس" asp-for="Address" />
                                <label asp-for="Address">آدرس</label>
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- اطلاعات سازمانی (فقط نمایش) -->
                        <div class="col-12 mb-3">
                            <div class="alert alert-info">
                                <i class="fas fa-building me-2"></i>
                                <strong>اطلاعات سازمانی:</strong> این فیلدها از طریق مدیریت سازمان قابل ویرایش هستند. برای تغییر این اطلاعات، از بخش <a href="/UserOrganization" class="alert-link">مدیریت سازمان کاربران</a> استفاده کنید.
                            </div>
                        </div>
                        
                       
                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline mb-3">
                                <input type="text" class="form-control"  placeholder="نوع سازمان" readonly value="@(Model.Organization?.OrgType != null ? GetOrganizationTypeText(Model.Organization.OrgType) : "تعیین نشده")" />
                                <label >نوع سازمان</label>
                                <small class="text-muted">این فیلد از طریق مدیریت سازمان قابل ویرایش است</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline mb-3">
                                <input type="text" class="form-control" asp-for="NameEdareh" placeholder="اداره فناوری" readonly />
                                <label asp-for="NameEdareh">نام اداره</label>
                                <small class="text-muted">این فیلد از طریق مدیریت سازمان قابل ویرایش است</small>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-floating form-floating-outline mb-3">
                                <input type="text" class="form-control" asp-for="Semat" placeholder="مدیرعامل" readonly />
                                <label asp-for="Semat">سمت</label>
                                <small class="text-muted">این فیلد از طریق مدیریت سازمان قابل ویرایش است</small>
                            </div>
                        </div>

                        <!-- حق امضا -->
                        <div class="col-md-4">
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" asp-for="HaqEmza" id="flexSwitchCheckDefault">
                                <label class="form-check-label" asp-for="HaqEmza">حق امضا نامه</label>
                            </div>
                        </div>
                    </div>

                    <!-- ارسال اعلان به کاربر -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0"><i class="fas fa-bell me-2"></i>ارسال اعلان به این کاربر</h6>
                                </div>
                                <div class="card-body">
                                    <div class="row g-2 align-items-end">
                                        <div class="col-md-8">
                                            <div class="form-floating form-floating-outline">
                                                <input type="text" id="notifyMessage" class="form-control" placeholder="متن اعلان را بنویسید" />
                                                <label for="notifyMessage">متن اعلان</label>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-floating form-floating-outline">
                                                <input type="text" id="notifyLink" class="form-control" placeholder="پیوند (اختیاری)" />
                                                <label for="notifyLink">پیوند (اختیاری)</label>
                                            </div>
                                        </div>
                                        <div class="col-md-1 text-start">
                                            <button type="button" id="sendUserNotification" class="btn btn-outline-primary w-100" style="height: 49px !important;">ارسال</button>
                                        </div>
                                    </div>
                                    <small class="text-muted d-block mt-2">پس از ارسال، اعلان در زنگوله‌ی بالای صفحه برای کاربر نمایش داده می‌شود.</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- نقش‌های کاربر -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0"><i class="fas fa-user-tag me-2"></i>نقش‌های کاربر</h6>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        @{
                                            var Roles = ViewBag.Roles as List<RolesViewModel>;
                                            var UserRoles = ViewBag.UserRoles as List<string>;
                                        }
                                        @foreach (var role in Roles!)
                                        {
                                            <div class="col-md-3 col-sm-6 mb-2">
                                                <div class="role-checkbox-container">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox"
                                                               id="role_@role.roleName"
                                                               name="SelectedRoles"
                                                               value="@role.roleName"
                                                               @(UserRoles!.Contains(role.roleName!) ? "checked" : "") />
                                                        <label class="form-check-label" for="role_@role.roleName">
                                                            @role.roleName
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <input type="hidden" asp-for="Id" />

                    <!-- دکمه‌های اقدام -->
                    <div class="row mt-4">
                        <div class="col-md-6 text-end">
                            <a class="btn btn-outline-secondary" asp-action="Index" asp-controller="ManageUser">
                                <i class="fas fa-list me-2"></i>لیست کاربران
                            </a>
                        </div>
                        <div class="col-md-6 text-start">
                            <button type="submit" class="btn btn-primary" name="Edit">
                                <i class="fas fa-save me-2"></i>ذخیره تغییرات
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section PageJs {
    <script>
        $(document).ready(function() {
            // نمایش/مخفی کردن رمز عبور
            $('#togglePassword').click(function() {
                const passwordField = $('#passwordField');
                const icon = $(this).find('i');

                if (passwordField.attr('type') === 'password') {
                    passwordField.attr('type', 'text');
                    icon.removeClass('fa-eye').addClass('fa-eye-slash');
                } else {
                    passwordField.attr('type', 'password');
                    icon.removeClass('fa-eye-slash').addClass('fa-eye');
                }
            });
        });

        // Live preview avatar/signature on file select
        (function(){
            function bindAvatarPreview(){
                var avatarInput = document.getElementById('adminAvatarInput') || document.querySelector('input[name="AvatarPic"]');
                var avatarImg = document.getElementById('adminAvatarImg') || document.querySelector('label[for="adminAvatarInput"] img');
                if (avatarInput && avatarImg) {
                    avatarInput.addEventListener('change', function(){
                        if (this.files && this.files[0]) {
                            var url = URL.createObjectURL(this.files[0]);
                            // Force refresh by toggling src
                            avatarImg.src = '';
                            avatarImg.src = url;
                        }
                    });
                }
            }
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', bindAvatarPreview);
            } else {
                bindAvatarPreview();
            }
            const signInput = document.getElementById('adminSignatureInput');
            const signImg = document.getElementById('adminSignatureImg');
            if (signInput && signImg) {
                signInput.addEventListener('change', function(){
                    if (this.files && this.files[0]) {
                        const url = URL.createObjectURL(this.files[0]);
                        signImg.src = url;
                    }
                });
            }
        })();

        // Send notification to this user
        var sendBtn = document.getElementById('sendUserNotification');
        if (sendBtn) {
            sendBtn.addEventListener('click', function () {
                var msgEl = document.getElementById('notifyMessage');
                var linkEl = document.getElementById('notifyLink');
                var idEl = document.querySelector('input[name="Id"]');
                var msg = msgEl && msgEl.value ? msgEl.value.trim() : '';
                var link = linkEl && linkEl.value ? linkEl.value.trim() : '';
                var userId = idEl && idEl.value ? idEl.value : '';
                if (!msg || !userId) return;
                var formData = new FormData();
                formData.append('userId', userId);
                formData.append('message', msg);
                if (link) formData.append('link', link);
                fetch('/Notifications/Send', { method: 'POST', body: formData })
                    .then(function (r) { return r.json(); })
                    .then(function (res) {
                        if (res.success) {
                            if (msgEl) msgEl.value = '';
                            if (linkEl) linkEl.value = '';
                            alert('اعلان ارسال شد');
                        } else {
                            alert('ارسال اعلان ناموفق بود');
                        }
                    })
                    .catch(function () { alert('خطا در ارسال'); });
            });
        }
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}