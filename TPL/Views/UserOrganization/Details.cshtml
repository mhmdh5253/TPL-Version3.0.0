@using Microsoft.AspNetCore.Mvc.TagHelpers
@model BE.LetterAutomation.UserOrganization

<div class="card border-0 shadow-lg">
    <div class="card-header bg-gradient-info text-white">
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <div class="header-icon me-3">
                    <i class="fas fa-user-tie fa-2x"></i>
                </div>
                <div>
                    <h3 class="card-title mb-1">جزئیات رابطه کاربر با سازمان</h3>
                    <p class="mb-0 opacity-75">
                        @if (Model.User != null)
                        {
                            <i class="fas fa-user me-1"></i>@Model.User.FirstName @Model.User.LastName
                        }
                        else
                        {
                            <i class="fas fa-user me-1"></i>
                            @("کاربر نامشخص")
                        }
                    </p>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-light btn-lg px-4">
                    <i class="fas fa-edit me-2"></i>ویرایش
                </a>
                <a asp-action="Index" class="btn btn-outline-light btn-lg px-4">
                    <i class="fas fa-arrow-left me-2"></i>بازگشت
                </a>
                    </div>
    </div>
</div>

<style>
    .bg-gradient-info {
        background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);
    }
    
    .header-icon {
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(10px);
    }
    
    .card {
        border-radius: 16px;
        border: none;
        overflow: hidden;
    }
    
    .card-header {
        border-bottom: none;
        padding: 2rem;
    }
    
    .card-body {
        padding: 2rem;
    }
    
    .btn {
        border-radius: 12px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        transition: all 0.3s ease;
        border: none;
    }
    
    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }
    
    .btn-light {
        background: rgba(255, 255, 255, 0.9);
        color: #17a2b8;
        border: 2px solid rgba(255, 255, 255, 0.3);
    }
    
    .btn-light:hover {
        background: white;
        color: #138496;
        border-color: white;
    }
    
    .btn-outline-light {
        border: 2px solid rgba(255, 255, 255, 0.7);
        color: white;
    }
    
    .btn-outline-light:hover {
        background: white;
        color: #17a2b8;
        border-color: white;
    }
    
    .badge {
        font-size: 0.875rem;
        padding: 0.5rem 0.75rem;
        border-radius: 20px;
    }
    
    .badge-success {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
    }
    
    .badge-danger {
        background: linear-gradient(135deg, #dc3545 0%, #fd7e14 100%);
    }
    
    .badge-primary {
        background: linear-gradient(135deg, #007bff 0%, #6610f2 100%);
    }
    
    .badge-info {
        background: linear-gradient(135deg, #17a2b8 0%, #20c997 100%);
    }
    
    .badge-secondary {
        background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
    }
    
    .badge-light {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        color: #495057;
    }
    
    dl.row {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 1.5rem;
        margin: 0;
    }
    
    dt {
        font-weight: 600;
        color: #495057;
        padding: 0.5rem 0;
    }
    
    dd {
        padding: 0.5rem 0;
        margin-bottom: 0.5rem;
    }
    
    .text-danger {
        color: #dc3545 !important;
        font-weight: 500;
    }
    
    .text-muted {
        color: #6c757d !important;
    }
    
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .fade-in-up {
        animation: fadeInUp 0.6s ease;
    }
    
    .card {
        animation: fadeInUp 0.6s ease;
    }
    
    dl.row {
        animation: fadeInUp 0.6s ease;
        animation-delay: 0.2s;
    }
</style>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.User)</dt>
            <dd class="col-sm-9">
                @if (Model.User != null)
                {
                    <span>@Model.User.FirstName @Model.User.LastName</span>
                    <small class="text-muted">(@Model.User.UserName)</small>
                }
                else
                {
                    <span class="text-danger">کاربر حذف شده است</span>
                }
            </dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Organization)</dt>
            <dd class="col-sm-9">
                @if (Model.Organization != null)
                {
                    <span>@Model.Organization.Name</span>
                    @if (!string.IsNullOrEmpty(Model.Organization.Code))
                    {
                        <small class="text-muted">(کد: @Model.Organization.Code)</small>
                    }
                }
                else
                {
                    <span class="text-danger">سازمان حذف شده است</span>
                }
            </dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Position)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Position)</dd>

            <dt class="col-sm-3">وضعیت</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge badge-success">فعال</span>
                }
                else
                {
                    <span class="badge badge-danger">غیرفعال</span>
                }
            </dd>

            <dt class="col-sm-3">سمت سازمانی</dt>
            <dd class="col-sm-9">
                @if (Model.IsHead)
                {
                    <span class="badge badge-primary">مسئول بخش</span>
                }
                else if (Model.IsDeputy)
                {
                    <span class="badge badge-info">جانشین</span>
                }
                else
                {
                    <span class="badge badge-secondary">کارمند</span>
                }
            </dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.StartDate)</dt>
            <dd class="col-sm-9">@Model.StartDate</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.EndDate)</dt>
            <dd class="col-sm-9">
                @if (Model.EndDate.HasValue)
                {
                    @Model.EndDate.Value
                }
                else
                {
                    <span class="text-muted">-</span>
                }
            </dd>
        </dl>

        <div class="mt-4">
            <h5>اطلاعات اضافی</h5>
            <hr />
            @if (Model.User != null)
            {
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>ایمیل کاربر:</strong> @Model.User.Email</p>
                        <p><strong>تلفن کاربر:</strong> @Model.User.PhoneNumber</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>نوع حساب:</strong> @Model.User.AccountType</p>
                        <p>
                            <strong>حق امضا:</strong>
                            @if (Model.User.HaqEmza)
                            {
                                <span class="badge badge-success">دارد</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">ندارد</span>
                            }
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>