@using BE
@using BLL.Wallet
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject BlWallet Wallet

<!-- Navbar -->
<nav class="layout-navbar container-xxl navbar navbar-expand-xl navbar-detached align-items-center bg-navbar-theme"
     id="layout-navbar">
    <div class="layout-menu-toggle navbar-nav align-items-xl-center me-3 me-xl-0 d-xl-none">
        <a class="nav-item nav-link px-0 me-xl-4" href="javascript:void(0)">
            <i class="fas fa-bars fa-lg"></i>
        </a>
    </div>

    <div class="navbar-nav-right d-flex align-items-center" id="navbar-collapse">

                 <!-- Admin Message Slider -->
         <div class="admin-message-slider me-3" id="adminMessageSlider" data-fetch-url='@Url.Action("LastMonthTicker","Notifications")'>
             <div class="message-container">
                 <div class="message-content">
                     <i class="fas fa-bullhorn me-2 text-warning"></i>
                     <span class="message-title">اعلان‌ها:</span>
                     <span id="adminMessageText" class="message-text"></span>
                 </div>
             </div>
         </div>

        <ul class="navbar-nav flex-row align-items-center ms-auto">
            <!-- Notifications -->
            <li class="nav-item dropdown-notifications navbar-dropdown dropdown me-2 me-xl-1">
                <a class="nav-link btn btn-text-secondary rounded-pill btn-icon dropdown-toggle hide-arrow waves-effect waves-light notification-bell" href="javascript:void(0);" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" id="notifBell">
                    <i class="fas fa-bell"></i>
                    <span class="notification-dot bg-danger d-none" id="notifDot"></span>
                </a>
                                 <ul class="dropdown-menu dropdown-menu-end py-0" aria-labelledby="notifBell" style="min-width:360px; max-height:400px;">
                     <li class="dropdown-menu-header border-bottom">
                         <div class="dropdown-header d-flex align-items-center py-3">
                             <h6 class="mb-0 me-auto">اعلان ها</h6>
                             <span class="badge rounded-pill bg-label-primary"><span id="notifHeaderCount">0</span> جدید</span>
                         </div>
                     </li>
                     <li class="dropdown-notifications-list" style="max-height:250px; overflow-y:auto;">
                         <ul class="list-group list-group-flush" id="notifList">
                             <li class="list-group-item text-center text-muted py-3">اعلانی وجود ندارد</li>
                         </ul>
                     </li>
                     <li class="dropdown-menu-footer border-top p-2">
                         <a href="@Url.Action("Index","Notifications")" class="btn btn-primary d-flex justify-content-center waves-effect waves-light">مشاهده همه اعلان ها</a>
                     </li>
                 </ul>
            </li>
            <!-- User -->
            <li class="nav-item navbar-dropdown dropdown-user dropdown">
                <a class="nav-link dropdown-toggle hide-arrow" href="javascript:void(0);" data-bs-toggle="dropdown">
                    <div class="avatar avatar-online">
                        @{ var me = User.Identity!.IsAuthenticated ? UserManager.Users.SingleOrDefault(u => u.UserName == User.Identity!.Name) : null; }
                        @{
                            var avatarPath = Url.Content("~/CompanyVariables/avatars/1.png");
                            if (!string.IsNullOrWhiteSpace(me?.Avatar))
                            {
                                avatarPath = me.Avatar.StartsWith("/") || me.Avatar.StartsWith("http")
                                    ? me.Avatar
                                    : Url.Content($"~/CompanyVariables/avatars/{me.Avatar}");
                            }
                            else if (!string.IsNullOrWhiteSpace(me?.Emza))
                            {
                                avatarPath = me.Emza.StartsWith("/") || me.Emza.StartsWith("http")
                                    ? me.Emza
                                    : Url.Content($"~/CompanyVariables/signatures/{me.Emza}");
                            }
                        }
                        <img src="@avatarPath" alt="" class="w-px-40 h-auto rounded-circle" onerror="this.onerror=null;this.src='/CompanyVariables/avatars/1.png';" />
                    </div>
                </a>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item waves-effect" href="@Url.Action("ProfilePage","Account")">
                            <div class="d-flex">
                                <div class="flex-shrink-0 me-3">
                                    <div class="avatar avatar-online">
                                        @{
                                            var avatarPath2 = Url.Content("~/CompanyVariables/avatars/1.png");
                                            if (!string.IsNullOrWhiteSpace(me?.Avatar))
                                            {
                                                avatarPath2 = me.Avatar.StartsWith("/") || me.Avatar.StartsWith("http")
                                                    ? me.Avatar
                                                    : Url.Content($"~/CompanyVariables/avatars/{me.Avatar}");
                                            }
                                            else if (!string.IsNullOrWhiteSpace(me?.Emza))
                                            {
                                                avatarPath2 = me.Emza.StartsWith("/") || me.Emza.StartsWith("http")
                                                    ? me.Emza
                                                    : Url.Content($"~/CompanyVariables/signatures/{me.Emza}");
                                            }
                                        }
                                        <img src="@avatarPath2" alt="" class="w-px-40 h-auto rounded-circle" onerror="this.onerror=null;this.src='/CompanyVariables/avatars/1.png';" />
                                    </div>
                                </div>
                                <div class="flex-grow-1">
                                    @{
                                        if (User!.Identity!.IsAuthenticated)
                                        {
                                            var user = UserManager.Users.SingleOrDefault(u => u.UserName == User.Identity.Name);
                                            <span class="fw-semibold d-block">@user!.FirstName @user!.LastName</span>
                                            <small class="text-muted">@user!.UserName</small>
                                        }
                                        else
                                        {
                                            <span class="fw-semibold d-block">null</span>
                                            <small class="text-muted">null</small>
                                        }
                                    }

                                </div>
                            </div>
                        </a>
                    </li>

                    <li>
                        <div class="dropdown-divider"></div>
                    </li>
                    @if (User!.Identity!.IsAuthenticated)
                    {
                        
                            string id = UserManager.Users.SingleOrDefault(x => x.UserName == User.Identity.Name)!.Id;
                            var balance =await Wallet.GetBalanceAsync(id);
                            <li>
                                <a class="dropdown-item waves-effect" href="@Url.Action("Deposit", "Wallet")">
                                    <i class="fas fa-wallet me-2"></i>
                                    <span class="align-middle">موجودی :@Convert.ToInt32(balance).ToString("##,###") تومان </span>
                                </a>
                            </li>
                        
                       
                    }
                   
                    <li>
                        <div class="dropdown-divider"></div>
                    </li>
                    <li>
                        <div class="dropdown-divider"></div>
                    </li>

                @*     <li>
                        <a class="dropdown-item waves-effect" href="@Url.Action("Learn", "Home")">
                            <i class="fas fa-question-circle me-2"></i>
                            <span class="align-middle"> آموزش کار با سامانه</span>
                        </a>
                    </li>
                    <li>
                        <div class="dropdown-divider"></div>
                    </li> *@
                    <li>
                        <a class="dropdown-item waves-effect" href="@Url.Action("Logout", "Account")">
                            <i class="fas fa-sign-out-alt me-2"></i>
                            <span class="align-middle">خروج</span>
                        </a>
                    </li>
                </ul>
            </li>
            <!--/ User -->
        </ul>
    </div>
</nav>

<!-- / Navbar -->

<style>
    .admin-message-slider {
        max-width: 65rem;
        overflow: hidden;
        position: relative;
        display: block;
        flex: 0 0 auto;
    }

    .message-container {
        background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
        color: #fff;
        padding: 0.5rem 1rem;
        border-radius: 2rem;
        box-shadow: 0 2px 8px rgba(255, 107, 107, 0.3);
    }

    .message-content {
        display: flex;
        align-items: center;
        gap: .5rem;
        font-size: 0.875rem;
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
    }

    .message-text {
        display: block;
        flex: 1 1 auto;
        overflow: hidden;
        white-space: nowrap;
        position: relative;
        direction: initial;
    }

    .ticker-track {
        display: inline-block;
        padding-inline-start: 1rem;
        will-change: transform;
        animation: ticker-move-ltr var(--ticker-duration, 30s) linear infinite;
        direction: ltr;
    }

    .separator {
        display: inline-block;
        margin: 0 .75rem;
        color: rgba(255,255,255,0.9);
        font-weight: 700;
    }

    /* keep original element order and alignment */

         .message-content i {
         animation: pulse 2s infinite;
     }

     .message-title {
         font-weight: bold;
         margin-left: 0.5rem;
         margin-right: 0.5rem;
     }

    @@keyframes ticker-move-ltr {
        0% { transform: translateX(-50%); }
        100% { transform: translateX(0); }
    }

    @@keyframes pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.1); }
        100% { transform: scale(1); }
    }

    @@media (max-width: 1200px) {
        /* keep default 70rem cap */
    }

    @@media (max-width: 992px) {
        .admin-message-slider { display: none !important; }
    }

    /* Notification dot styles for responsive design */
    .notification-bell {
        position: relative;
        display: inline-block;
    }

    .notification-dot {
        position: absolute;
        top: 2px;
        right: 2px;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        border: 2px solid #fff;
        z-index: 10;
        animation: pulse-dot 2s infinite;
    }

    /* Responsive adjustments for notification dot */
    @@media (max-width: 576px) {
        .notification-dot {
            width: 6px;
            height: 6px;
            top: 1px;
            right: 1px;
        }
    }

    @@media (min-width: 577px) and (max-width: 768px) {
        .notification-dot {
            width: 7px;
            height: 7px;
            top: 1.5px;
            right: 1.5px;
        }
    }

    @@media (min-width: 769px) {
        .notification-dot {
            width: 8px;
            height: 8px;
            top: 2px;
            right: 2px;
        }
    }

    @@keyframes pulse-dot {
        0% {
            transform: scale(1);
            opacity: 1;
        }
        50% {
            transform: scale(1.2);
            opacity: 0.8;
        }
        100% {
            transform: scale(1);
            opacity: 1;
        }
    }
</style>

<script>
    // Persistent notifications ticker (admin/user) — last month
    document.addEventListener('DOMContentLoaded', function () {
        const slider = document.getElementById('adminMessageSlider');
        const messageTextHost = document.getElementById('adminMessageText');
        if (!slider || !messageTextHost) return;

        // Ensure visible and sized
        slider.style.display = 'block';

        const fallbackMessages = [
            'به سیستم خوش آمدید',
            'اعلان‌های یک ماه گذشته در اینجا نشان داده می‌شوند'
        ];

        const tryExtractText = (item) => {
            if (!item) return '';
            if (typeof item === 'string') return item;
            return item.message || item.text || item.title || '';
        };

        async function fetchLastMonthMessages() {
            const urls = [];
            const dataUrl = slider.getAttribute('data-fetch-url');
            if (dataUrl) urls.push(dataUrl);
            urls.push('/Notifications/LastMonthTicker');
            urls.push('/Notifications/LastMonth');

            for (const url of urls) {
                try {
                    const res = await fetch(url, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' });
                    if (!res.ok) continue;
                    const data = await res.json();
                    if (Array.isArray(data) && data.length) {
                        const msgs = data.map(tryExtractText).filter(Boolean);
                        if (msgs.length) return msgs;
                    }
                } catch (e) { /* ignore and try next */ }
            }
            return fallbackMessages;
        }

        function buildTicker(messages) {
            const makeNodes = (arr) => {
                const frag = document.createDocumentFragment();
                arr.forEach((msg, idx) => {
                    const span = document.createElement('span');
                    span.textContent = msg;
                    frag.appendChild(span);
                    if (idx !== arr.length - 1) {
                        const sep = document.createElement('span');
                        sep.className = 'separator';
                        sep.textContent = '|';
                        frag.appendChild(sep);
                    }
                });
                return frag;
            };

            messageTextHost.innerHTML = '';
            const track = document.createElement('span');
            track.className = 'ticker-track';

            // Build one loop
            track.appendChild(makeNodes(messages));
            // Separator between loops
            const sepBetween = document.createElement('span');
            sepBetween.className = 'separator';
            sepBetween.textContent = '|';
            track.appendChild(sepBetween);
            // Duplicate for seamless loop
            track.appendChild(makeNodes(messages));

            messageTextHost.appendChild(track);

            // Compute duration based on half width (one loop)
            requestAnimationFrame(() => {
                const halfWidth = track.scrollWidth / 2;
                const speed = 70; // px/s
                const durationSec = Math.max(20, Math.round(halfWidth / speed));
                track.style.setProperty('--ticker-duration', durationSec + 's');
            });
        }

        // Initial load
        fetchLastMonthMessages().then(buildTicker);

        // Optional: refresh periodically (e.g., every 5 minutes)
        setInterval(() => {
            fetchLastMonthMessages().then(buildTicker);
        }, 5 * 60 * 1000);

        // Manual trigger hook
        window.showAdminMessage = function (message) {
            buildTicker([message]);
        };
    });
</script>