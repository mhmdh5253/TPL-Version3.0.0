@using Microsoft.AspNetCore.Mvc.TagHelpers
@model List<TPLWeb.Tools.ControllerActions>

@{
    string rolename = ViewBag.RoleName;
    var roleClaims = ViewBag.RoleClaims as IList<System.Security.Claims.Claim>;
}

@section vendorcss {
    <link rel="stylesheet" href="~/assets/vendor/libs/animate-css/animate.css" />
     <link rel="stylesheet" href="~/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
}

@section pagecss {
    <style>
        .access-management-card {
            border-radius: 15px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            border: none;
            overflow: hidden;
        }

        .card-header {
            background: linear-gradient(135deg, #7367F0 0%, #A66FFE 100%);
            color: white;
            padding: 1.25rem 1.5rem;
            border-bottom: none;
        }

        .controller-card {
            border-radius: 10px;
            border: 1px solid #e5e5e5;
            margin-bottom: 1.5rem;
            overflow: hidden;
        }

        .controller-header {
            background-color: #f8f9fa;
            padding: 0.75rem 1.25rem;
            border-bottom: 1px solid #e5e5e5;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            .controller-header i {
                margin-left: 0.5rem;
                color: #7367F0;
            }

        .select-all-btn {
            font-size: 0.75rem;
            padding: 0.25rem 0.5rem;
            border-radius: 4px;
        }

        .action-item {
            padding: 0.75rem 1.25rem;
            border-bottom: 1px solid #f0f0f0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: background-color 0.2s;
        }

            .action-item:hover {
                background-color: #f9f9f9;
            }

        .action-name {
            display: flex;
            align-items: center;
            flex-grow: 1;
        }

        .action-method {
            font-size: 0.75rem;
            padding: 0.25rem 0.5rem;
            border-radius: 4px;
            margin-left: 0.75rem;
            font-weight: 600;
            min-width: 60px;
            text-align: center;
        }

        .method-get {
            background-color: #e8f5e9;
            color: #2e7d32;
        }

        .method-post {
            background-color: #e3f2fd;
            color: #1565c0;
        }

        .method-put {
            background-color: #fff8e1;
            color: #ff8f00;
        }

        .method-delete {
            background-color: #ffebee;
            color: #c62828;
        }

        .method-patch {
            background-color: #f3e5f5;
            color: #7b1fa2;
        }

        .method-other {
            background-color: #e0e0e0;
            color: #424242;
        }

        .switch-lg .form-check-input {
            width: 3rem;
            height: 1.5rem;
        }

        .submit-btn {
            padding: 0.75rem 2rem;
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        .global-controls {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            border-radius: 12px;
            padding: 1.5rem;
            border: 1px solid #dee2e6;
        }

        .stats-card {
            border: 1px solid #dee2e6;
            transition: all 0.3s ease;
        }

        .stats-card:hover {
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            transform: translateY(-2px);
        }

        .global-actions .btn {
            border-radius: 8px;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .global-actions .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }

        .select-all-btn, .deselect-all-btn {
            font-size: 0.75rem;
            padding: 0.375rem 0.75rem;
            border-radius: 6px;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .select-all-btn:hover, .deselect-all-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        }

        .progress-section {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 1rem;
            border: 1px solid #e9ecef;
        }

        .progress {
            border-radius: 10px;
            background-color: #e9ecef;
        }

        .progress-bar {
            border-radius: 10px;
            transition: width 0.6s ease;
        }

        .controller-card {
            transition: all 0.3s ease;
        }

        .controller-card:hover {
            box-shadow: 0 6px 25px rgba(0,0,0,0.1);
            transform: translateY(-2px);
        }

        .action-item {
            transition: all 0.3s ease;
        }

        .action-item:hover {
            background-color: #f8f9fa;
            transform: translateX(5px);
        }

        .form-check-input:checked {
            background-color: #28a745;
            border-color: #28a745;
        }

        .form-check-input:focus {
            box-shadow: 0 0 0 0.2rem rgba(40, 167, 69, 0.25);
        }

        .btn-outline-secondary:hover {
            background-color: #6c757d;
            border-color: #6c757d;
            color: white;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate__fadeIn {
            animation: fadeInUp 0.6s ease;
        }

        .btn-loading {
            position: relative;
            overflow: hidden;
        }

        .btn-loading::after {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
            animation: loading-shimmer 0.8s ease-in-out;
        }

        @@keyframes loading-shimmer {
            0% { left: -100%; }
            100% { left: 100%; }
        }

        .alert {
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
            border: none;
            border-radius: 8px;
        }

        .alert-success {
            background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
            color: #155724;
            border-left: 4px solid #28a745;
        }

        .alert-warning {
            background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
            color: #856404;
            border-left: 4px solid #ffc107;
        }

        .alert-info {
            background: linear-gradient(135deg, #d1ecf1 0%, #bee5eb 100%);
            color: #0c5460;
            border-left: 4px solid #17a2b8;
        }

        .alert-danger {
            background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);
            color: #721c24;
            border-left: 4px solid #dc3545;
        }
    </style>
}

<div class="row animate__animated animate__fadeIn">
    <div class="col-12">
        <div class="card access-management-card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-user-shield me-2"></i>
                    مدیریت دسترسی نقش: @rolename
                </h5>
            </div>

            <div class="card-body">
                <!-- Global Controls Section -->
                <div class="global-controls mb-4">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="stats-card bg-light p-3 rounded">
                                <h6 class="mb-2">
                                    <i class="fas fa-chart-pie me-2 text-primary"></i>آمار کلی
                                </h6>
                                <div class="d-flex justify-content-between">
                                    <span>کل کنترلرها: <strong id="totalControllers">@Model.Count</strong></span>
                                    <span>کل اکشن‌ها: <strong id="totalActions">@Model.Sum(c => c.Actions?.Count ?? 0)</strong></span>
                                    <span>فعال: <strong id="totalActive" class="text-success">0</strong></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="global-actions d-flex gap-2 justify-content-end">
                                <button type="button" class="btn btn-success" id="activateAllGlobal">
                                    <i class="fas fa-check-circle me-2"></i>فعال کردن همه دسترسی‌ها
                                </button>
                                <button type="button" class="btn btn-danger" id="deactivateAllGlobal">
                                    <i class="fas fa-times-circle me-2"></i>غیرفعال کردن همه دسترسی‌ها
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <form asp-action="AssignRoleAccess" asp-route-roleName="@rolename" method="post" id="permissionsForm">
                    @{
                        int count = 0;
                    }

                    @foreach (var controller in Model)
                    {
                        <div class="controller-card" data-controller="@controller.ControllerName">
                            <div class="controller-header">
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-cubes me-2"></i>
                                    <span>کنترلر: @controller.ControllerName</span>
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-success select-all-btn" 
                                            data-action="select-all" data-controller="@controller.ControllerName">
                                        <i class="fas fa-check-double me-1"></i>فعال کردن همه
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger deselect-all-btn" 
                                            data-action="deselect-all" data-controller="@controller.ControllerName">
                                        <i class="fas fa-times me-1"></i>غیرفعال کردن همه
                                    </button>
                                </div>
                            </div>

                            <div class="controller-body p-0">
                                @foreach (var action in controller.Actions!)
                                {
                                    var method = action.StartsWith("Get") ? "GET" :
                                    action.StartsWith("Post") ? "POST" :
                                    action.StartsWith("Put") ? "PUT" :
                                    action.StartsWith("Delete") ? "DELETE" : "OTHER";

                                    <div class="action-item">
                                        <div class="action-name">
                                            <span class="text-muted">اکشن:</span>
                                            <strong class="mx-2">@action</strong>

                                            <span class="action-method method-@method.ToLower()">
                                                @method
                                            </span>
                                        </div>

                                        <div class="form-check form-switch switch-lg">
                                            <input type="hidden" name="controllerActions[@count].ControllerName" value="@controller.ControllerName" />
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   role="switch"
                                                   name="controllerActions[@count].Actions"
                                                   value="@action"
                                                   id="perm-@count"
                                                   @(roleClaims!.Any(c => c.Type == "Permission" && c.Value == $"{controller.ControllerName}:{action}") ? "checked" : "") />
                                            <label class="form-check-label" for="perm-@count"></label>
                                        </div>
                                    </div>
                                    count++;
                                }
                            </div>
                        </div>
                    }

                    <!-- Progress Section -->
                    <div class="progress-section mt-4 mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted">پیشرفت فعال‌سازی:</span>
                            <span class="text-primary fw-bold" id="progressText">0%</span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-success" role="progressbar" id="progressBar" 
                                 style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <div class="d-flex gap-3 justify-content-center flex-wrap">
                            <button type="submit" class="btn btn-primary submit-btn">
                                <i class="fas fa-save me-2"></i>
                                بروزرسانی دسترسی‌ها
                            </button>
                            <button type="button" class="btn btn-outline-secondary" id="resetForm">
                                <i class="fas fa-undo me-2"></i>
                                بازنشانی
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section vendorjs {
}

@section PageJs {
    <script>
        $(document).ready(function() {
            let totalActions = 0;
            let activeActions = 0;

            // Initialize the page
            initializePage();

            function initializePage() {
                totalActions = $('.form-check-input').length;
                updateStats();
                updateProgress();
            }

            function updateStats() {
                activeActions = $('.form-check-input:checked').length;
                $('#totalActive').text(activeActions);
            }

            function updateProgress() {
                const percentage = totalActions > 0 ? Math.round((activeActions / totalActions) * 100) : 0;
                $('#progressText').text(percentage + '%');
                $('#progressBar').css('width', percentage + '%').attr('aria-valuenow', percentage);
            }

            // Global activation/deactivation
            $('#activateAllGlobal').click(function() {
                if (confirm('آیا از فعال کردن همه دسترسی‌ها اطمینان دارید؟')) {
                    $('.form-check-input').prop('checked', true);
                    updateStats();
                    updateProgress();
                    showNotification('همه دسترسی‌ها فعال شدند', 'success');
                }
            });

            $('#deactivateAllGlobal').click(function() {
                if (confirm('آیا از غیرفعال کردن همه دسترسی‌ها اطمینان دارید؟')) {
                    $('.form-check-input').prop('checked', false);
                    updateStats();
                    updateProgress();
                    showNotification('همه دسترسی‌ها غیرفعال شدند', 'warning');
                }
            });

            // Controller-specific activation/deactivation
            $('.select-all-btn').click(function() {
                const controllerCard = $(this).closest('.controller-card');
                const controllerName = controllerCard.data('controller');
                const checkboxes = controllerCard.find('.form-check-input');
                
                checkboxes.prop('checked', true);
                updateStats();
                updateProgress();
                showNotification(`همه دسترسی‌های کنترلر ${controllerName} فعال شدند`, 'success');
            });

            $('.deselect-all-btn').click(function() {
                const controllerCard = $(this).closest('.controller-card');
                const controllerName = controllerCard.data('controller');
                const checkboxes = controllerCard.find('.form-check-input');
                
                checkboxes.prop('checked', false);
                updateStats();
                updateProgress();
                showNotification(`همه دسترسی‌های کنترلر ${controllerName} غیرفعال شدند`, 'warning');
            });

            // Individual checkbox change handling
            $('.form-check-input').change(function() {
                updateStats();
                updateProgress();
                
                // Update button states based on controller
                const controllerCard = $(this).closest('.controller-card');
                updateControllerButtonStates(controllerCard);
            });

            function updateControllerButtonStates(controllerCard) {
                const checkboxes = controllerCard.find('.form-check-input');
                const checkedCount = checkboxes.filter(':checked').length;
                const totalCount = checkboxes.length;
                
                const selectAllBtn = controllerCard.find('.select-all-btn');
                const deselectAllBtn = controllerCard.find('.deselect-all-btn');
                
                if (checkedCount === 0) {
                    selectAllBtn.removeClass('btn-outline-success').addClass('btn-success');
                    deselectAllBtn.removeClass('btn-danger').addClass('btn-outline-danger');
                } else if (checkedCount === totalCount) {
                    selectAllBtn.removeClass('btn-success').addClass('btn-outline-success');
                    deselectAllBtn.removeClass('btn-outline-danger').addClass('btn-danger');
                } else {
                    selectAllBtn.removeClass('btn-success').addClass('btn-outline-success');
                    deselectAllBtn.removeClass('btn-danger').addClass('btn-outline-danger');
                }
            }

            // Reset form functionality
            $('#resetForm').click(function() {
                if (confirm('آیا از بازنشانی فرم اطمینان دارید؟ تمام تغییرات از بین خواهند رفت.')) {
                    // Reset to original state (you might need to store original values)
                    location.reload();
                }
            });

            // Form submission handling
            $('#permissionsForm').on('submit', function() {
                $('.submit-btn').prop('disabled', true);
                $('.submit-btn').html('<span class="spinner-border spinner-border-sm me-2" role="status"></span>در حال ذخیره...');
                
                // Show progress
                showNotification('در حال ذخیره تغییرات...', 'info');
            });

            // Notification system
            function showNotification(message, type = 'info') {
                const alertClass = `alert-${type}`;
                const iconClass = type === 'success' ? 'fa-check-circle' : 
                                 type === 'warning' ? 'fa-exclamation-triangle' : 
                                 type === 'danger' ? 'fa-times-circle' : 'fa-info-circle';
                
                const notification = $(`
                    <div class="alert ${alertClass} alert-dismissible fade show position-fixed" 
                         style="top: 20px; right: 20px; z-index: 9999; min-width: 300px;">
                        <i class="fas ${iconClass} me-2"></i>
                        ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                `);
                
                $('body').append(notification);
                
                // Auto-remove after 3 seconds
                setTimeout(function() {
                    notification.alert('close');
                }, 3000);
            }

            // Initialize controller button states
            $('.controller-card').each(function() {
                updateControllerButtonStates($(this));
            });

            // Keyboard shortcuts
            $(document).keydown(function(e) {
                // Ctrl+A to activate all
                if (e.ctrlKey && e.key === 'a') {
                    e.preventDefault();
                    $('#activateAllGlobal').click();
                }
                // Ctrl+D to deactivate all
                if (e.ctrlKey && e.key === 'd') {
                    e.preventDefault();
                    $('#deactivateAllGlobal').click();
                }
            });

            // Add loading animation to buttons
            $('.btn').click(function() {
                const btn = $(this);
                if (!btn.hasClass('submit-btn')) {
                    btn.addClass('btn-loading');
                    setTimeout(() => btn.removeClass('btn-loading'), 200);
                }
            });
        });
    </script>
}