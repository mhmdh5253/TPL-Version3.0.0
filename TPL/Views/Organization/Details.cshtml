@using Microsoft.AspNetCore.Mvc.TagHelpers
@model BE.LetterAutomation.Organization
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

}

@section pagecss {
    <style>
        .card {
            border: none;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            border-radius: 0.5rem;
            margin-bottom: 1.5rem;
        }

        .card-header {
            background-color: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
            padding: 1rem 1.5rem;
        }

        .card-header h5 {
            margin: 0;
            color: #495057;
            font-weight: 600;
        }

        .card-body {
            padding: 1.5rem;
        }

        .card-footer {
            background-color: #f8f9fa;
            border-top: 1px solid #dee2e6;
            padding: 1rem 1.5rem;
        }

        .info-section {
            background: #f8f9fa;
            border-radius: 0.5rem;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            border-left: 4px solid #0d6efd;
        }

        .info-section h6 {
            color: #495057;
            font-weight: 600;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
        }

        .info-section h6 i {
            color: #0d6efd;
            margin-left: 0.5rem;
        }

        .info-item {
            display: flex;
            align-items: center;
            margin-bottom: 1rem;
            padding: 0.75rem;
            background: white;
            border-radius: 0.375rem;
            border: 1px solid #e9ecef;
        }

        .info-item:last-child {
            margin-bottom: 0;
        }

        .info-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            margin-left: 1rem;
            font-size: 1rem;
        }

        .info-content {
            flex: 1;
        }

        .info-label {
            color: #6c757d;
            font-size: 0.8rem;
            margin-bottom: 0.25rem;
            font-weight: 500;
        }

        .info-value {
            color: #495057;
            font-weight: 600;
            font-size: 0.95rem;
        }

        .badge {
            font-size: 0.8rem;
            padding: 0.4rem 0.75rem;
            border-radius: 0.375rem;
            font-weight: 500;
        }

        .btn {
            border-radius: 0.375rem;
            padding: 0.5rem 1rem;
            font-size: 0.875rem;
            font-weight: 500;
            margin-left: 0.5rem;
        }

        .btn-primary {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }

        .btn-primary:hover {
            background-color: #0b5ed7;
            border-color: #0a58ca;
        }

        .btn-outline-secondary {
            color: #6c757d;
            border-color: #6c757d;
        }

        .btn-outline-secondary:hover {
            background-color: #6c757d;
            border-color: #6c757d;
        }

        .btn-outline-danger {
            color: #dc3545;
            border-color: #dc3545;
        }

        .btn-outline-danger:hover {
            background-color: #dc3545;
            border-color: #dc3545;
        }

        .btn-outline-success {
            color: #198754;
            border-color: #198754;
        }

        .btn-outline-success:hover {
            background-color: #198754;
            border-color: #198754;
        }

        .org-link {
            color: #0d6efd;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.15s ease-in-out;
        }

        .org-link:hover {
            color: #0a58ca;
            text-decoration: underline;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            padding: 0.375rem 0.75rem;
            border-radius: 0.375rem;
            font-size: 0.8rem;
            font-weight: 500;
        }

        .status-active {
            background-color: #d1e7dd;
            color: #0f5132;
            border: 1px solid #badbcc;
        }

        .status-inactive {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c2c7;
        }

        .type-badge {
            display: inline-flex;
            align-items: center;
            padding: 0.375rem 0.75rem;
            border-radius: 0.375rem;
            font-size: 0.8rem;
            font-weight: 500;
        }

        .type-main {
            background-color: #cfe2ff;
            color: #084298;
            border: 1px solid #b6d4fe;
        }

        .type-department {
            background-color: #d1ecf1;
            color: #0c5460;
            border: 1px solid #bee5eb;
        }

        .type-unit {
            background-color: #e2e3e5;
            color: #41464b;
            border: 1px solid #d3d4d6;
        }

        .type-section {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c2c7;
        }

        .description-box {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 0.5rem;
            padding: 1rem;
            margin-top: 0.5rem;
        }

        .description-text {
            color: #495057;
            line-height: 1.6;
            margin: 0;
        }

        .description-empty {
            color: #6c757d;
            font-style: italic;
            margin: 0;
        }

        .page-header {
            display: flex;
            justify-content: between;
            align-items: center;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #dee2e6;
        }

        .page-title {
            color: #495057;
            font-weight: 600;
            margin: 0;
            display: flex;
            align-items: center;
        }

        .page-title i {
            color: #0d6efd;
            margin-left: 0.75rem;
        }

        .page-actions {
            display: flex;
            gap: 0.5rem;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .stat-card {
            background: white;
            border: 1px solid #e9ecef;
            border-radius: 0.5rem;
            padding: 1rem;
            text-align: center;
            transition: all 0.15s ease-in-out;
        }

        .stat-card:hover {
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            transform: translateY(-1px);
        }

        .stat-number {
            font-size: 1.5rem;
            font-weight: 700;
            color: #0d6efd;
            margin-bottom: 0.5rem;
        }

        .stat-label {
            color: #6c757d;
            font-size: 0.875rem;
            font-weight: 500;
        }

        @@media (max-width: 768px) {
            .page-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 1rem;
            }

            .page-actions {
                width: 100%;
                justify-content: center;
            }

            .stats-grid {
                grid-template-columns: 1fr;
            }

            .btn {
                margin-left: 0;
                margin-bottom: 0.5rem;
                width: 100%;
            }
        }
    </style>
}

<div class="row">
    <div class="col-md-12">
        <!-- Page Header -->
        <div class="page-header">
            <div>
                <h4 class="page-title">
                    <i class="fas fa-building"></i>جزئیات سازمان
                </h4>
                <p class="text-muted mb-0 mt-1">@Model.Name</p>
            </div>
            <div class="page-actions">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="fas fa-edit me-1"></i>ویرایش
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i>بازگشت
                </a>
            </div>
        </div>

        <!-- Organization Code Badge -->
        <div class="card">
            <div class="card-body text-center">
                <span class="badge bg-primary fs-6 px-3 py-2">
                    <i class="fas fa-hashtag me-1"></i>کد: @Model.Code
                </span>
            </div>
        </div>

        <!-- Statistics Grid -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-number">@Model.Children.Count</div>
                <div class="stat-label">زیرمجموعه</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">@Model.CreatedAt.ToString("yyyy")</div>
                <div class="stat-label">سال تأسیس</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">
                    @if (Model.IsActive)
                    {
                        <span class="text-success">فعال</span>
                    }
                    else
                    {
                        <span class="text-danger">غیرفعال</span>
                    }
                </div>
                <div class="stat-label">وضعیت</div>
            </div>
        </div>

        <!-- Main Information -->
        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-info-circle me-2"></i>اطلاعات اصلی
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="info-item">
                            <div class="info-icon bg-primary">
                                <i class="fas fa-building"></i>
                            </div>
                            <div class="info-content">
                                <div class="info-label">نام سازمان</div>
                                <div class="info-value">@Model.Name</div>
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-icon bg-info">
                                <i class="fas fa-sitemap"></i>
                            </div>
                            <div class="info-content">
                                <div class="info-label">نوع سازمان</div>
                                <div class="info-value">
                                    @switch (Model.OrgType)
                                    {
                                        case "main":
                                            <span class="type-badge type-main">🏢 سازمان اصلی</span>
                                            break;
                                        case "department":
                                            <span class="type-badge type-department">🏛️ اداره</span>
                                            break;
                                        case "unit":
                                            <span class="type-badge type-unit">🏢 واحد</span>
                                            break;
                                        case "section":
                                            <span class="type-badge type-section">📋 بخش</span>
                                            break;
                                        default:
                                            <span class="type-badge type-main">@Model.OrgType</span>
                                            break;
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-icon bg-success">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <div class="info-content">
                                <div class="info-label">وضعیت</div>
                                <div class="info-value">
                                    @if (Model.IsActive)
                                    {
                                        <span class="status-badge status-active">✅ فعال</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">❌ غیرفعال</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-icon bg-warning">
                                <i class="fas fa-users"></i>
                            </div>
                            <div class="info-content">
                                <div class="info-label">تعداد زیرمجموعه‌ها</div>
                                <div class="info-value">@Model.Children.Count</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-link me-2"></i>اطلاعات تکمیلی
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="info-item">
                            <div class="info-icon bg-secondary">
                                <i class="fas fa-level-up-alt"></i>
                            </div>
                            <div class="info-content">
                                <div class="info-label">سازمان مافوق</div>
                                <div class="info-value">
                                    @if (Model.Parent != null)
                                    {
                                        <a href="#" class="org-link" data-id="@Model.Parent.Id">@Model.Parent.Name</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">ندارد</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-icon bg-info">
                                <i class="fas fa-calendar-plus"></i>
                            </div>
                            <div class="info-content">
                                <div class="info-label">تاریخ ایجاد</div>
                                <div class="info-value">@Model.CreatedAt.ToString("yyyy/MM/dd")</div>
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-icon bg-warning">
                                <i class="fas fa-calendar-edit"></i>
                            </div>
                            <div class="info-content">
                                <div class="info-label">آخرین ویرایش</div>
                                <div class="info-value">
                                    @if (Model.UpdatedAt.HasValue)
                                    {
                                        @Model.UpdatedAt.Value.ToString("yyyy/MM/dd")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.Phone) || !string.IsNullOrEmpty(Model.Email) || !string.IsNullOrEmpty(Model.Address))
                        {
                            <div class="info-item">
                                <div class="info-icon bg-primary">
                                    <i class="fas fa-address-book"></i>
                                </div>
                                <div class="info-content">
                                    <div class="info-label">اطلاعات تماس</div>
                                    <div class="info-value">
                                        @if (!string.IsNullOrEmpty(Model.Phone))
                                        {
                                            <div><i class="fas fa-phone me-1"></i>@Model.Phone</div>
                                        }
                                        @if (!string.IsNullOrEmpty(Model.Email))
                                        {
                                            <div><i class="fas fa-envelope me-1"></i>@Model.Email</div>
                                        }
                                        @if (!string.IsNullOrEmpty(Model.Address))
                                        {
                                            <div><i class="fas fa-map-marker-alt me-1"></i>@Model.Address</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Description Section -->
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-align-left me-2"></i>توضیحات
                    </h5>
                </div>
                <div class="card-body">
                    <div class="description-box">
                        <p class="description-text">@Model.Description</p>
                    </div>
                </div>
            </div>
        }

        <!-- Action Buttons -->
        <div class="card">
            <div class="card-footer">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <button class="btn btn-outline-secondary toggle-status-btn" data-id="@Model.Id">
                            @if (Model.IsActive)
                            {
                                <i class="fas fa-ban me-1"></i>
                                @("غیرفعال کردن")
                            }
                            else
                            {
                                <i class="fas fa-check me-1"></i>
                                @("فعال کردن")
                            }
                        </button>
                    </div>
                    <div class="text-muted small">
                        <i class="fas fa-info-circle me-1"></i>
                        آخرین بروزرسانی: @DateTime.Now.ToString("yyyy/MM/dd HH:mm")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section pagejs {
    <script>
        $(document).ready(function() {
            // لینک سازمان مافوق
            $('.org-link').click(function(e) {
                e.preventDefault();
                const orgId = $(this).data('id');
                $('.org-item').removeClass('active');
                $(`.org-item[data-id="${orgId}"]`).addClass('active').click();
            });

            // تغییر وضعیت فعال/غیرفعال
            $('.toggle-status-btn').click(function() {
                const orgId = $(this).data('id');
                const $btn = $(this);
                const originalText = $btn.html();
                
                // نمایش loading
                $btn.html('<i class="fas fa-spinner fa-spin me-2"></i>در حال پردازش...');
                $btn.prop('disabled', true);
                
                $.post('/Organization/ToggleStatus', { id: orgId })
                    .done(function() {
                        // نمایش پیام موفقیت
                        $btn.removeClass('btn-outline-secondary').addClass('btn-success');
                        $btn.html('<i class="fas fa-check me-2"></i>انجام شد');
                        
                        setTimeout(function() {
                            location.reload();
                        }, 1500);
                    })
                    .fail(function() {
                        // نمایش خطا
                        $btn.removeClass('btn-outline-secondary').addClass('btn-danger');
                        $btn.html('<i class="fas fa-times me-2"></i>خطا');
                        
                        setTimeout(function() {
                            $btn.removeClass('btn-danger').addClass('btn-outline-secondary');
                            $btn.html(originalText);
                            $btn.prop('disabled', false);
                        }, 2000);
                    });
            });
        });
    </script>
}