    <script src="~/assets/vendor/libs/flatpickr/fa-jdate.js"></script>
    <script src="~/assets/vendor/libs/jquery-timepicker/jquery-timepicker.js"></script>

    <!-- کتابخانه‌های دیگر -->
    <script src="~/assets/vendor/libs/swiper/swiper.js"></script>
    <script src="~/assets/vendor/libs/pickr/pickr.js"></script>
    <script src="~/assets/vendor/libs/tagify/tagify.js"></script>
    <script src="~/assets/vendor/libs/bloodhound/bloodhound.js"></script>
    <script src="~/assets/vendor/libs/quill/katex.js"></script>
    <script src="~/assets/vendor/libs/quill/quill.js"></script>
    <!-- فایل‌های اسکریپت اختصاصی (حداقل‌سازی جهت جلوگیری از خطاهای نبود المان) -->
    <script src="~/assets/js/forms-selects.js"></script>
    <script src="~/assets/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
    <script src="~/assets/js/ui-modals.js" type="module"></script>
    <script src="~/assets/js/tables-datatables-advanced.js"></script>

    <!-- اسکریپت ابتدایی: Initialize Tagify و مدیریت چک‌باکس‌ها در مودال انتخاب کلاسه نامه -->
    <script>
        // Initialize Tagify only if the element exists
        document.addEventListener('DOMContentLoaded', function () {
            var tagEl = document.getElementById('TagifyBasic');
            if (tagEl && window.Tagify) {
                try { new Tagify(tagEl); } catch (e) { console.warn('Tagify init error', e); }
            }
        });
    </script>

    <!-- اسکریپت مدیریت انتخاب کلاسه نامه از مودال -->
    <script>
        $(document).ready(function(){
            // انتخاب کلاسه نامه از مودال اختصاصی
            $(document).on('change', '#FileCodeSelectModal tbody tr input[type="checkbox"]', function(){
                var checkedBoxes = $('#FileCodeSelectModal tbody tr input[type="checkbox"]:checked');
                $('#selectFileCodeBtn').prop('disabled', checkedBoxes.length === 0);
            });
            $('#selectFileCodeBtn').on('click', function(){
                var checkedBoxes = $('#FileCodeSelectModal tbody tr input[type="checkbox"]:checked');
                if (checkedBoxes.length === 0) return;

                var selectedCodes = [];
                var selectedNames = [];
                checkedBoxes.each(function(){
                    var row = $(this).closest('tr');
                    selectedCodes.push(row.data('id'));
                    selectedNames.push(row.data('name'));
                });

                $('#FileCode').val(selectedCodes.join(','));
                $('#FileCodeText').val(selectedNames.join(', ') + ' (' + selectedCodes.join(', ') + ')');
                const el = document.getElementById('FileCodeSelectModal');
                if (window.bootstrap && bootstrap.Modal) {
                    bootstrap.Modal.getOrCreateInstance(el).hide();
                }
            });
        });
    </script>

    <!-- اسکریپت ابتدایی‌سازی DataTable برای نتایج جستجو -->
    <script>
        $(document).ready(function() {
            $('#letterSearchResults').DataTable();
        });
    </script>

    <!-- اسکریپت مدیریت درخت سازمانی برای سایر گیرندگان (copyOrgData) -->
    <script>
        $(document).ready(function() {
            // داده‌های درخت سازمانی برای سایر گیرندگان
            window.copyOrgData = [
                @foreach (var main in orgs.Where(o => o.IsMain))
                {
                        @: {
                        @:     id: "@main.Id",
                        @:     name: "@main.Name",
                        @:     level: 0,
                        @:     expanded: false,
                        @:     children: [
                        @foreach (var sub in orgs.Where(o => o.ParentId == main.Id))
                        {
                                @:         {
                                @:             id: "@sub.Id",
                                @:             name: "@sub.Name",
                                @:             level: 1,
                                @:             expanded: false,
                                @:             children: [
                                @foreach (var child in orgs.Where(o => o.ParentId == sub.Id))
                                {
                                        @:                 {
                                        @:                     id: "@child.Id",
                                        @:                     name: "@child.Name",
                                        @:                     level: 2,
                                        @:                     expanded: false,
                                        @:                     children: [
                                        @foreach (var leaf in orgs.Where(o => o.ParentId == child.Id))
                                        {
                                                @:                         { id: "@leaf.Id", name: "@leaf.Name", level: 3, children: [] },
                                        }
                                                            @:                     ]
                                        @:                 },
                                }
                                                @:             ]
                                @:         },
                        }
                                    @:     ]
                        @: },
                }
            ];

            // ساخت درخت HTML برای سایر گیرندگان
            function buildCopyTree(excludedId) {
                const container = document.getElementById('treeContainer');
                if (!container) {
                    console.error('treeContainer not found!');
                    return;
                }
                container.innerHTML = '';

                if (!window.copyOrgData || window.copyOrgData.length === 0) {
                    container.innerHTML = '<div class="text-center text-muted">هیچ سازمانی یافت نشد</div>';
                    return;
                }

                window.copyOrgData.forEach(org => {
                    if (org.id !== excludedId) {
                        renderCopyNode(org, container, 0);
                    }
                });
            }

            // رندر نود برای سایر گیرندگان
            function renderCopyNode(node, container, level) {
                const nodeDiv = document.createElement('div');
                nodeDiv.className = 'copy-tree-node';
                nodeDiv.setAttribute('data-copy-node-id', node.id);
                nodeDiv.setAttribute('data-level', level);

                const isSelected = node.selected || false;
                const hasChildren = node.children && node.children.length > 0;
                const isExpanded = node.expanded === true;

                nodeDiv.innerHTML = `
                    <div class="copy-node-row ${isSelected ? 'selected' : ''}" data-copy-id="${node.id}">
                        <div class="node-content">
                            <div class="node-expand">
                                ${hasChildren ?
                                  `<button type="button" class="copy-expand-btn ${isExpanded ? 'expanded' : ''}"
                                             data-copy-id="${node.id}">
                                            <i class="fas fa-chevron-left"></i>
                                         </button>` :
                                  '<span class="expand-placeholder"></span>'
                                        }
                            </div>
                            <div class="node-toggle">
                                <input type="checkbox" class="copy-node-checkbox" id="copy-node-${node.id}"
                                       data-copy-id="${node.id}" ${isSelected ? 'checked' : ''}>
                            </div>
                            <div class="node-name">${node.name}</div>
                            <div class="node-message">
                                <input type="text" class="copy-message-input" id="message-${node.id}"
                                       data-copy-id="${node.id}" placeholder="پیام اختصاصی برای ${node.name}"
                                       maxlength="200" style="display: ${isSelected ? 'block' : 'none'}">
                            </div>
                            <div class="copy-node-counter" data-copy-id="${node.id}"
                                 style="display: ${isSelected ? 'block' : 'none'}">0/200</div>
                        </div>
                    </div>
                `;

                container.appendChild(nodeDiv);
                if (hasChildren) {
                    const childrenContainer = document.createElement('div');
                    childrenContainer.className = isExpanded ? 'copy-children-container' : 'copy-children-container hidden';
                    childrenContainer.setAttribute('data-copy-parent-id', node.id);

                    node.children.forEach(child => {
                        renderCopyNode(child, childrenContainer, level + 1);
                    });

                    container.appendChild(childrenContainer);
                }
            }

            // تأیید انتخاب سایر گیرندگان
            $("#confirmSelection").click(function() {
                const selectedOrgs = [];
                $('.copy-node-checkbox:checked').each(function() {
                    const nodeId = $(this).data('copy-id');
                    const nodeName = $(this).closest('.copy-node-row').find('.node-name').text();
                    const messageInput = $(this).closest('.copy-node-row').find('.copy-message-input');
                    const note = messageInput.is(':visible') ? messageInput.val() || "" : "";
                    selectedOrgs.push({ id: nodeId, name: nodeName, note });
                });
                const idsOnly = selectedOrgs.map(o => o.id);
                $("#selectedOrganizations").val(idsOnly.join(","));
                $("#selectedOrganizationsNotes").val(JSON.stringify(selectedOrgs));
                const el = document.getElementById("Copyreciversmodal");
                if (window.bootstrap && bootstrap.Modal) {
                    bootstrap.Modal.getOrCreateInstance(el).hide();
                }
            });

            // تابع باز/بست کردن زیرمجموعه برای سایر گیرندگان
            function toggleCopyExpand(nodeId) {
                const expandBtn = document.querySelector(`.copy-expand-btn[data-copy-id="${nodeId}"]`);
                const childrenContainer = document.querySelector(`.copy-children-container[data-copy-parent-id="${nodeId}"]`);

                // پیدا کردن نود در ساختار داده‌های سایر گیرندگان
                const node = findCopyNodeById(nodeId, window.copyOrgData);

                if (childrenContainer) {
                    // چک کردن وضعیت فعلی
                    const isHidden = childrenContainer.classList.contains('hidden');

                    if (isHidden) {
                        childrenContainer.classList.remove('hidden');
                        if (expandBtn) {
                            expandBtn.classList.add('expanded');
                        }
                        if (node) {
                            node.expanded = true;
                        }
                    } else {
                        childrenContainer.classList.add('hidden');
                        if (expandBtn) {
                            expandBtn.classList.remove('expanded');
                        }
                        if (node) {
                            node.expanded = false;
                        }
                    }
                } else if (node && node.children && node.children.length > 0) {
                    // اگر فرزندان هنوز رندر نشده‌اند، آن‌ها را رندر کن
                    const parentNode = document.querySelector(`.copy-tree-node[data-copy-node-id="${nodeId}"]`);
                    if (parentNode) {
                        const newChildrenContainer = document.createElement('div');
                        newChildrenContainer.className = 'copy-children-container';
                        newChildrenContainer.setAttribute('data-copy-parent-id', nodeId);

                        node.children.forEach(child => {
                            renderCopyNode(child, newChildrenContainer, parseInt(parentNode.getAttribute('data-level')) + 1);
                        });

                        parentNode.parentNode.insertBefore(newChildrenContainer, parentNode.nextSibling);
                        if (expandBtn) {
                            expandBtn.classList.add('expanded');
                        }
                        if (node) {
                            node.expanded = true;
                        }
                    }
                }
            }

            // تابع پیدا کردن نود بر اساس ID برای سایر گیرندگان
            function findCopyNodeById(nodeId, nodes = window.copyOrgData) {
                for (let node of nodes) {
                    if (node.id === nodeId) {
                        return node;
                    }
                    if (node.children) {
                        const found = findCopyNodeById(nodeId, node.children);
                        if (found) return found;
                    }
                }
                return null;
            }

            // تابع تغییر وضعیت نود برای سایر گیرندگان
            function toggleCopyNode(nodeId) {
                const checkbox = document.querySelector(`.copy-node-checkbox[data-copy-id="${nodeId}"]`);
                if (!checkbox) return;

                const row = checkbox.closest('.copy-node-row');
                const messageInput = document.querySelector(`.copy-message-input[data-copy-id="${nodeId}"]`);
                const counter = document.querySelector(`.copy-node-counter[data-copy-id="${nodeId}"]`);

                if (checkbox.checked) {
                    row.classList.add('selected');
                    if (messageInput) messageInput.style.display = 'block';
                    if (counter) counter.style.display = 'block';
                } else {
                    row.classList.remove('selected');
                    if (messageInput) {
                        messageInput.style.display = 'none';
                        messageInput.value = '';
                    }
                    if (counter) {
                        counter.style.display = 'none';
                        counter.textContent = '0/200';
                        counter.className = 'copy-node-counter';
                    }
                }
            }

            // تابع به‌روزرسانی شمارنده برای سایر گیرندگان
            function updateCopyCounter(nodeId, length) {
                const counter = document.querySelector(`.copy-node-counter[data-copy-id="${nodeId}"]`);
                if (!counter) return;

                counter.textContent = length + '/200';
                counter.className = 'copy-node-counter';

                if (length > 180) {
                    counter.classList.add('text-warning');
                }
                if (length > 195) {
                    counter.classList.add('text-danger');
                }
            }

            // جستجو در درخت سایر گیرندگان
            $("#treeSearch").on("keyup", function() {
                const searchTerm = $(this).val().toLowerCase();

                if (searchTerm === '') {
                    $('.copy-tree-node').show();
                    $('.copy-children-container').show();
                    return;
                }

                $('.copy-tree-node').hide();
                $('.copy-children-container').hide();

                $('.copy-node-row').each(function() {
                    const nodeName = $(this).find('.node-name').text().toLowerCase();
                    if (nodeName.includes(searchTerm)) {
                        $(this).closest('.copy-tree-node').show();
                        $(this).closest('.copy-tree-node').parents('.copy-children-container').show();
                        $(this).closest('.copy-tree-node').parents('.copy-tree-node').show();
                        $(this).closest('.copy-tree-node').find('.copy-children-container').show();
                        $(this).closest('.copy-tree-node').find('.copy-tree-node').show();
                    }
                });
            });

            // رویدادهای کلیک برای دکمه‌های expand سایر گیرندگان
            $(document).on('click', '.copy-expand-btn', function() {
                const nodeId = $(this).data('copy-id');
                if (nodeId) {
                    toggleCopyExpand(nodeId);
                }
            });

            // رویدادهای تغییر برای چک‌باکس‌های سایر گیرندگان
            $(document).on('change', '.copy-node-checkbox', function() {
                const nodeId = $(this).data('copy-id');
                if (nodeId) {
                    toggleCopyNode(nodeId);
                }
            });

            // رویدادهای ورودی برای فیلدهای پیام سایر گیرندگان
            $(document).on('input', '.copy-message-input', function() {
                const nodeId = $(this).data('copy-id');
                if (nodeId) {
                    updateCopyCounter(nodeId, $(this).val().length);
                }
            });

            // مقداردهی اولیه درخت سایر گیرندگان
            buildCopyTree($("#Receiver").val() || '');
        });
    </script>

    <!-- اسکریپت مدیریت درخت سازمانی برای گیرنده اصلی (receiverOrgData) -->
    <script>
        $(document).ready(function() {
            // داده‌های درخت سازمانی برای گیرنده اصلی
            window.receiverOrgData = [
                @foreach (var main in orgs.Where(o => o.IsMain))
                {
                        @: {
                        @:     id: "@main.Id",
                        @:     name: "@main.Name",
                        @:     level: 0,
                        @:     expanded: false,
                        @:     children: [
                        @foreach (var sub in orgs.Where(o => o.ParentId == main.Id))
                        {
                                @:         {
                                @:             id: "@sub.Id",
                                @:             name: "@sub.Name",
                                @:             level: 1,
                                @:             expanded: false,
                                @:             children: [
                                @foreach (var child in orgs.Where(o => o.ParentId == sub.Id))
                                {
                                        @:                 {
                                        @:                     id: "@child.Id",
                                        @:                     name: "@child.Name",
                                        @:                     level: 2,
                                        @:                     expanded: false,
                                        @:                     children: [
                                        @foreach (var leaf in orgs.Where(o => o.ParentId == child.Id))
                                        {
                                                @:                         { id: "@leaf.Id", name: "@leaf.Name", level: 3, children: [] },
                                        }
                                                            @:                     ]
                                        @:                 },
                                }
                                                @:             ]
                                @:         },
                        }
                                    @:     ]
                        @: },
                }
            ];

            // ساخت درخت گیرنده اصلی
            function buildReceiverTree() {
                const container = document.getElementById('receiverTreeContainer');
                if (!container) {
                    console.error('receiverTreeContainer not found!');
                    return;
                }
                container.innerHTML = '';

                if (!window.receiverOrgData || window.receiverOrgData.length === 0) {
                    container.innerHTML = '<div class="text-center text-muted">هیچ سازمانی یافت نشد</div>';
                    return;
                }

                window.receiverOrgData.forEach(org => {
                    renderReceiverNode(org, container, 0);
                });
            }

            // تابع رندر نود گیرنده اصلی
            function renderReceiverNode(node, container, level) {
                const nodeDiv = document.createElement('div');
                nodeDiv.className = 'receiver-tree-node';
                nodeDiv.setAttribute('data-receiver-node-id', node.id);
                nodeDiv.setAttribute('data-level', level);

                const hasChildren = node.children && node.children.length > 0;
                const isExpanded = node.expanded === true;

                nodeDiv.innerHTML = `
                    <div class="receiver-node-row" data-receiver-id="${node.id}">
                        <div class="node-content">
                            <div class="node-expand">
                                ${hasChildren ?
                                  `<button type="button" class="receiver-expand-btn ${isExpanded ? 'expanded' : ''}"
                                             data-receiver-id="${node.id}">
                                    <i class="fas fa-chevron-left"></i>
                                 </button>` :
                                  '<span class="expand-placeholder"></span>'
                                        }
                            </div>
                            <div class="node-toggle">
                                <input type="radio" name="receiverSelection" class="receiver-node-radio" value="${node.id}">
                            </div>
                            <div class="node-name">${node.name}</div>
                        </div>
                    </div>
                `;

                container.appendChild(nodeDiv);

                // ایجاد childrenContainer برای گیرنده اصلی
                if (hasChildren) {
                    const childrenContainer = document.createElement('div');
                    childrenContainer.className = isExpanded ? 'receiver-children-container' : 'receiver-children-container hidden';
                    childrenContainer.setAttribute('data-receiver-parent-id', node.id);

                    node.children.forEach(child => {
                        renderReceiverNode(child, childrenContainer, level + 1);
                    });

                    container.appendChild(childrenContainer);
                }
            }

            // تابع باز/بسته کردن زیرمجموعه‌های گیرنده اصلی
            function toggleReceiverExpand(nodeId) {
                const expandBtn = document.querySelector(`.receiver-expand-btn[data-receiver-id="${nodeId}"]`);
                const childrenContainer = document.querySelector(`.receiver-children-container[data-receiver-parent-id="${nodeId}"]`);

                // پیدا کردن نود در ساختار داده‌های گیرنده
                const node = findReceiverNodeById(nodeId, window.receiverOrgData);

                if (childrenContainer) {
                    // چک کردن وضعیت فعلی
                    const isHidden = childrenContainer.classList.contains('hidden');

                    if (isHidden) {
                        childrenContainer.classList.remove('hidden');
                        if (expandBtn) {
                            expandBtn.classList.add('expanded');
                        }
                        if (node) {
                            node.expanded = true;
                        }
                    } else {
                        childrenContainer.classList.add('hidden');
                        if (expandBtn) {
                            expandBtn.classList.remove('expanded');
                        }
                        if (node) {
                            node.expanded = false;
                        }
                    }
                } else if (node && node.children && node.children.length > 0) {
                    // اگر فرزندان هنوز رندر نشده‌اند، آن‌ها را رندر کن
                    const parentNode = document.querySelector(`.receiver-tree-node[data-receiver-node-id="${nodeId}"]`);
                    if (parentNode) {
                        const newChildrenContainer = document.createElement('div');
                        newChildrenContainer.className = 'receiver-children-container';
                        newChildrenContainer.setAttribute('data-receiver-parent-id', nodeId);

                        node.children.forEach(child => {
                            renderReceiverNode(child, newChildrenContainer, parseInt(parentNode.getAttribute('data-level')) + 1);
                        });

                        parentNode.parentNode.insertBefore(newChildrenContainer, parentNode.nextSibling);
                        if (expandBtn) {
                            expandBtn.classList.add('expanded');
                        }
                        if (node) {
                            node.expanded = true;
                        }
                    }
                }
            }

            // تابع پیدا کردن نود گیرنده بر اساس ID
            function findReceiverNodeById(nodeId, nodes = window.receiverOrgData) {
                for (let node of nodes) {
                    if (node.id === nodeId) {
                        return node;
                    }
                    if (node.children) {
                        const found = findReceiverNodeById(nodeId, node.children);
                        if (found) return found;
                    }
                }
                return null;
            }

            // تابع انتخاب گیرنده اصلی
            function selectReceiver(nodeId, nodeName) {
                // فقط یک سازمان انتخاب شود
                $('.receiver-node-radio').prop('checked', false);
                $(`.receiver-node-radio[value="${nodeId}"]`).prop('checked', true);

                $('#Receiver').val(nodeId);

                // ساخت نام کامل با سلسله مراتب
                const fullName = getReceiverFullOrganizationName(nodeId);
                $('#ReceiverText').val(fullName);

                const el = document.getElementById('ReceiverSelectModal');
                if (window.bootstrap && bootstrap.Modal) {
                    bootstrap.Modal.getOrCreateInstance(el).hide();
                }
            }

            // تابع ساخت نام کامل سازمان با سلسله مراتب
            function getReceiverFullOrganizationName(nodeId) {
                const node = findReceiverNodeById(nodeId, window.receiverOrgData);
                if (!node) return '';

                const path = [];
                let currentNode = node;

                // جمع‌آوری مسیر از نود فعلی تا ریشه
                while (currentNode) {
                    path.unshift(currentNode.name);

                    // پیدا کردن والد
                    if (currentNode.level > 0) {
                        currentNode = findReceiverParentNode(currentNode.id);
                    } else {
                        currentNode = null;
                    }
                }

                return path.join('-');
            }

            // تابع پیدا کردن والد یک نود
            function findReceiverParentNode(nodeId) {
                for (let org of window.receiverOrgData) {
                    if (org.children) {
                        const found = findReceiverParentInChildren(org, nodeId);
                        if (found) return found;
                    }
                }
                return null;
            }

            // تابع جستجوی والد در فرزندان
            function findReceiverParentInChildren(parent, targetId) {
                if (parent.children) {
                    for (let child of parent.children) {
                        if (child.id === targetId) {
                            return parent;
                        }
                        const found = findReceiverParentInChildren(child, targetId);
                        if (found) return found;
                    }
                }
                return null;
            }

            // جستجو در درخت گیرنده اصلی
            $("#receiverTreeSearch").on("keyup", function() {
                const searchTerm = $(this).val().toLowerCase();

                if (searchTerm === '') {
                    $('.receiver-tree-node').show();
                    $('.receiver-children-container').show();
                    return;
                }

                $('.receiver-tree-node').hide();
                $('.receiver-children-container').hide();

                $('.receiver-node-row').each(function() {
                    const nodeName = $(this).find('.node-name').text().toLowerCase();
                    if (nodeName.includes(searchTerm)) {
                        $(this).closest('.receiver-tree-node').show();
                        $(this).closest('.receiver-tree-node').parents('.receiver-children-container').show();
                        $(this).closest('.receiver-tree-node').parents('.receiver-tree-node').show();
                        $(this).closest('.receiver-tree-node').find('.receiver-children-container').show();
                        $(this).closest('.receiver-tree-node').find('.receiver-tree-node').show();
                    }
                });
            });

            // تأیید انتخاب گیرنده اصلی
            $("#confirmReceiverSelection").click(function() {
                const selectedRadio = $('.receiver-node-radio:checked');
                if (selectedRadio.length > 0) {
                    const nodeId = selectedRadio.val();
                    const nodeName = selectedRadio.closest('.receiver-node-row').find('.node-name').text();
                    selectReceiver(nodeId, nodeName);
                } else {
                    Swal.fire({
                        title: 'خطا!',
                        text: 'لطفاً یک سازمان انتخاب کنید.',
                        icon: 'warning',
                        confirmButtonText: 'باشه'
                    });
                }
            });

            // رویدادهای کلیک برای دکمه‌های expand گیرنده اصلی
            $(document).on('click', '.receiver-expand-btn', function() {
                const nodeId = $(this).data('receiver-id');
                if (nodeId) {
                    toggleReceiverExpand(nodeId);
                }
            });

            // رویداد تغییر برای radio buttons گیرنده اصلی
            $(document).on('change', '.receiver-node-radio', function() {
                const nodeId = $(this).val();
                const nodeName = $(this).closest('.receiver-node-row').find('.node-name').text();
                selectReceiver(nodeId, nodeName);
            });

            // مقداردهی اولیه درخت گیرنده اصلی
            buildReceiverTree();
        });
    </script>

    <!-- اسکریپت مدیریت جستجوی نامه‌ها و انتخاب در مودال -->
    <script>
        $(document).ready(function() {
            $('#resetSearchBtn').click(function() {
                // ریست تمام فیلدهای داخل مودال
                $('#letterSearchModal')
                    .find('input[type="text"], input[type="search"], textarea')
                    .val('');

                // ریست فیلدهای خاص
                $('#FromDate, #ToDate').val('').trigger('change');

                // ریست Select2 اگر وجود دارد
                if ($.fn.select2) {
                    $('#letterSearchModal').find('select').val(null).trigger('change');
                }

                // ریست Datepickerها
                if ($.fn.persianDatepicker) {
                    $('#letterSearchModal').find('.persian-datepicker').persianDatepicker('setDate', null);
                }
                if ($.fn.flatpickr) {
                    $('#letterSearchModal').find('.flatpickr-date').flatpickr().clear();
                }

                // پاک کردن نتایج
                $('#letterSearchResults tbody').empty();
                $('#noResults').hide();
                $('#selectLetterBtn').prop('disabled', true);
                $('#letterSearchResults tr').removeClass('selected-row');
            });

            // Handle row selection
            $('#letterSearchResults').on('click', 'tr', function() {
                if (!$(this).hasClass('selected-row')) {
                    $('#letterSearchResults tr').removeClass('selected-row');
                    $(this).addClass('selected-row');
                    $('#selectLetterBtn').prop('disabled', false);
                } else {
                    $(this).removeClass('selected-row');
                    $('#selectLetterBtn').prop('disabled', true);
                }
            });

            // Select letter button
            $('#selectLetterBtn').click(function() {
                var selectedRow = $('#letterSearchResults tr.selected-row');
                if (selectedRow.length) {
                    var letterId = selectedRow.data('id');
                    var letterNumber = selectedRow.find('td:eq(1)').text();
                    var letterSubject = selectedRow.find('td:eq(2)').text();

                    $('#relatedLetterId').val(letterId);
                    $('#relatedLetterText').val(letterNumber + ' - ' + letterSubject);
                    const el = document.getElementById('letterSearchModal');
                    if (window.bootstrap && bootstrap.Modal) {
                        bootstrap.Modal.getOrCreateInstance(el).hide();
                    }
                }
            });

            // Search button click event
            $('#searchLetterBtn').click(function() {
                // Prepare search data (send only filled fields)
                var searchData = {};

                if ($('#Subjectsearch').val()) searchData.Subject = $('#Subjectsearch').val();
                if ($('#LetterNumber').val()) searchData.LetterNumber = $('#LetterNumber').val();
                if ($('#FromDate').val()) searchData.FromDate = $('#FromDate').val();
                if ($('#ToDate').val()) searchData.ToDate = $('#ToDate').val();

                // Check if at least one field is filled
                if (Object.keys(searchData).length === 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'خطا',
                        text: 'حداقل یک فیلد جستجو باید پر شود'
                    });
                    return;
                }

                // Show loading
                $('#searchLoading').show();
                $('#letterSearchResults tbody').empty();
                $('#noResults').hide();
                $('#selectLetterBtn').prop('disabled', true);

                // AJAX POST request
                $.ajax({
                    url: '/Letter/Search',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(searchData),
                    success: function(response) {
                        try {
                            $('#searchLoading').hide();
                            // بررسی وجود پاسخ و ساختار آن
                            if (response && response.Success && response.Data && response.Data.Data) {
                                var tableBody = $('#letterSearchResults tbody');
                                tableBody.empty();

                                var actualData = response.Data.Data; // دسترسی به داده‌های واقعی

                                if (actualData.length > 0) {
                                    $.each(actualData, function(index, letter) {
                                        var row = `
                                            <tr data-id="${letter.Id}">
                                                <td><input type="radio" name="selectedLetter" id="letter-${letter.Id}" value="${letter.Id}"></td>
                                                <td>${letter.LetterNumber || '-'}</td>
                                                <td>${letter.Subject || 'بدون موضوع'}</td>
                                                <td>${letter.RegistrationDate || 'نامشخص'}</td>
                                            </tr>
                                        `;
                                        tableBody.append(row);
                                    });
                                    $('#noResults').hide();
                                } else {
                                    $('#noResults').show();
                                    Swal.fire({
                                        icon: 'info',
                                        title: 'توجه',
                                        text: 'نتیجه‌ای یافت نشد'
                                    });
                                }
                            } else {
                                $('#noResults').show();
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'خطا',
                                    text: response.Message || 'خطا در ساختار پاسخ سرور'
                                });
                            }
                        } catch (e) {
                            console.error('Error:', e);
                            $('#noResults').show();
                            Swal.fire({
                                icon: 'error',
                                title: 'خطا',
                                text: 'خطا در پردازش نتایج'
                            });
                        }
                    },
                    error: function(xhr) {
                        $('#searchLoading').hide();
                        console.error("AJAX Error:", xhr.responseText);
                        Swal.fire({
                            icon: 'error',
                            title: 'خطا',
                            text: 'خطا در ارتباط با سرور'
                        });
                    },
                    complete: function() {
                        $('#searchLoading').hide();
                    }
                });
            });
        });
    </script>

