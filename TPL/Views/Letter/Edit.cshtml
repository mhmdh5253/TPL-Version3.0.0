    <!-- اسکریپت ویرایشگر Quill و اعتبارسنجی -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const editorElement = document.getElementById('editor');
            const counterElement = document.getElementById('counter');
            const form = document.querySelector('form.needs-validation');

            if (!editorElement) {
                console.error('Editor element not found!');
                return;
            }

            var quill = new Quill('#editor', {
                modules: {
                    toolbar: [
                        [{ 'font': [] }, { 'header': [1, 2, 3, 4, 5, 6, false] }],
                        ['bold', 'italic', 'underline', 'strike'],
                        [{ 'color': [] }, { 'background': [] }],
                        [{ 'script': 'super' }, { 'script': 'sub' }],
                        [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                        [{ 'indent': '-1' }, { 'indent': '+1' }],
                        [{ 'align': [] }],
                        ['blockquote', 'code-block'],
                        ['clean']
                    ],
                    history: { delay: 1000, maxStack: 200, userOnly: false },
                    clipboard: { matchVisual: true }
                },
                placeholder: 'متن خود را اینجا وارد کنید...',
                theme: 'snow'
            });
            window.quillEditor = quill;
            window.quill = quill;

            // Header AI button opens modal
            try {
                var btnOpenAi = document.getElementById('btnOpenAi');
                if (btnOpenAi && window.bootstrap && bootstrap.Modal) {
                    btnOpenAi.addEventListener('click', function(){
                        var modalEl = document.getElementById('aiModal');
                        if (modalEl) bootstrap.Modal.getOrCreateInstance(modalEl).show();
                    });
                }
            } catch (e) { console.warn('AI header button bind failed', e); }

            // بارگذاری محتوای قبلی
            const contentInput = document.getElementById('letterContent');
            if (contentInput && contentInput.value && contentInput.value.trim() !== '') {
                quill.root.innerHTML = contentInput.value;
            }

            function updateCounter() {
                if (!counterElement) return;
                const text = quill.getText().trim();
                const lines = text.split('\n').filter(line => line.trim() !== '').length;
                counterElement.textContent = `تعداد کاراکتر: ${text.length} | تعداد خطوط: ${lines}`;
            }

            quill.on('text-change', updateCounter);
            updateCounter();

            if (form) {
                form.addEventListener('submit', function(e) {
                    if (contentInput) {
                        contentInput.value = quill.root.innerHTML;
                    }

                    const text = quill.getText().trim();
                    if (text.length === 0) {
                        e.preventDefault();
                        e.stopPropagation();
                        Swal.fire({
                            title: 'خطا!',
                            text: 'لطفاً محتوای نامه را وارد کنید.',
                            icon: 'error',
                            confirmButtonText: 'باشه'
                        });
                        return false;
                    }

                    if (form.checkValidity() === false) {
                        e.preventDefault();
                        e.stopPropagation();
                        const invalidFields = form.querySelectorAll(':invalid');
                        let errorMessages = [];
                        invalidFields.forEach(field => {
                            const validationMessage = field.validationMessage;
                            if (validationMessage && validationMessage !== '') {
                                errorMessages.push(validationMessage);
                            }
                        });
                        if (errorMessages.length > 0) {
                            Swal.fire({
                                title: 'خطا در فرم!',
                                html: errorMessages.join('<br>'),
                                icon: 'error',
                                confirmButtonText: 'باشه'
                            });
                        }
                    }

                    if (uploadedFiles && uploadedFiles.length > 0) {
                        const fileEntries = uploadedFiles.map(file => `${file.name}|${file.id}`).join(',');
                        if (fileEntries.length > 255) {
                            $('#attachmentFiles').val(`${uploadedFiles.length} فایل آپلود شده`);
                        } else {
                            $('#attachmentFiles').val(fileEntries);
                        }
                        $('#attachmentsData').val(JSON.stringify(uploadedFiles));
                    }

                    form.classList.add('was-validated');
                });
            }

            // نمایش خطاهای سرور
            const validationErrors = $('.text-danger');
            if (validationErrors.length > 0) {
                let errorMessages = [];
                validationErrors.each(function() {
                    const errorText = $(this).text().trim();
                    if (errorText && errorText !== '') {
                        errorMessages.push(errorText);
                    }
                });
                if (errorMessages.length > 0) {
                    Swal.fire({
                        title: 'خطا در فرم!',
                        html: errorMessages.join('<br>'),
                        icon: 'error',
                        confirmButtonText: 'باشه'
                    });
                }
            }

            // نمایش پیام‌های موفقیت
            const successMessages = $('.alert-success');
            if (successMessages.length > 0) {
                const successText = successMessages.text().trim();
                if (successText && successText !== '') {
                    Swal.fire({
                        title: 'موفقیت!',
                        text: successText,
                        icon: 'success',
                        confirmButtonText: 'باشه'
                    });
                }
            }
            // مقداردهی اولیه ورودی‌های سایر گیرندگان از مدل
            try {
                const initialCcIds = '@(Model.CopyReceivers != null && Model.CopyReceivers.Count > 0 ? Model.CopyReceivers[0] : "")';
                const initialCcNotes = '@Html.Raw(Model.CopyReceivers != null && Model.CopyReceivers.Count > 1 ? (Model.CopyReceivers[1] ?? "[]") : "[]")';
                const ccIdsInput = document.getElementById('selectedOrganizations');
                const ccNotesInput = document.getElementById('selectedOrganizationsNotes');
                if (ccIdsInput && !ccIdsInput.value) ccIdsInput.value = initialCcIds;
                if (ccNotesInput && !ccNotesInput.value) ccNotesInput.value = initialCcNotes;
            } catch(e) { console.warn('Init CC inputs failed', e); }
        });
    </script>

    <!-- AI Generate/Refine Script -->
    <script>
        (function(){
            const aiPromptEl = document.getElementById('aiPrompt');
            const aiSubjectEl = document.getElementById('aiSubject');
            const aiToneEl = document.getElementById('aiTone');
            const aiProviderEl = document.getElementById('aiProvider');
            const aiModelEl = document.getElementById('aiModel');
            // Map model IDs to Persian display names (per request)
            function getModelDisplayName(id){
                const map = {
                    'x-ai/grok-4-fast:free': 'Grok 4 Fast (رایگان)',
                    'deepseek/deepseek-chat-v3.1:free': 'DeepSeek v3.1 (رایگان)',
                    'openai/gpt-oss-120b:free': 'GPT-OSS (رایگان)',
                    'qwen/qwen3-coder:free': 'Qwen3 (رایگان)'
                };
                if (map[id]) return map[id];
                try {
                    let label = id;
                    label = label.replace(/\//g, ' — ');
                    label = label.replace(/:/g, ' ');
                    return label;
                } catch (e) { return id; }
            }

            // Load providers/models with configured API keys
            function loadModels(){
                $.get('/Letter/Models', function(res){
                    if (!res || res.success !== true) return;
                    const data = res.data || [];
                    aiProviderEl.innerHTML = '';
                    aiModelEl.innerHTML = '';
                    if (data.length === 0){
                        aiProviderEl.innerHTML = '<option value="">— بدون کلید فعال —</option>';
                        aiModelEl.innerHTML = '<option value="">—</option>';
                        return;
                    }
                    var ordered = data.slice();
                    var openrouterIndex = ordered.findIndex(function(x){ return x.provider === 'openrouter'; });
                    if (openrouterIndex > 0) {
                        var orItem = ordered.splice(openrouterIndex, 1)[0];
                        ordered.unshift(orItem);
                    }
                    ordered.forEach(function(p, idx){
                        const opt = document.createElement('option');
                        opt.value = p.provider; opt.textContent = p.display; aiProviderEl.appendChild(opt);
                        if (idx === 0){
                            aiModelEl.innerHTML = '';
                            (p.models || []).forEach(function(m){ const om = document.createElement('option'); om.value = m; om.textContent = getModelDisplayName(m); aiModelEl.appendChild(om); });
                            aiProviderEl.value = p.provider;
                        }
                    });
                    aiProviderEl.addEventListener('change', function(){
                        const sel = data.find(x => x.provider === aiProviderEl.value);
                        aiModelEl.innerHTML = '';
                        (sel && sel.models || []).forEach(function(m){ const om = document.createElement('option'); om.value = m; om.textContent = getModelDisplayName(m); aiModelEl.appendChild(om); });
                    });
                });
            }

            loadModels();
            const aiRefineEl = document.getElementById('aiRefine');
            const aiPreview = document.getElementById('aiPreview');
            const btnGenerate = document.getElementById('btnAiGenerate');
            const btnApply = document.getElementById('btnAiApply');

            function setLoading(isLoading){
                btnGenerate.disabled = isLoading;
                btnGenerate.innerHTML = isLoading ? '<i class="fas fa-spinner fa-spin me-1"></i>در حال پردازش...' : '<i class="fas fa-wand-magic-sparkles me-1"></i>تولید/بهبود متن';
            }

            if (btnGenerate) { btnGenerate.addEventListener('click', function(){
                const prompt = ((aiPromptEl && aiPromptEl.value) ? aiPromptEl.value : '').trim();
                const subject = ((aiSubjectEl && aiSubjectEl.value) ? aiSubjectEl.value : '').trim();
                const tone = ((aiToneEl && aiToneEl.value) ? aiToneEl.value : '').trim();
                const refine = !!(aiRefineEl && aiRefineEl.checked);
                const currentHtml = window.quillEditor ? window.quillEditor.root.innerHTML : '';
                const currentText = window.quillEditor ? window.quillEditor.getText().trim() : '';

                if (!prompt && !(refine && currentText.length > 0)){
                    Swal.fire({ icon:'warning', title:'توجه', text:'شرح درخواست را وارد کنید یا گزینه بهبود متن فعلی را فعال کنید.'});
                    return;
                }

                setLoading(true);
                aiPreview.textContent = '';
                btnApply.disabled = true;

                $.ajax({
                    url: '/Letter/GenerateContent',
                    type: 'POST',
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify({
                        prompt: prompt,
                        subject: subject,
                        tone: tone,
                        refine: refine,
                        provider: (aiProviderEl && aiProviderEl.value) ? aiProviderEl.value : null,
                        model: (aiModelEl && aiModelEl.value) ? aiModelEl.value : null,
                        currentContent: refine ? currentHtml : null
                    }),
                    success: function(res){
                        const ok = (res && (res.success === true || res.Success === true));
                        const content = res && (res.content || res.Content);
                        if (ok && content){
                            aiPreview.textContent = content;
                            btnApply.disabled = false;
                        } else {
                            const msg = res && (res.message || res.Message) || 'پاسخی دریافت نشد.';
                            Swal.fire({ icon:'error', title:'خطا', text: msg});
                        }
                    },
                    error: function(xhr){
                        Swal.fire({ icon:'error', title:'خطا', text:'اشکال در ارتباط با سرور.'});
                    },
                    complete: function(){ setLoading(false); }
                });
            }); }

            if (btnApply) { btnApply.addEventListener('click', function(){
                const text = aiPreview.textContent || '';
                if (!text) return;
                const html = text.split(/\n\n+/).map(p => `<p>${$('<div>').text(p).html()}</p>`).join('');
                if (window.quillEditor){
                    window.quillEditor.clipboard.dangerouslyPasteHTML(html);
                }
                const modalEl = document.getElementById('aiModal');
                if (modalEl && window.bootstrap){
                    bootstrap.Modal.getOrCreateInstance(modalEl).hide();
                }
            }); }
        })();
    </script>

    
  <!-- اسکریپت مدیریت آپلود فایل‌ها و پیوست‌ها -->
    <script>
        // متغیرهای سراسری برای مدیریت فایل‌ها
        let selectedFiles = [];
        let uploadedFiles = [];
        const maxFiles = 20;
        const maxTotalSize = 500 * 1024 * 1024; // 500 MB
        const allowedTypes = {
            'image': ['.jpg', '.jpeg', '.png', '.gif', '.bmp', '.webp', '.svg'],
            'document': ['.pdf', '.doc', '.docx', '.xls', '.xlsx', '.ppt', '.pptx'],
            'archive': ['.zip', '.rar', '.7z'],
            'media': ['.mp4', '.avi', '.mov', '.mp3', '.wav'],
            'text': ['.txt']
        };

        // متغیرهای سراسری برای درخت سازمان
        window.orgData = null;

        // تابع‌های مدیریت فایل‌ها
        function initializeFileUpload() {
            // باز کردن مودال فایل‌ها
            document.getElementById('openAttachmentModal').addEventListener('click', function() {
                const modal = new bootstrap.Modal(document.getElementById('attachmentModal'));
                modal.show();
            });

            // مدیریت کشیدن و رها کردن فایل‌ها
            const dropZone = document.getElementById('dropZone');
            const fileInput = document.getElementById('fileInput');

            // جلوگیری از رفتار پیش‌فرض مرورگر
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                dropZone.addEventListener(eventName, preventDefaults, false);
                document.body.addEventListener(eventName, preventDefaults, false);
            });

            // هایلایت کردن منطقه کشیدن
            ['dragenter', 'dragover'].forEach(eventName => {
                dropZone.addEventListener(eventName, highlight, false);
            });

            ['dragleave', 'drop'].forEach(eventName => {
                dropZone.addEventListener(eventName, unhighlight, false);
            });

            // مدیریت رها کردن فایل‌ها
            dropZone.addEventListener('drop', handleDrop, false);
            dropZone.addEventListener('click', () => fileInput.click());

            // مدیریت انتخاب فایل‌ها
            fileInput.addEventListener('change', handleFiles);
        }

        function preventDefaults(e) {
            e.preventDefault();
            e.stopPropagation();
        }

        function highlight(e) {
            document.getElementById('dropZone').classList.add('dragover');
        }

        function unhighlight(e) {
            document.getElementById('dropZone').classList.remove('dragover');
        }

        function handleDrop(e) {
            const dt = e.dataTransfer;
            const files = dt.files;
            handleFiles({ target: { files } });
        }

        function handleFiles(e) {
            const files = Array.from(e.target.files);
            addFiles(files);
        }

        function addFiles(files) {
            files.forEach(file => {
                if (selectedFiles.length >= maxFiles) {
                    Swal.fire({
                        title: 'خطا!',
                        text: `حداکثر ${maxFiles} فایل می‌توانید انتخاب کنید.`,
                        icon: 'warning',
                        confirmButtonText: 'باشه'
                    });
                    return;
                }

                if (!isValidFileType(file)) {
                    Swal.fire({
                        title: 'خطا!',
                        text: `فرمت فایل ${file.name} مجاز نیست.`,
                        icon: 'error',
                        confirmButtonText: 'باشه'
                    });
                    return;
                }

                if (!isValidFileSize(file)) {
                    Swal.fire({
                        title: 'خطا!',
                        text: `حجم فایل ${file.name} بیش از حد مجاز است.`,
                        icon: 'error',
                        confirmButtonText: 'باشه'
                    });
                    return;
                }

                // بررسی حجم کل
                const currentTotalSize = selectedFiles.reduce((sum, f) => sum + f.size, 0);
                if (currentTotalSize + file.size > maxTotalSize) {
                    Swal.fire({
                        title: 'خطا!',
                        text: 'حجم کل فایل‌ها بیش از 500 مگابایت است.',
                        icon: 'error',
                        confirmButtonText: 'باشه'
                    });
                    return;
                }

                selectedFiles.push(file);
            });

            updateFilesList();
            updateUploadButton();
        }

        function isValidFileType(file) {
            const extension = '.' + file.name.split('.').pop().toLowerCase();
            return Object.values(allowedTypes).flat().includes(extension);
        }

        function isValidFileSize(file) {
            return file.size <= 100 * 1024 * 1024; // 100 MB per file
        }

        function getFileIcon(file) {
            const extension = '.' + file.name.split('.').pop().toLowerCase();

            if (allowedTypes.image.includes(extension)) {
                return { icon: 'fas fa-image', color: '#28a745' };
            } else if (allowedTypes.document.includes(extension)) {
                return { icon: 'fas fa-file-alt', color: '#007bff' };
            } else if (allowedTypes.archive.includes(extension)) {
                return { icon: 'fas fa-file-archive', color: '#6f42c1' };
            } else if (allowedTypes.media.includes(extension)) {
                return { icon: 'fas fa-file-video', color: '#fd7e14' };
            } else if (allowedTypes.text.includes(extension)) {
                return { icon: 'fas fa-file-text', color: '#20c997' };
            } else {
                return { icon: 'fas fa-file', color: '#6c757d' };
            }
        }

        function formatFileSize(bytes) {
            if (bytes === 0 || bytes === null || bytes === undefined) return 'نامشخص';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        }

        function updateFilesList() {
            const container = document.getElementById('modalFilesContainer');
            const filesList = document.getElementById('modalFilesList');
            const filesCount = document.getElementById('modalFilesCount');
            const totalSize = document.getElementById('modalTotalSize');

            if (selectedFiles.length === 0) {
                filesList.style.display = 'none';
                return;
            }

            filesList.style.display = 'block';
            container.innerHTML = '';

            const totalSizeBytes = selectedFiles.reduce((sum, file) => sum + file.size, 0);
            filesCount.textContent = selectedFiles.length;
            totalSize.textContent = (totalSizeBytes / (1024 * 1024)).toFixed(2);

            selectedFiles.forEach((file, index) => {
                const fileIcon = getFileIcon(file);
                const fileItem = document.createElement('div');
                fileItem.className = 'file-item';
                fileItem.innerHTML = `
                    <div class="file-info">
                        <div class="file-icon" style="background-color: ${fileIcon.color}">
                            <i class="${fileIcon.icon}"></i>
                        </div>
                        <div class="file-details">
                            <div class="file-name">${file.name}</div>
                            <div class="file-size">${formatFileSize(file.size)}</div>
                        </div>
                    </div>
                    <div class="file-actions">
                        <span class="file-status pending">در انتظار</span>
                        <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeFile(${index})">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                `;
                container.appendChild(fileItem);
            });
        }

        function removeFile(index) {
            selectedFiles.splice(index, 1);
            updateFilesList();
            updateUploadButton();
        }

        function updateUploadButton() {
            const uploadBtn = document.getElementById('uploadFilesBtn');
            uploadBtn.disabled = selectedFiles.length === 0;
        }

        // حذف همه فایل‌ها
        document.getElementById('clearAllFiles').addEventListener('click', function() {
            selectedFiles = [];
            updateFilesList();
            updateUploadButton();
        });

        // آپلود فایل‌ها
        document.getElementById('uploadFilesBtn').addEventListener('click', function() {
            if (selectedFiles.length === 0) return;

            const progressSection = document.getElementById('uploadProgressSection');
            const overallProgressBar = document.getElementById('overallProgressBar');
            const overallProgressText = document.getElementById('overallProgressText');
            const currentFileProgress = document.getElementById('currentFileProgress');

            progressSection.style.display = 'block';
            this.disabled = true;

            let uploadedCount = 0;
            let totalFiles = selectedFiles.length;

            selectedFiles.forEach((file, index) => {
                uploadSingleFile(file, index, (success) => {
                    uploadedCount++;
                    const progress = Math.round((uploadedCount / totalFiles) * 100);
                    overallProgressBar.style.width = `${progress}%`;
                    overallProgressText.textContent = `${progress}%`;

                    if (uploadedCount === totalFiles) {
                        if (uploadedFiles.length > 0) {
                            updateMainForm();
                            // بستن مودال قبل از نمایش پیام موفقیت
                            const modal = bootstrap.Modal.getInstance(document.getElementById('attachmentModal'));
                            modal.hide();

                            // نمایش پیام موفقیت بعد از بسته شدن مودال
                            setTimeout(() => {
                                Swal.fire({
                                    title: 'موفقیت‌آمیز!',
                                    text: `${uploadedFiles.length} فایل با موفقیت آپلود شد.`,
                                    icon: 'success',
                                    confirmButtonText: 'باشه',
                                    customClass: {
                                        popup: 'swal2-popup-custom',
                                        title: 'swal2-title-custom',
                                        content: 'swal2-content-custom'
                                    }
                                });
                            }, 300);
                        } else {
                            // بستن مودال قبل از نمایش پیام خطا
                            const modal = bootstrap.Modal.getInstance(document.getElementById('attachmentModal'));
                            modal.hide();

                            // نمایش پیام خطا بعد از بسته شدن مودال
                            setTimeout(() => {
                                Swal.fire({
                                    title: 'خطا!',
                                    text: 'هیچ فایلی آپلود نشد.',
                                    icon: 'error',
                                    confirmButtonText: 'باشه',
                                    customClass: {
                                        popup: 'swal2-popup-custom',
                                        title: 'swal2-title-custom',
                                        content: 'swal2-content-custom'
                                    }
                                });
                            }, 300);
                        }
                        this.disabled = false;
                    }
                });
            });
        });

        function uploadFiles() {
            if (selectedFiles.length === 0) return;

            const uploadBtn = document.getElementById('uploadBtn');
            uploadBtn.disabled = true;
            uploadBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> در حال آپلود...';

            let processedCount = 0;
            const totalFiles = selectedFiles.length;

            selectedFiles.forEach((file, index) => {
                uploadSingleFile(file, index, () => {
                    processedCount++;
                    if (processedCount === totalFiles) {
                        updateFilesList();
                        updateUploadButton();
                        updateMainForm();

                        // مخفی کردن مودال قبل از نمایش پیام
                        const modal = bootstrap.Modal.getInstance(document.getElementById('attachmentModal'));
                        modal.hide();

                        setTimeout(() => {
                            Swal.fire({
                                title: 'موفقیت!',
                                text: `${uploadedFiles.length} فایل با موفقیت آپلود شد.`,
                                icon: 'success',
                                confirmButtonText: 'باشه',
                                customClass: {
                                    popup: 'swal2-popup-custom',
                                    title: 'swal2-title-custom',
                                    content: 'swal2-content-custom'
                                }
                            });
                        }, 300);
                    }
                });
            });
        }

        function uploadSingleFile(file, index, callback) {
            const formData = new FormData();
            formData.append('file', file);

            const xhr = new XMLHttpRequest();
            xhr.open('POST', '/Letter/UploadFile', true);

            xhr.onload = function() {
                const fileItem = document.querySelectorAll('.file-item')[index];
                const statusSpan = fileItem.querySelector('.file-status');

                if (xhr.status === 200) {
                    const response = JSON.parse(xhr.responseText);
                    if (response.success) {
                        fileItem.classList.add('success');
                        statusSpan.textContent = 'آپلود شد';
                        statusSpan.className = 'file-status success';
                        uploadedFiles.push({
                            id: response.filePath, // استفاده از filePath به عنوان id یکتا
                            name: file.name,
                            path: response.filePath,
                            size: file.size
                        });
                        callback(true);
                    } else {
                        fileItem.classList.add('error');
                        statusSpan.textContent = 'خطا';
                        statusSpan.className = 'file-status error';
                        callback(false);
                    }
                } else {
                    fileItem.classList.add('error');
                    statusSpan.textContent = 'خطا';
                    statusSpan.className = 'file-status error';
                    callback(false);
                }
            };

            xhr.onerror = function() {
                const fileItem = document.querySelectorAll('.file-item')[index];
                const statusSpan = fileItem.querySelector('.file-status');
                fileItem.classList.add('error');
                statusSpan.textContent = 'خطا';
                statusSpan.className = 'file-status error';
                callback(false);
            };

            xhr.send(formData);
        }

        function updateMainForm() {
            const attachmentInput = document.getElementById('attachmentFiles');
            const selectedFilesList = document.getElementById('selectedFilesList');
            const filesContainer = document.getElementById('filesContainer');
            const filesCount = document.getElementById('filesCount');
            const totalSize = document.getElementById('totalSize');
            const fileAddressField = document.getElementById('fileaddress');

            if (uploadedFiles.length > 0) {
                attachmentInput.value = `${uploadedFiles.length} فایل انتخاب شده`;
                selectedFilesList.style.display = 'block';

                filesContainer.innerHTML = '';
                // محاسبه حجم کل فقط برای فایل‌هایی که حجم مشخص دارند
                const totalSizeBytes = uploadedFiles.reduce((sum, file) => sum + (file.size || 0), 0);
                const knownSizeFiles = uploadedFiles.filter(file => file.size && file.size > 0);
                const unknownSizeFiles = uploadedFiles.filter(file => !file.size || file.size === 0);

                filesCount.textContent = uploadedFiles.length;
                if (unknownSizeFiles.length > 0) {
                    totalSize.textContent = `${(totalSizeBytes / (1024 * 1024)).toFixed(2)} (${unknownSizeFiles.length} فایل با حجم نامشخص)`;
                } else {
                    totalSize.textContent = (totalSizeBytes / (1024 * 1024)).toFixed(2);
                }

                uploadedFiles.forEach(file => {
                    const fileIcon = getFileIcon({ name: file.name });
                    const fileItem = document.createElement('div');
                    fileItem.className = 'file-item success';
                    
                    // آیا فایل قبلی است یا جدید آپلود شده
                    const isExistingFile = file.isExisting;
                    const downloadUrl = isExistingFile 
                        ? `/Letter/DownloadAttachment?letterId=@Model.Id&fileName=${encodeURIComponent(file.id)}`
                        : `/Letter/DownloadAttachment?letterId=@Model.Id&fileName=${encodeURIComponent(file.id)}`;
                    
                    fileItem.innerHTML = `
                        <div class="file-info">
                            <div class="file-icon" style="background-color: ${fileIcon.color}">
                                <i class="${fileIcon.icon}"></i>
                            </div>
                            <div class="file-details">
                                <div class="file-name">
                                    <a href="${downloadUrl}" download="${file.name}" style="text-decoration: none; color: inherit;">
                                        <i class="fas fa-paperclip me-1"></i>${file.name}
                                    </a>
                                </div>
                                <div class="file-size">${formatFileSize(file.size || 0)}</div>
                            </div>
                        </div>
                        <div class="file-actions">
                            <span class="file-status success">${isExistingFile ? 'فایل موجود' : 'آپلود شد'}</span>
                            <a href="${downloadUrl}" download="${file.name}" class="btn btn-sm btn-outline-primary me-2" title="دانلود فایل">
                                <i class="fas fa-download"></i> دانلود
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteUploadedFile('${file.id}', '${file.name.replace(/'/g, '\\\'').replace(/"/g, '\\"')}')" title="حذف فایل">
                                <i class="fas fa-trash"></i> حذف
                            </button>
                        </div>
                    `;
                    filesContainer.appendChild(fileItem);
                });

                // فقط اسامی فایل‌ها را با کاما جدا کن (حداکثر 255 کاراکتر)
                const fileNames = uploadedFiles.map(file => file.id).join(',');
                if (fileNames.length > 255) {
                    // اگر بیش از 255 کاراکتر شد، فقط تعداد فایل‌ها را ذخیره کن
                    fileAddressField.value = `${uploadedFiles.length} فایل آپلود شده`;
                } else {
                    fileAddressField.value = fileNames;
                }

                // اطلاعات کامل فایل‌ها را در فیلد مخفی ذخیره کن
                document.getElementById('attachmentsData').value = JSON.stringify(uploadedFiles);
            } else {
                // اگر هیچ فایلی وجود نداشته باشد، نمایش را به حالت اولیه برگردان
                attachmentInput.value = '';
                selectedFilesList.style.display = 'none';
                filesContainer.innerHTML = '';
                filesCount.textContent = '0';
                totalSize.textContent = '0';
                fileAddressField.value = '';
                document.getElementById('attachmentsData').value = '';
            }
        }

        // تابع حذف فایل آپلود شده
        window.deleteUploadedFile = function(fileId, fileName) {
            Swal.fire({
                title: 'حذف فایل',
                text: `آیا مطمئن هستید که می‌خواهید فایل "${fileName}" را حذف کنید؟`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'بله، حذف کن',
                cancelButtonText: 'انصراف',
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6'
            }).then((result) => {
                if (result.isConfirmed) {
                    // حذف فایل از سرور
                    fetch('@Url.Action("DeleteFile", "Letter")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        body: JSON.stringify({
                            fileId: fileId,
                            fileName: fileId // استفاده از fileId که همان uniqueFileName است
                        })
                    })
                    .then(response => {
                        console.log('Delete response status:', response.status);
                        if (!response.ok) {
                            throw new Error(`HTTP error! status: ${response.status}`);
                        }
                        return response.json();
                    })
                    .then(data => {
                        console.log('Delete response data:', data);
                        if (data.success) {
                            // حذف فایل از لیست uploadedFiles
                            uploadedFiles = uploadedFiles.filter(file => file.id !== fileId);

                            // بروزرسانی نمایش
                            updateMainForm();

                            Swal.fire({
                                title: 'حذف شد!',
                                text: 'فایل با موفقیت حذف شد.',
                                icon: 'success',
                                timer: 2000,
                                showConfirmButton: false
                            });
                        } else {
                            Swal.fire({
                                title: 'خطا!',
                                text: data.message || 'خطا در حذف فایل.',
                                icon: 'error',
                                confirmButtonText: 'باشه'
                            });
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        Swal.fire({
                            title: 'خطا!',
                            text: 'خطا در ارتباط با سرور.',
                            icon: 'error',
                            confirmButtonText: 'باشه'
                        });
                    });
                }
            });
        };

        // راه‌اندازی صفحه ویرایش نامه
        document.addEventListener('DOMContentLoaded', function() {
            initializeFileUpload();
            
            // بارگذاری فایل‌های موجود در حالت ویرایش
            @if (!string.IsNullOrEmpty(Model.AttachmentName))
            {
                <text>
                const existingAttachments = '@Html.Raw(Model.AttachmentName)';
                if (existingAttachments && existingAttachments.trim() !== '') {
                    const fileEntries = existingAttachments.split(',');
                    fileEntries.forEach(entry => {
                        if (entry.trim() !== '') {
                            let fileName, uniqueId;
                            if (entry.includes('|')) {
                                const parts = entry.trim().split('|');
                                fileName = parts[0];
                                uniqueId = parts[1] || fileName;
                            } else {
                                fileName = entry.trim();
                                uniqueId = fileName;
                            }
                            uploadedFiles.push({
                                id: uniqueId,
                                name: fileName,
                                path: uniqueId,
                                size: 0,
                                isExisting: true
                            });
                        }
                    });

                    // نمایش فایل‌های موجود در UI
                    setTimeout(() => {
                        updateMainForm();
                    }, 100);
                }
                </text>
            }
        });
    </script>


    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
