@section pagejs {

    <!-- کتابخانه‌های تاریخ و زمان -->
    <!-- Removed moment.js (dev build used eval) - not required here -->
    <script src="~/assets/vendor/libs/jdate/jdate.js"></script>
    <script src="~/assets/vendor/libs/flatpickr/flatpickr-jdate.js"></script>
    <script src="~/assets/vendor/libs/flatpickr/fa-jdate.js"></script>
    <script src="~/assets/vendor/libs/jquery-timepicker/jquery-timepicker.js"></script>

    <!-- کتابخانه‌های دیگر -->
    <!-- Removed swiper.js, pickr.js, bloodhound.js (unused here; dev builds used eval) -->
    <!-- Tagify (local build) -->
    <script src="~/assets/vendor/libs/tagify/tagify.js"></script>
    <!-- Quill (local build) -->
    <script src="~/assets/vendor/libs/quill/quill.js"></script>
    <!-- SweetAlert2 (local minified build) -->
    <script src="~/assets/vendor/libs/sweetalert2/dist/sweetalert2.all.min.js"></script>
    <script src="~/assets/js/forms-selects.js"></script>
    <!-- Removed theme demo initializers that may import eval-using libs: ui-modals.js, tables-datatables-advanced.js -->
    <!-- اسکریپت ابتدایی: Initialize Tagify و مدیریت چک‌باکس‌ها در مودال انتخاب کلاسه نامه -->
    <script>
        // Initialize Tagify only if the element exists
        document.addEventListener('DOMContentLoaded', function () {
                var tagEl = document.getElementById('TagifyBasic');
                if (tagEl && window.Tagify) {
                        try { new Tagify(tagEl); } catch (e) { console.warn('Tagify init error', e); }
                    }
            });
    </script>
    <script>
        $(document).ready(function(){
            // انتخاب کلاسه نامه از مودال
            $(document).on('change', '#FileCodeSelectModal tbody tr input[type="checkbox"]', function(){
                var checkedBoxes = $('#FileCodeSelectModal tbody tr input[type="checkbox"]:checked');
                $('#selectFileCodeBtn').prop('disabled', checkedBoxes.length === 0);
            });

            $('#selectFileCodeBtn').on('click', function(){
                var checkedBoxes = $('#FileCodeSelectModal tbody tr input[type="checkbox"]:checked');
                if (checkedBoxes.length === 0) return;

                var selectedCodes = [];
                var selectedNames = [];
                checkedBoxes.each(function(){
                    var row = $(this).closest('tr');
                    selectedCodes.push(row.data('id'));
                    selectedNames.push(row.data('name'));
                });

                $('#FileCode').val(selectedCodes.join(','));
                $('#FileCodeText').val(selectedNames.join(', ') + ' (' + selectedCodes.join(', ') + ')');
                const el = document.getElementById('FileCodeSelectModal');
                if (window.bootstrap && bootstrap.Modal) {
                    bootstrap.Modal.getOrCreateInstance(el).hide();
                }
            });

            // بارگذاری کلاسه نامه در حالت ویرایش
            const fileCodeValue = '@Model.FileCode';
            const fileCodeInput = document.getElementById('FileCode');
            const fileCodeTextInput = document.getElementById('FileCodeText');
            if (fileCodeInput && fileCodeTextInput && fileCodeValue) {
                fileCodeInput.value = fileCodeValue;
                const modal = document.getElementById('FileCodeSelectModal');
                if (modal) {
                    const checkboxes = modal.querySelectorAll('input[name="selectedFileCode"]');
                    checkboxes.forEach(checkbox => {
                        if (checkbox.value === fileCodeValue) {
                            checkbox.checked = true;
                            const row = checkbox.closest('tr');
                            if (row) {
                                const nameCell = row.cells[2];
                                if (nameCell) {
                                    fileCodeTextInput.value = fileCodeValue + ' - ' + nameCell.textContent;
                                }
                            }
                        }
                    });
                }
            }
        });
    </script>

    <script>
        $(document).ready(function() {
            if ($.fn && $.fn.DataTable) {
                $('#letterSearchResults').DataTable();
            }
        });
    </script>

    <!-- اسکریپت گیرنده اصلی -->
    <script>
        $(document).ready(function() {
            window.receiverOrgData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                (orgs ?? new List<Organization>())
                .Where(o => o.IsMain)
                .Select(main => new {
                    id = main.Id.ToString(),
                    name = main.Name,
                    level = 0,
                    expanded = false,
                    children = (orgs ?? new List<Organization>())
                        .Where(sub => sub.ParentId == main.Id)
                        .Select(sub => new {
                            id = sub.Id.ToString(),
                            name = sub.Name,
                            level = 1,
                            expanded = false,
                            children = (orgs ?? new List<Organization>())
                                .Where(child => child.ParentId == sub.Id)
                                .Select(child => new {
                                    id = child.Id.ToString(),
                                    name = child.Name,
                                    level = 2,
                                    expanded = false,
                                    children = (orgs ?? new List<Organization>())
                                        .Where(leaf => leaf.ParentId == child.Id)
                                        .Select(leaf => new {
                                            id = leaf.Id.ToString(),
                                            name = leaf.Name,
                                            level = 3,
                                            children = new List<object>()
                                        })
                                })
                        })
                })
            ));

            window.buildReceiverTree = function() {
                const container = document.getElementById('receiverTreeContainer');
                if (!container) {
                    console.error('receiverTreeContainer not found!');
                    return;
                }
                container.innerHTML = '';

                if (!window.receiverOrgData || window.receiverOrgData.length === 0) {
                    container.innerHTML = '<div class="text-center text-muted">هیچ سازمانی یافت نشد</div>';
                    return;
                }

                window.receiverOrgData.forEach(org => {
                    renderReceiverNode(org, container, 0);
                });

                // after rendering, if there is an existing receiver, expand parents and mark selected
                const existingReceiver = '@Model.Receiver';
                if (existingReceiver) {
                    // find the radio and check it
                    setTimeout(function() {
                        const radio = container.querySelector(`input[type=radio][value="${existingReceiver}"]`);
                        if (radio) {
                            radio.checked = true;
                            const row = radio.closest('.receiver-node-row');
                            if (row) row.classList.add('selected');
                        }

                        // expand parent containers to make the node visible
                        let current = container.querySelector(`.receiver-tree-node[data-receiver-node-id="${existingReceiver}"]`);
                        while (current) {
                            const parentContainer = current.parentElement.closest('.receiver-tree-node');
                            if (parentContainer) {
                                const expandBtn = parentContainer.querySelector('.receiver-expand-btn');
                                if (expandBtn && !expandBtn.classList.contains('expanded')) {
                                    expandBtn.classList.add('expanded');
                                }
                                const children = parentContainer.querySelector('.receiver-children-container');
                                if (children) children.classList.remove('hidden');
                            }
                            current = current.parentElement.closest('.receiver-tree-node');
                        }
                    }, 50);
                }
            };

            window.renderReceiverNode = function(node, container, level) {
                const nodeDiv = document.createElement('div');
                nodeDiv.className = 'receiver-tree-node';
                nodeDiv.setAttribute('data-receiver-node-id', node.id);
                nodeDiv.setAttribute('data-level', level);

                const hasChildren = node.children && node.children.length > 0;
                const isExpanded = node.expanded === true;

                nodeDiv.innerHTML = `
                    <div class="receiver-node-row" data-receiver-id="${node.id}">
                        <div class="node-content">
                            <div class="node-expand">
                                ${hasChildren ?
                                  `<button type="button" class="receiver-expand-btn ${isExpanded ? 'expanded' : ''}"
                                             data-receiver-id="${node.id}">
                                        <i class="fas fa-chevron-left"></i>
                                     </button>` :
                                  '<span class="expand-placeholder"></span>'
                                }
                            </div>
                            <div class="node-toggle">
                                <input type="radio" name="receiverSelection" class="receiver-node-radio" value="${node.id}">
                            </div>
                            <div class="node-name">${node.name}</div>
                        </div>
                    </div>
                `;

                container.appendChild(nodeDiv);

                if (hasChildren && isExpanded) {
                    const childrenContainer = document.createElement('div');
                    childrenContainer.className = 'receiver-children-container';
                    childrenContainer.setAttribute('data-receiver-parent-id', node.id);
                    node.children.forEach(child => {
                        renderReceiverNode(child, childrenContainer, level + 1);
                    });
                    nodeDiv.appendChild(childrenContainer);
                }
            };

            window.toggleReceiverExpand = function(nodeId) {
                const parentNode = document.querySelector(`.receiver-tree-node[data-receiver-node-id="${nodeId}"]`);
                const expandBtn = parentNode.querySelector(`.receiver-expand-btn[data-receiver-id="${nodeId}"]`);
                let childrenContainer = parentNode.querySelector(`.receiver-children-container[data-receiver-parent-id="${nodeId}"]`);
                const node = findReceiverNodeById(nodeId);

                if (childrenContainer) {
                    if (childrenContainer.classList.contains('hidden')) {
                        childrenContainer.classList.remove('hidden');
                        expandBtn.classList.add('expanded');
                        node.expanded = true;
                    } else {
                        childrenContainer.classList.add('hidden');
                        expandBtn.classList.remove('expanded');
                        node.expanded = false;
                    }
                } else if (node.children && node.children.length > 0) {
                    childrenContainer = document.createElement('div');
                    childrenContainer.className = 'receiver-children-container';
                    childrenContainer.setAttribute('data-receiver-parent-id', nodeId);
                    node.children.forEach(child => {
                        renderReceiverNode(child, childrenContainer, parseInt(parentNode.getAttribute('data-level')) + 1);
                    });
                    parentNode.appendChild(childrenContainer);
                    expandBtn.classList.add('expanded');
                    node.expanded = true;
                }
            };

            window.findReceiverNodeById = function(nodeId, nodes = window.receiverOrgData) {
                for (let node of nodes) {
                    if (node.id == nodeId) return node;
                    if (node.children) {
                        const found = findReceiverNodeById(nodeId, node.children);
                        if (found) return found;
                    }
                }
                return null;
            };

            window.selectReceiver = function(nodeId, nodeName) {
                $('.receiver-node-radio').prop('checked', false);
                $(`.receiver-node-radio[value="${nodeId}"]`).prop('checked', true);
                $('#Receiver').val(nodeId);
                // ensure other listeners and form pick up the change
                $('#Receiver').trigger('change');
                console.log('Receiver selected:', nodeId);
                const fullName = getReceiverFullOrganizationName(nodeId);
                $('#ReceiverText').val(fullName);
                $('.receiver-node-row').removeClass('selected');
                $(`.receiver-node-radio[value="${nodeId}"]`).closest('.receiver-node-row').addClass('selected');
                const el = document.getElementById('ReceiverSelectModal');
                if (window.bootstrap && bootstrap.Modal) {
                    bootstrap.Modal.getOrCreateInstance(el).hide();
                }
            };

            window.getReceiverFullOrganizationName = function(nodeId) {
                const node = findReceiverNodeById(nodeId);
                if (!node) return '';
                const path = [];
                let currentNode = node;
                while (currentNode) {
                    path.unshift(currentNode.name);
                    if (currentNode.level > 0) {
                        currentNode = findReceiverParentNode(currentNode.id);
                    } else {
                        currentNode = null;
                    }
                }
                return path.join('-');
            };

            window.findReceiverParentNode = function(nodeId) {
                for (let org of window.receiverOrgData) {
                    if (org.children) {
                        const found = findReceiverParentInChildren(org, nodeId);
                        if (found) return found;
                    }
                }
                return null;
            };

            window.findReceiverParentInChildren = function(parent, targetId) {
                if (parent.children) {
                    for (let child of parent.children) {
                        if (child.id === targetId) return parent;
                        const found = findReceiverParentInChildren(child, targetId);
                        if (found) return found;
                    }
                }
                return null;
            };

            $("#receiverTreeSearch").on("keyup", function() {
                const searchTerm = $(this).val().toLowerCase();
                if (searchTerm === '') {
                    $('.receiver-tree-node').show();
                    $('.receiver-children-container').show();
                    return;
                }
                $('.receiver-tree-node').hide();
                $('.receiver-children-container').hide();
                $('.receiver-node-row').each(function() {
                    const nodeName = $(this).find('.node-name').text().toLowerCase();
                    if (nodeName.includes(searchTerm)) {
                        $(this).closest('.receiver-tree-node').show();
                        $(this).closest('.receiver-tree-node').parents('.receiver-children-container').show();
                        $(this).closest('.receiver-tree-node').parents('.receiver-tree-node').show();
                        $(this).closest('.receiver-tree-node').find('.receiver-children-container').show();
                        $(this).closest('.receiver-tree-node').find('.receiver-tree-node').show();
                    }
                });
            });

            $("#confirmReceiverSelection").click(function() {
                const selectedRadio = $('.receiver-node-radio:checked');
                if (selectedRadio.length > 0) {
                    const nodeId = selectedRadio.val();
                    const nodeName = selectedRadio.closest('.receiver-node-row').find('.node-name').text();
                    selectReceiver(nodeId, nodeName);
                } else {
                    Swal.fire({
                        title: 'خطا!',
                        text: 'لطفاً یک سازمان انتخاب کنید.',
                        icon: 'warning',
                        confirmButtonText: 'باشه'
                    });
                }
            });

            $(document).on('click', '.receiver-expand-btn', function() {
                const nodeId = $(this).data('receiver-id');
                if (nodeId) toggleReceiverExpand(nodeId);
            });

            $(document).on('change', '.receiver-node-radio', function() {
                const nodeId = $(this).val();
                const nodeName = $(this).closest('.receiver-node-row').find('.node-name').text();
                selectReceiver(nodeId, nodeName);
            });

            $('#ReceiverSelectModal').on('shown.bs.modal', function () {
                window.buildReceiverTree();
                setTimeout(() => {
                    const receiverValue = '@Model.Receiver';
                    if (receiverValue) {
                        // یافتن گره در درخت و باز کردن والدین آن
                        const node = findReceiverNodeById(receiverValue);
                        if (node) {
                            let currentNode = findReceiverParentNode(node.id);
                            while (currentNode) {
                                toggleReceiverExpand(currentNode.id);
                                currentNode = findReceiverParentNode(currentNode.id);
                            }
                        }
                        // انتخاب گره
                        const receiverRadio = document.querySelector(`input[type="radio"][value="${receiverValue}"]`);
                        if (receiverRadio) {
                            receiverRadio.checked = true;
                            const nodeRow = receiverRadio.closest('.receiver-node-row');
                            if (nodeRow) nodeRow.classList.add('selected');
                        }
                    }
                }, 200);
            });

            function loadExistingReceiver() {
                const receiverValue = '@Model.Receiver';
                if (receiverValue) {
                    const fullName = window.getReceiverFullOrganizationName(receiverValue);
                    if (fullName && fullName.trim() !== '') {
                        $('#ReceiverText').val(fullName);
                    } else {
                        const serverPath = '@receiverFullPath';
                        if (serverPath && serverPath.trim() !== '') $('#ReceiverText').val(serverPath);
                    }
                    $('#Receiver').val(receiverValue);
                }
            }

            window.buildReceiverTree();
        });
    </script>

    <!-- اسکریپت سایر گیرندگان -->
    <script>
        $(document).ready(function() {
            window.copyOrgData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                (orgs ?? new List<Organization>())
                .Where(o => o.IsMain)
                .Select(main => new {
                    id = main.Id.ToString(),
                    name = main.Name,
                    level = 0,
                    expanded = false,
                    children = (orgs ?? new List<Organization>())
                        .Where(sub => sub.ParentId == main.Id)
                        .Select(sub => new {
                            id = sub.Id.ToString(),
                            name = sub.Name,
                            level = 1,
                            expanded = false,
                            children = (orgs ?? new List<Organization>())
                                .Where(child => child.ParentId == sub.Id)
                                .Select(child => new {
                                    id = child.Id.ToString(),
                                    name = child.Name,
                                    level = 2,
                                    expanded = false,
                                    children = (orgs ?? new List<Organization>())
                                        .Where(leaf => leaf.ParentId == child.Id)
                                        .Select(leaf => new {
                                            id = leaf.Id.ToString(),
                                            name = leaf.Name,
                                            level = 3,
                                            children = new List<object>()
                                        })
                                })
                        })
                })
            ));

            window.buildCopyTree = function(excludedId) {
                const container = document.getElementById('treeContainer');
                if (!container) {
                    console.error('treeContainer not found!');
                    return;
                }
                container.innerHTML = '';

                if (!window.copyOrgData || window.copyOrgData.length === 0) {
                    container.innerHTML = '<div class="text-center text-muted">هیچ سازمانی یافت نشد</div>';
                    return;
                }

                window.copyOrgData.forEach(function(org) {
                    window.renderCopyNode(org, container, 0, excludedId);
                });
            };

            window.renderCopyNode = function(node, container, level, excludedId) {
                const nodeDiv = document.createElement('div');
                nodeDiv.className = 'copy-tree-node';
                nodeDiv.setAttribute('data-copy-node-id', node.id);
                nodeDiv.setAttribute('data-level', level);

                const isSelected = node.selected || false;
                const hasChildren = node.children && node.children.length > 0;
                const isExpanded = node.expanded === true;
                const isExcluded = excludedId && String(node.id) === String(excludedId);

                nodeDiv.innerHTML = `
                    <div class="copy-node-row ${isSelected ? 'selected' : ''} ${isExcluded ? 'disabled' : ''}" data-copy-id="${node.id}">
                        <div class="node-content">
                            <div class="node-expand">
                                ${hasChildren ?
                                  `<button type="button" class="copy-expand-btn ${isExpanded ? 'expanded' : ''}"
                                             data-copy-id="${node.id}">
                                        <i class="fas fa-chevron-left"></i>
                                     </button>` :
                                  '<span class="expand-placeholder"></span>'
                                }
                            </div>
                            <div class="node-toggle">
                                <input type="checkbox" class="copy-node-checkbox" id="copy-node-${node.id}"
                                       data-copy-id="${node.id}" ${isSelected ? 'checked' : ''} ${isExcluded ? 'disabled title="گیرنده اصلی (غیرقابل انتخاب)"' : ''}>
                            </div>
                            <div class="node-name">${node.name}</div>
                            <div class="node-message">
                                <input type="text" class="copy-message-input" id="message-${node.id}"
                                       data-copy-id="${node.id}" placeholder="پیام اختصاصی برای ${node.name}"
                                       maxlength="200" style="display: ${isSelected ? 'block' : 'none'}" ${isExcluded ? 'disabled' : ''}>
                            </div>
                            <div class="copy-node-counter" data-copy-id="${node.id}"
                                 style="display: ${isSelected ? 'block' : 'none'}">0/200</div>
                        </div>
                    </div>
                `;

                container.appendChild(nodeDiv);
                if (hasChildren && isExpanded) {
                    const childrenContainer = document.createElement('div');
                    childrenContainer.className = 'copy-children-container';
                    childrenContainer.setAttribute('data-copy-parent-id', node.id);
                    node.children.forEach(child => {
                        window.renderCopyNode(child, childrenContainer, level + 1, excludedId);
                    });
                    nodeDiv.appendChild(childrenContainer);
                }
            };

            window.findCopyNodeById = function(nodeId, nodes = window.copyOrgData) {
                for (let node of nodes) {
                    if (String(node.id) === String(nodeId)) return node;
                    if (node.children) {
                        const found = window.findCopyNodeById(nodeId, node.children);
                        if (found) return found;
                    }
                }
                return null;
            };

            window.toggleCopyExpand = function(nodeId, sourceBtn) {
                const parentNode = sourceBtn ? sourceBtn.closest(`.copy-tree-node[data-copy-node-id="${nodeId}"]`) : document.querySelector(`.copy-tree-node[data-copy-node-id="${nodeId}"]`);
                if (!parentNode) {
                    console.warn('Parent element not found for nodeId:', nodeId);
                    return;
                }
                const expandBtn = sourceBtn || parentNode.querySelector(`.copy-expand-btn[data-copy-id="${nodeId}"]`);
                let childrenContainer = parentNode.querySelector(`.copy-children-container[data-copy-parent-id="${nodeId}"]`);
                const node = window.findCopyNodeById(nodeId);

                if (!node) {
                    console.warn('Node data not found for nodeId:', nodeId);
                    return;
                }

                if (childrenContainer) {
                    if (childrenContainer.classList.contains('hidden')) {
                        childrenContainer.classList.remove('hidden');
                        if (expandBtn) expandBtn.classList.add('expanded');
                        node.expanded = true;
                    } else {
                        childrenContainer.classList.add('hidden');
                        if (expandBtn) expandBtn.classList.remove('expanded');
                        node.expanded = false;
                    }
                } else if (node.children && node.children.length > 0) {
                    childrenContainer = document.createElement('div');
                    childrenContainer.className = 'copy-children-container';
                    childrenContainer.setAttribute('data-copy-parent-id', nodeId);
                    const currentLevel = parseInt(parentNode.getAttribute('data-level')) || 0;
                    node.children.forEach(child => {
                        window.renderCopyNode(child, childrenContainer, currentLevel + 1);
                    });
                    parentNode.appendChild(childrenContainer);
                    if (expandBtn) expandBtn.classList.add('expanded');
                    node.expanded = true;
                }
            };

            document.getElementById("confirmSelection").addEventListener('click', function() {
                const selectedOrgs = [];
                const checkedBoxes = document.querySelectorAll('.copy-node-checkbox:checked');
                checkedBoxes.forEach(checkbox => {
                    const nodeId = String(checkbox.getAttribute('data-copy-id'));
                    const nodeRow = checkbox.closest('.copy-node-row');
                    const nodeName = nodeRow.querySelector('.node-name').textContent;
                    const messageInput = nodeRow.querySelector('.copy-message-input');
                    const note = (messageInput && messageInput.style.display !== 'none') ? (messageInput.value || "") : "";
                    selectedOrgs.push({ id: nodeId, name: nodeName, note });
                });
                const idsOnly = selectedOrgs.map(o => o.id);
                document.getElementById("selectedOrganizations").value = idsOnly.join(",");
                document.getElementById("selectedOrganizationsNotes").value = JSON.stringify(selectedOrgs);
                const el = document.getElementById("Copyreciversmodal");
                if (window.bootstrap && bootstrap.Modal) {
                    bootstrap.Modal.getOrCreateInstance(el).hide();
                }
            });

            document.addEventListener('click', function(e) {
                const button = e.target.closest('.copy-expand-btn');
                if (button) {
                    e.preventDefault();
                    e.stopPropagation();
                    const nodeId = button.getAttribute('data-copy-id');
                    if (nodeId) window.toggleCopyExpand(nodeId, button);
                }

                if (e.target.classList.contains('copy-node-checkbox')) {
                    if (e.target.disabled) {
                        // اجازهٔ تغییر وضعیت برای گیرندهٔ اصلی داده نشود
                        e.preventDefault();
                        e.stopPropagation();
                        return;
                    }
                    const checkbox = e.target;
                    const nodeId = checkbox.getAttribute('data-copy-id');
                    const nodeRow = checkbox.closest('.copy-node-row');
                    const messageInput = nodeRow.querySelector('.copy-message-input');
                    const counter = nodeRow.querySelector('.copy-node-counter');

                    if (checkbox.checked) {
                        nodeRow.classList.add('selected');
                        messageInput.style.display = 'block';
                        counter.style.display = 'block';
                        updateCopyCounter(nodeId);
                    } else {
                        nodeRow.classList.remove('selected');
                        messageInput.style.display = 'none';
                        counter.style.display = 'none';
                        messageInput.value = '';
                    }
                }
            });

            document.addEventListener('input', function(e) {
                if (e.target.classList.contains('copy-message-input')) {
                    const nodeId = e.target.getAttribute('data-copy-id');
                    updateCopyCounter(nodeId);
                }
            });

            window.updateCopyCounter = function(nodeId) {
                const input = document.querySelector(`.copy-message-input[data-copy-id="${nodeId}"]`);
                const counter = document.querySelector(`.copy-node-counter[data-copy-id="${nodeId}"]`);
                if (input && counter) {
                    const length = input.value.length;
                    counter.textContent = length + '/200';
                    counter.className = 'copy-node-counter';
                    if (length > 180) counter.classList.add('text-warning');
                    if (length > 195) counter.classList.add('text-danger');
                }
            };

            $("#treeSearch").on("keyup", function() {
                const searchTerm = $(this).val().toLowerCase();
                if (searchTerm === '') {
                    $('.copy-tree-node').show();
                    $('.copy-children-container').show();
                    return;
                }
                $('.copy-tree-node').hide();
                $('.copy-children-container').hide();
                $('.copy-node-row').each(function() {
                    const nodeName = $(this).find('.node-name').text().toLowerCase();
                    if (nodeName.includes(searchTerm)) {
                        $(this).closest('.copy-tree-node').show();
                        $(this).closest('.copy-tree-node').parents('.copy-children-container').show();
                        $(this).closest('.copy-tree-node').parents('.copy-tree-node').show();
                        $(this).closest('.copy-tree-node').find('.copy-children-container').show();
                        $(this).closest('.copy-tree-node').find('.copy-tree-node').show();
                    }
                });
            });

            $('#Copyreciversmodal').on('shown.bs.modal', function () {
                const selectedReceiver = document.getElementById('Receiver').value;
                window.buildCopyTree(selectedReceiver);
                // کمی صبر می‌کنیم تا DOM ساخته شود، سپس پیش‌انتخاب را اعمال می‌کنیم
                // اطمینان از اینکه تنها یکبار اجرا شود
                if (!window.copyReceiversLoaded) {
                    window.copyReceiversLoaded = true;
                    setTimeout(() => {
                        loadExistingCopyReceivers();
                        window.copyReceiversLoaded = false; // reset برای بار بعد
                    }, 300);
                }
            });

            function loadExistingCopyReceivers() {
                // اول از مقادیر موجود در hidden inputs استفاده کن (اگر کاربر قبلاً تغییری داده باشد)
                const hiddenIdsEl = document.getElementById('selectedOrganizations');
                const hiddenNotesEl = document.getElementById('selectedOrganizationsNotes');
                let selectedOrgs = (hiddenIdsEl && hiddenIdsEl.value && hiddenIdsEl.value.trim())
                    ? hiddenIdsEl.value.trim()
                    : '@(Model.CopyReceivers != null && Model.CopyReceivers.Count > 0 ? Model.CopyReceivers[0] : "")';
                let copyReceiversNotes = (hiddenNotesEl && hiddenNotesEl.value && hiddenNotesEl.value.trim())
                    ? hiddenNotesEl.value.trim()
                    : '@Html.Raw(Model.CopyReceivers != null && Model.CopyReceivers.Count > 1 ? (Model.CopyReceivers[1] ?? "[]") : "[]")';
                
                console.log('Loading existing copy receivers:', selectedOrgs);
                console.log('Copy receivers notes:', copyReceiversNotes);
                
                if (selectedOrgs && selectedOrgs.trim()) {
                    const orgIds = selectedOrgs.split(',');
                    // حذف duplicates و ایجاد array یکتا
                    const uniqueOrgIds = [...new Set(orgIds.map(id => id.trim()).filter(id => id))];
                    
                    console.log('Unique org IDs:', uniqueOrgIds);
                    
                    let notesData = {};
                    if (copyReceiversNotes && copyReceiversNotes !== '[]') {
                        try {
                            const parsedNotes = JSON.parse(copyReceiversNotes);
                            // پشتیبانی از هر دو کلید message و note
                            notesData = parsedNotes.reduce((acc, item) => {
                                const key = String(item.id);
                                const val = (typeof item.message !== 'undefined') ? item.message : (item.note || '');
                                acc[key] = val;
                                return acc;
                            }, {});
                        } catch (e) {
                            console.log('Error parsing notes JSON:', e);
                        }
                    }
                    
                    console.log('Notes data:', notesData);
                    
                    // ابتدا تمام node ها را expand کنیم تا قابل دسترسی باشند
                    expandAllCopyNodes();
                    
                    // کمی صبر کنیم تا expansion کامل شود
                    setTimeout(() => {
                        uniqueOrgIds.forEach((orgId) => {
                            console.log('Processing org ID:', orgId);
                            
                            // تمام checkboxهای با این ID را پیدا کنیم (ممکن است چندتا باشد)
                            const checkboxes = document.querySelectorAll(`input[type="checkbox"][data-copy-id="${orgId}"]`);
                            
                            console.log(`Found ${checkboxes.length} checkboxes for org ID ${orgId}`);
                            
                            if (checkboxes.length === 0) {
                                console.warn(`No checkbox found for org ID: ${orgId}`);
                                // اگر checkbox پیدا نشد، شاید node collapsed باشد، سعی کنیم آن را پیدا کنیم
                                const node = window.findCopyNodeById(orgId);
                                if (node) {
                                    console.log(`Found node data for ID ${orgId}, trying to expand parent`);
                                    // پیدا کردن parent node و expand کردن آن
                                    expandParentNodes(orgId);
                                }
                            }
                            
                            checkboxes.forEach((checkbox, index) => {
                                console.log(`Setting checkbox ${index + 1} for org ID ${orgId}`);
                                
                                checkbox.checked = true;
                                const nodeRow = checkbox.closest('.copy-node-row');
                                
                                if (nodeRow) {
                                    nodeRow.classList.add('selected');
                                    const messageInput = nodeRow.querySelector('.copy-message-input');
                                    const counter = nodeRow.querySelector('.copy-node-counter');
                                    
                                    if (messageInput) {
                                        messageInput.style.display = 'block';
                                        const key = String(orgId);
                                        if (Object.prototype.hasOwnProperty.call(notesData, key)) {
                                            messageInput.value = notesData[key];
                                        } else {
                                            messageInput.value = '';
                                        }
                                    }
                                    
                                    if (counter) {
                                        counter.style.display = 'block';
                                        // use the actual checkbox data-copy-id (may be string)
                                        const cbId = checkbox.getAttribute('data-copy-id') || orgId;
                                        updateCopyCounter(cbId);
                                    }
                                }
                            });
                        });
                        
                        // تنظیم مقادیر hidden inputs (از آرایه یکتا استفاده می‌کنیم)
                        document.getElementById('selectedOrganizations').value = uniqueOrgIds.join(',');
                        // نرمال‌سازی ساختار notes برای سازگاری
                        try {
                            const parsedNotes = JSON.parse(copyReceiversNotes || '[]');
                            const normalized = parsedNotes.map(n => ({ id: String(n.id), note: (typeof n.message !== 'undefined') ? n.message : (n.note || '') }));
                            document.getElementById('selectedOrganizationsNotes').value = JSON.stringify(normalized);
                        } catch (e) {
                            document.getElementById('selectedOrganizationsNotes').value = copyReceiversNotes;
                        }
                        
                        console.log('Finished loading existing copy receivers');
                        
                        // اگر هنوز برخی checkboxها پیدا نشدند، دوباره سعی کنیم
                        setTimeout(() => {
                            retryMissingCheckboxes(uniqueOrgIds, notesData);
                        }, 500);
                    }, 300);
                }
            }
            
            // تابع برای تلاش مجدد برای checkboxهای گم شده
            function retryMissingCheckboxes(orgIds, notesData) {
                console.log('Retrying missing checkboxes...');
                orgIds.forEach((orgId) => {
                    const checkboxes = document.querySelectorAll(`input[type="checkbox"][data-copy-id="${orgId}"]`);
                    if (checkboxes && checkboxes.length > 0) {
                        checkboxes.forEach((checkbox) => {
                            if (!checkbox.checked) {
                                console.log(`Retrying checkbox for org ID: ${orgId}`);
                                checkbox.checked = true;
                                const nodeRow = checkbox.closest('.copy-node-row');
                                if (nodeRow) {
                                    nodeRow.classList.add('selected');
                                    const messageInput = nodeRow.querySelector('.copy-message-input');
                                    const counter = nodeRow.querySelector('.copy-node-counter');
                                    if (messageInput) {
                                        messageInput.style.display = 'block';
                                        const key = String(orgId);
                                        if (Object.prototype.hasOwnProperty.call(notesData, key)) {
                                            messageInput.value = notesData[key];
                                        } else {
                                            messageInput.value = '';
                                        }
                                    }
                                    if (counter) {
                                        counter.style.display = 'block';
                                        updateCopyCounter(nodeRow.querySelector('.copy-message-input').getAttribute('data-copy-id'));
                                    }
                                }
                            }
                        });
                    } else {
                        console.warn(`Still no checkbox found for org ID: ${orgId} during retry`);
                    }
                });
            }
            
            // تابع برای expand کردن تمام nodeها
            function expandAllCopyNodes() {
                console.log('Expanding all copy nodes...');
                
                function expandNodeRecursively(node) {
                    if (node.children && node.children.length > 0) {
                        node.expanded = true;
                        const nodeElement = document.querySelector(`.copy-tree-node[data-copy-node-id="${node.id}"]`);
                        if (nodeElement) {
                            const expandBtn = nodeElement.querySelector(`.copy-expand-btn[data-copy-id="${node.id}"]`);
                            if (expandBtn && !expandBtn.classList.contains('expanded')) {
                                window.toggleCopyExpand(node.id, expandBtn);
                            }
                        }
                        
                        // expand کردن فرزندان
                        node.children.forEach(child => {
                            expandNodeRecursively(child);
                        });
                    }
                }
                
                if (window.copyOrgData) {
                    window.copyOrgData.forEach(rootNode => {
                        expandNodeRecursively(rootNode);
                    });
                }
            }
            
            // تابع برای expand کردن parent nodeهای یک node خاص
            function expandParentNodes(targetNodeId) {
                function findAndExpandParent(nodes, targetId, parentNode = null) {
                    for (let node of nodes) {
                        if (String(node.id) === String(targetId)) {
                            // پیدا شد، اگر parent داشت آن را expand کن
                            if (parentNode && parentNode.children && parentNode.children.length > 0) {
                                const parentElement = document.querySelector(`.copy-tree-node[data-copy-node-id="${parentNode.id}"]`);
                                if (parentElement) {
                                    const expandBtn = parentElement.querySelector(`.copy-expand-btn[data-copy-id="${parentNode.id}"]`);
                                    if (expandBtn && !expandBtn.classList.contains('expanded')) {
                                        window.toggleCopyExpand(parentNode.id, expandBtn);
                                    }
                                }
                            }
                            return true;
                        }
                        
                        if (node.children && node.children.length > 0) {
                            if (findAndExpandParent(node.children, targetId, node)) {
                                return true;
                            }
                        }
                    }
                    return false;
                }
                
                if (window.copyOrgData) {
                    findAndExpandParent(window.copyOrgData, targetNodeId);
                }
            }

            window.buildCopyTree($("#Receiver").val() || '');
        });
    </script>

