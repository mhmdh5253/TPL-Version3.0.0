                // ایجاد لیست انتخاب کلاسه
                let optionsHtml = classifications.map(c =>
                    `<option value="${c.CodeKelaseh}">${c.CodeKelaseh} - ${c.NameKelaseh}</option>`
                ).join('');

                const { value: formValues, isConfirmed } = await Swal.fire({
                    title: 'بایگانی نامه',
                    html: `
                <div style="text-align: right;">
                    <label for="classification" style="display: block; margin-bottom: 8px;">کلاسه بایگانی:</label>
                    <select id="classification" class="swal2-select select2" style="width: -webkit-fill-available;">
                        ${optionsHtml}
                    </select>
                    <textarea id="archiveDesc" class="swal2-textarea" placeholder="توضیحات (اختیاری)" style="margin-top: 10px;width: -webkit-fill-available;"></textarea>
                </div>
            `,
                    confirmButtonText: 'تایید بایگانی',
                    cancelButtonText: 'انصراف',
                    showCancelButton: true,
                    preConfirm: () => {
                        const code = document.getElementById('classification').value;
                        const desc = document.getElementById('archiveDesc').value;
                        return {
                            LetterId: letterId,
                            ClassificationCode: parseInt(code),
                            Description: desc
                        };
                    }
                });

                if (!isConfirmed) return;

                // ارسال درخواست بایگانی
                const result = await sendRequestWithCredentials(
                    '@Url.Action("ArchiveLetter", "LetterApprovalFlow")',
                    'POST',
                    formValues
                );

                if (result.Success) {
                    await Swal.fire({
                        title: 'موفقیت',
                        text: result.Message,
                        icon: 'success'
                    });
                    location.reload();
                } else {
                    throw new Error(result.Message);
                }
            } catch (error) {
                Swal.fire({
                    title: 'خطا',
                    text: error.message,
                    icon: 'error'
                });
            }
        }

// تابع بایگانی سریع
        async function quickArchive(letterId) {
            try {
                const confirmResult = await Swal.fire({
                    title: 'بایگانی سریع',
                    text: 'آیا مطمئن هستید می‌خواهید این نامه را بایگانی کنید؟',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'بله، بایگانی شود',
                    cancelButtonText: 'انصراف'
                });

                if (!confirmResult.isConfirmed) return;

                const result = await sendRequestWithCredentials(
                    '@Url.Action("QuickArchive", "LetterApprovalFlow")',
                    'POST',
                    letterId
                );

                if (result.Success) {
                    await Swal.fire({
                        title: 'موفقیت',
                        text: result.Message,
                        icon: 'success'
                    });
                    location.reload();
                } else {
                    throw new Error(result.Message);
                }
            } catch (error) {
                Swal.fire({
                    title: 'خطا',
                    text: error.message,
                    icon: 'error'
                });
            }
        }

        // تابع نمایش مودال پیوست‌ها
        async function showAttachmentsModal(letterId) {
            try {
                // نمایش لودر
                const loadingSwal = Swal.fire({
                    title: 'در حال دریافت پیوست‌ها',
                    html: 'لطفاً منتظر بمانید...',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading()
                });

                // ارسال درخواست برای دریافت پیوست‌ها
                const response = await fetch(`@Url.Content("~/Letter/Attachment/List")?letterId=${letterId}`);
                const result = await response.json();

                loadingSwal.close();

                if (result.success && result.data) {
                    displayAttachmentsModal(result.data, letterId);
                } else {
                    // نمایش پیام خالی بودن
                    displayEmptyAttachmentsModal();
                }
            } catch (error) {
                console.error('Error loading attachments:', error);
                Swal.fire({
                    title: 'خطا',
                    text: 'خطا در دریافت پیوست‌ها',
                    icon: 'error',
                    confirmButtonText: 'متوجه شدم'
                });
            }
        }

        // تابع نمایش مودال پیوست‌ها
    function displayAttachmentsModal(attachments, letterId) {
            let attachmentsHtml = `
                <div class="attachments-container">
                    <div class="attachments-header">
                        <div class="attachments-title">
                            <i class="fas fa-paperclip"></i>
                            <span>پیوست‌های نامه</span>
                        </div>
                        <div class="attachments-count">
                            ${attachments.length} فایل
                        </div>
                    </div>
                    <div class="attachments-body">
                        <div class="attachments-list">
            `;

            attachments.forEach(attachment => {
                const isImage = isImageFile(attachment.fileName);
                const fileSize = formatFileSize(attachment.fileSize);
                const fileIcon = getFileIcon(attachment.fileName);

                if (isImage) {
                    attachmentsHtml += `
                        <div class="attachment-item" onclick="viewImage('${attachment.filePath}', '${attachment.fileName}')">
                            <img src="${attachment.filePath}" alt="${attachment.fileName}" class="attachment-thumbnail" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                            <div class="attachment-icon" style="display: none;">
                                <i class="${fileIcon}"></i>
                            </div>
                            <div class="attachment-info">
                                <div class="attachment-name">${attachment.fileName}</div>
                                <div class="attachment-size">${fileSize}</div>
                                <div class="attachment-actions">
                                    <button class="attachment-view-btn" onclick="event.stopPropagation(); viewImage('${attachment.filePath}', '${attachment.fileName}')">
                                        <i class="fas fa-eye"></i> مشاهده
                                    </button>
                                    <button class="attachment-download-btn" onclick="event.stopPropagation(); downloadFile(${letterId}, '${attachment.fileId}', '${attachment.fileName}')">
                                        <i class="fas fa-download"></i> دانلود
                                    </button>
                                </div>
                            </div>
                        </div>
                    `;
                } else {
                    attachmentsHtml += `
                        <div class="attachment-item">
                            <div class="attachment-icon">
                                <i class="${fileIcon}"></i>
                            </div>
                            <div class="attachment-info">
                                <div class="attachment-name">${attachment.fileName}</div>
                                <div class="attachment-size">${fileSize}</div>
                                <div class="attachment-actions">
                                    <button class="attachment-download-btn" onclick="downloadFile(${letterId}, '${attachment.fileId}', '${attachment.fileName}')">
                                        <i class="fas fa-download"></i> دانلود
                                    </button>
                                </div>
                            </div>
                        </div>
                    `;
                }
            });

            attachmentsHtml += `
                        </div>
                    </div>
                </div>
            `;

            Swal.fire({
                html: attachmentsHtml,
                width: '800px',
                showConfirmButton: false,
                showCloseButton: true,
                customClass: {
                    popup: 'attachments-modal'
                }
            });
        }

        // تابع نمایش مودال خالی
        function displayEmptyAttachmentsModal() {
            const emptyHtml = `
                <div class="attachments-container">
                    <div class="attachments-header">
                        <div class="attachments-title">
                            <i class="fas fa-paperclip"></i>
                            <span>پیوست‌های نامه</span>
                        </div>
                        <div class="attachments-count">0 فایل</div>
                    </div>
                    <div class="attachments-body">
                        <div class="empty-attachments">
                            <i class="fas fa-file-upload"></i>
                            <p>هیچ پیوستی برای این نامه وجود ندارد</p>
                        </div>
                    </div>
                </div>
            `;

            Swal.fire({
                html: emptyHtml,
                width: '500px',
                showConfirmButton: false,
                showCloseButton: true,
                customClass: {
                    popup: 'attachments-modal'
                }
            });
        }

        // تابع تشخیص نوع فایل تصویری
        function isImageFile(fileName) {
            const imageExtensions = ['.jpg', '.jpeg', '.png', '.gif', '.bmp', '.webp', '.svg'];
            const extension = fileName.toLowerCase().substring(fileName.lastIndexOf('.'));
            return imageExtensions.includes(extension);
        }

        // تابع دریافت آیکون فایل
        function getFileIcon(fileName) {
            const extension = fileName.toLowerCase().substring(fileName.lastIndexOf('.'));
            const iconMap = {
                '.pdf': 'fas fa-file-pdf',
                '.doc': 'fas fa-file-word',
                '.docx': 'fas fa-file-word',
                '.xls': 'fas fa-file-excel',
                '.xlsx': 'fas fa-file-excel',
                '.ppt': 'fas fa-file-powerpoint',
                '.pptx': 'fas fa-file-powerpoint',
                '.txt': 'fas fa-file-alt',
                '.zip': 'fas fa-file-archive',
                '.rar': 'fas fa-file-archive',
                '.7z': 'fas fa-file-archive',
                '.mp4': 'fas fa-file-video',
                '.avi': 'fas fa-file-video',
                '.mov': 'fas fa-file-video',
                '.mp3': 'fas fa-file-audio',
                '.wav': 'fas fa-file-audio'
            };
            return iconMap[extension] || 'fas fa-file';
        }

        // تابع فرمت کردن اندازه فایل
        function formatFileSize(bytes) {
            if (bytes === 0) return '0 بایت';
            const k = 1024;
            const sizes = ['بایت', 'کیلوبایت', 'مگابایت', 'گیگابایت'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        }

        // تابع مشاهده تصویر
    function viewImage(imagePath, fileName) {
            const imageHtml = `
                <div class="image-preview-container">
                    <img src="${imagePath}" alt="${fileName}" class="image-preview">
                    <div class="image-preview-actions">
                        <button class="image-download-btn" onclick="downloadFile(@Model.Id, getFileIdFromPath('${imagePath}'), '${fileName}')">
                            <i class="fas fa-download"></i> دانلود تصویر
                        </button>
                    </div>
                </div>
            `;

            Swal.fire({
                html: imageHtml,
                width: '90vw',
                maxWidth: '800px',
                showConfirmButton: false,
                showCloseButton: true,
                customClass: {
                    popup: 'image-preview-modal'
                }
            });
        }

        // تابع دانلود فایل
        function getFileIdFromPath(path) {
            if (!path) return path;
            const lastSlash = path.lastIndexOf('/');
            const filePart = lastSlash >= 0 ? path.substring(lastSlash + 1) : path;
            const lastDot = filePart.lastIndexOf('.');
            return lastDot > 0 ? filePart.substring(0, lastDot) : filePart;
        }

        async function downloadFile(letterId, fileId, downloadName) {
            try {
                const checkUrl = `@Url.Content("~/Letter/Attachment/Download")?letterId=${letterId}&fileId=${encodeURIComponent(fileId)}&downloadName=${encodeURIComponent(downloadName)}`;
                const resp = await fetch(checkUrl);
                const data = await resp.json();
                if (data.success && data.exists && data.downloadUrl) {
                    const a = document.createElement('a');
                    a.href = data.downloadUrl;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                } else {
                    await Swal.fire({
                        icon: 'warning',
                        title: 'دانلود ناممکن',
                        text: data.message || 'فایل یافت نشد یا حذف شده است.'
                    });
                }
            } catch (e) {
                await Swal.fire({
                    icon: 'error',
                    title: 'خطا',
                    text: 'خطا در بررسی و دانلود پیوست.'
                });
            }
        }
    </script>
}
