                            <span class="file-status success">آپلود شد</span>
                            <button type="button" class="btn btn-sm btn-outline-danger ms-2" onclick="deleteUploadedFile('${file.id}', '${file.name}')">
                                <i class="fas fa-trash"></i> حذف
                            </button>
                        </div>
                    `;
                    filesContainer.appendChild(fileItem);
                });

                // فقط اسامی فایل‌ها را با کاما جدا کن (حداکثر 255 کاراکتر)
                const fileNames = uploadedFiles.map(file => file.name).join(',');
                if (fileNames.length > 255) {
                    // اگر بیش از 255 کاراکتر شد، فقط تعداد فایل‌ها را ذخیره کن
                    fileAddressField.value = `${uploadedFiles.length} فایل آپلود شده`;
                } else {
                    fileAddressField.value = fileNames;
                }

                // اطلاعات کامل فایل‌ها را در فیلد مخفی ذخیره کن
                document.getElementById('attachmentsData').value = JSON.stringify(uploadedFiles);
            }
        }

        // جستجوی نامه و مدیریت انتخاب
        document.getElementById('searchLetterBtn').addEventListener('click', function() {
            performLetterSearch();
        });

        document.getElementById('resetSearchBtn').addEventListener('click', function() {
            resetLetterSearch();
        });

        document.getElementById('selectLetterBtn').addEventListener('click', function() {
            selectLetter();
        });

        function performLetterSearch() {
            const subject = document.getElementById('Subjectsearch').value;
            const letterNumber = document.getElementById('LetterNumber').value;
            const fromDate = document.getElementById('FromDate').value;
            const toDate = document.getElementById('ToDate').value;

            // نمایش loading
            document.getElementById('searchLoading').style.display = 'block';
            document.getElementById('noResults').style.display = 'none';
            document.getElementById('letterSearchResults').getElementsByTagName('tbody')[0].innerHTML = '';

            // درخواست AJAX واقعی به سرور
            $.ajax({
                url: '/Letter/SearchLetters',
                type: 'POST',
                data: {
                    subject: subject,
                    letterNumber: letterNumber,
                    fromDate: fromDate,
                    toDate: toDate
                },
                success: function(response) {
                    document.getElementById('searchLoading').style.display = 'none';
                    if (response.success) {
                        displaySearchResults(response.data);
                    } else {
                        document.getElementById('noResults').style.display = 'block';
                    }
                },
                error: function() {
                    document.getElementById('searchLoading').style.display = 'none';
                    document.getElementById('noResults').style.display = 'block';
                }
            });
        }

        function displaySearchResults(results) {
            const tbody = document.getElementById('letterSearchResults').getElementsByTagName('tbody')[0];
            tbody.innerHTML = '';

            if (results.length === 0) {
                document.getElementById('noResults').style.display = 'block';
                return;
            }

            results.forEach(function(result) {
                const row = document.createElement('tr');
                row.className = 'letter-search-row';
                row.style.cursor = 'pointer';
                row.innerHTML = `
                    <td class="text-center">
                        <input type="checkbox" class="letter-checkbox" id="search-letter-${result.id}" name="search-letter-${result.id}" value="${result.id}" data-number="${result.number}" data-subject="${result.subject}">
                    </td>
                    <td>${result.number}</td>
                    <td>${result.subject}</td>
                    <td>${result.date}</td>
                    <td style="display: none;"></td>
                `;

                // رویداد کلیک روی ردیف
                row.addEventListener('click', function(e) {
                    if (e.target.type !== 'checkbox') {
                        const checkbox = row.querySelector('input[type="checkbox"]');
                        checkbox.checked = !checkbox.checked;
                        updateSelectedRow();
                        updateSelectButton();
                    }
                });

                tbody.appendChild(row);
            });

            // رویداد تغییر چک‌باکس
            const checkboxes = tbody.querySelectorAll('input[type="checkbox"]');
            checkboxes.forEach(function(checkbox) {
                checkbox.addEventListener('change', function() {
                    updateSelectedRow();
                    updateSelectButton();
                });
            });
        }

        function updateSelectedRow() {
            // حذف کلاس selected از همه ردیف‌ها
            const rows = document.querySelectorAll('.letter-search-row');
            rows.forEach(function(row) {
                row.classList.remove('selected-row');
            });

            // اضافه کردن کلاس selected به ردیف‌های انتخاب شده
            const selectedCheckboxes = document.querySelectorAll('.letter-checkbox:checked');
            selectedCheckboxes.forEach(function(checkbox) {
                const selectedRow = checkbox.closest('tr');
                selectedRow.classList.add('selected-row');
            });
        }

        function updateSelectButton() {
            const selectedCheckboxes = document.querySelectorAll('.letter-checkbox:checked');
            const selectButton = document.getElementById('selectLetterBtn');
            selectButton.disabled = selectedCheckboxes.length === 0;
        }

        function selectLetter() {
            const selectedCheckboxes = document.querySelectorAll('.letter-checkbox:checked');
            if (selectedCheckboxes.length > 0) {
                let selectedLetters = [];
                
                selectedCheckboxes.forEach(function(checkbox) {
                    const letterNumber = checkbox.getAttribute('data-number');
                    const letterSubject = checkbox.getAttribute('data-subject');
                    selectedLetters.push(`${letterNumber} - ${letterSubject}`);
                });
                
                // پر کردن فیلد نامه سابقه
                const letterHistoryField = document.getElementById('LetterHistory');
                if (letterHistoryField) {
                    letterHistoryField.value = selectedLetters.join(' | ');
                }

                // بستن مودال
                const modal = bootstrap.Modal.getInstance(document.getElementById('letterSearchModal'));
                modal.hide();

                // نمایش پیام موفقیت
                Swal.fire({
                    title: 'انتخاب شد!',
                    text: `${selectedCheckboxes.length} نامه سابقه با موفقیت انتخاب شد.`,
                    icon: 'success',
                    confirmButtonText: 'باشه',
                    timer: 2000
                });
            }
        }

        function resetLetterSearch() {
            document.getElementById('Subjectsearch').value = '';
            document.getElementById('LetterNumber').value = '';
            document.getElementById('FromDate').value = '';
            document.getElementById('ToDate').value = '';
            document.getElementById('letterSearchResults').getElementsByTagName('tbody')[0].innerHTML = '';
            document.getElementById('searchLoading').style.display = 'none';
            document.getElementById('noResults').style.display = 'none';
            document.getElementById('selectLetterBtn').disabled = true;
        }

    </script>
}