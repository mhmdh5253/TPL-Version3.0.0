                    selectedCodes.push(row.data('id'));
                    selectedNames.push(row.data('name'));
                });

                $('#FileCode').val(selectedCodes.join(','));
                $('#FileCodeText').val(selectedNames.join(', ') + ' (' + selectedCodes.join(', ') + ')');
                const el = document.getElementById('FileCodeSelectModal');
                if (window.bootstrap && bootstrap.Modal) {
                    bootstrap.Modal.getOrCreateInstance(el).hide();
                }
            });
        });
    </script>
    <script>
        $(document).ready(function() {
            $('#letterSearchResults').DataTable();

        });
    </script>
    <script src="~/assets/js/tables-datatables-advanced.js"></script>
    <script>
                $(document).ready(function() {
            // حذف شد - حالا از Bootstrap data attributes استفاده می‌کنیم

                                    // درخت سازمانی ساده
            window.orgData = [
                @foreach (var main in orgs.Where(o => o.IsMain))
                {
                        @: {
                        @:     id: "@main.Id",
                        @:     name: "@main.Name",
                        @:     level: 0,
                        @:     expanded: false,
                        @:     children: [
                        @foreach (var sub in orgs.Where(o => o.ParentId == main.Id))
                        {
                                @:         {
                                @:             id: "@sub.Id",
                                @:             name: "@sub.Name",
                                @:             level: 1,
                                @:             expanded: false,
                                @:             children: [
                                @foreach (var child in orgs.Where(o => o.ParentId == sub.Id))
                                {
                                        @:                 {
                                        @:                     id: "@child.Id",
                                        @:                     name: "@child.Name",
                                        @:                     level: 2,
                                        @:                     expanded: false,
                                        @:                     children: [
                                        @foreach (var leaf in orgs.Where(o => o.ParentId == child.Id))
                                        {
                                                @:                         { id: "@leaf.Id", name: "@leaf.Name", level: 3, children: [] },
                                        }
                                                            @:                     ]
                                        @:                 },
                                }
                                                @:             ]
                                @:         },
                        }
                                    @:     ]
                        @: },
                }
            ];

            // ساخت درخت HTML برای سایر گیرندگان
            function buildTree(excludedId) {
                const container = document.getElementById('treeContainer');
                if (!container) {
                    console.error('treeContainer not found!');
                    return;
                }
                container.innerHTML = '';

                if (!window.orgData || window.orgData.length === 0) {
                    container.innerHTML = '<div class="text-center text-muted">هیچ سازمانی یافت نشد</div>';
                    return;
                }

                window.orgData.forEach(org => {
                    if (org.id !== excludedId) {
                        renderCopyNode(org, container, 0);
                    }
                });
            }

            // تابع جدید برای بازسازی درخت سایر گیرندگان
            function rebuildCopyTree(excludedId) {
                buildTree(excludedId);
            }

            // رندر نود برای سایر گیرندگان (استفاده از کلاس CopyReceiverTree)
            function renderCopyNode(node, container, level) {
                CopyReceiverTree.renderNode(node, container, level);
            }

            // سازگاری با کد قدیمی
            function renderNode(node, container, level) {
                renderCopyNode(node, container, level);
            }

            $("#confirmSelection").click(function() {
                const selectedOrgs = [];
                $('.node-checkbox:checked').each(function() {
                    const nodeId = $(this).data('node-id');
                    const nodeName = $(this).closest('.node-row').find('.node-name').text();
                    const messageInput = $(this).closest('.node-row').find('.message-input');
                    const note = messageInput.is(':visible') ? messageInput.val() || "" : "";
                    selectedOrgs.push({ id: nodeId, name: nodeName, note });
                });
                const idsOnly = selectedOrgs.map(o => o.id);
                $("#selectedOrganizations").val(idsOnly.join(","));
                $("#selectedOrganizationsNotes").val(JSON.stringify(selectedOrgs));
                const el = document.getElementById("Copyreciversmodal");
                if (window.bootstrap && bootstrap.Modal) {
                    bootstrap.Modal.getOrCreateInstance(el).hide();
                }
            });

            /* === CSS مشترک === */
            const treeCSS = document.createElement('style');
            treeCSS.textContent = `
                .expand-btn {
                    background: none;
                    border: none;
                    padding: 2px;
                    cursor: pointer;
                    width: 20px;
                    height: 20px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    border-radius: 3px;
                    transition: all 0.3s ease;
                }
                .expand-btn:hover {
                    background-color: #e9ecef;
                }
                .expand-btn i {
                    font-size: 12px;
                    transition: transform 0.3s ease;
                    color: #6c757d;
                }
                .expand-btn.expanded i {
                    transform: rotate(90deg);
                    color: #495057;
                }
                .children-container {
                    margin-right: 25px;
                    position: relative;
                    overflow: hidden;
                    transition: all 0.3s ease;
                }
                .children-container.hidden {
                    max-height: 0;
                    opacity: 0;
                    margin-bottom: 0;
                }
                .children-container:not(.hidden) {
                    max-height: 2000px;
                    opacity: 1;
                }
                .expand-placeholder {
                    width: 20px;
                    height: 20px;
                    display: inline-block;
                }
                .tree-node {
                    margin: 2px 0;
                }
                .node-row {
                    display: flex;
                    align-items: center;
                    padding: 4px;
                    border-radius: 4px;
                    transition: background-color 0.2s;
                }
                .node-row:hover {
                    background-color: #f8f9fa;
                }
                .node-content {
                    display: flex;
                    align-items: center;
                    width: 100%;
                }
                .node-expand {
                    width: 24px;
                    text-align: center;
                }
                .node-toggle {
                    width: 24px;
                    text-align: center;
                }
                .node-name {
                    flex-grow: 1;
                    padding-right: 8px;
                    font-size: 14px;
                }
            `;
            document.head.appendChild(treeCSS);

            /* === اسکریپت مستقل برای سایر گیرندگان === */
            const CopyReceiverTree = {
                // تابع باز/بسته کردن
                toggleExpand: function(nodeId) {
                    const expandBtn = document.querySelector(`button[onclick="CopyReceiverTree.toggleExpand('${nodeId}')"]`);
                const childrenContainer = document.querySelector(`.children-container[data-parent-id="${nodeId}"]`);
                    const node = this.findNodeById(nodeId);

                if (childrenContainer) {
                        const isHidden = childrenContainer.classList.contains('hidden');
                        
                        if (isHidden) {
                            // باز کردن
                            childrenContainer.classList.remove('hidden');
                        if (expandBtn) {
                            expandBtn.classList.add('expanded');
                            }
                            if (node) node.expanded = true;
                    } else {
                            // بسته کردن
                            childrenContainer.classList.add('hidden');
                        if (expandBtn) {
                            expandBtn.classList.remove('expanded');
                            }
                            if (node) node.expanded = false;
                        }
                    } else if (node && node.children && node.children.length > 0) {
                        // ساخت جدید
                        const parentNode = document.querySelector(`[data-node-id="${nodeId}"]`);
                        if (parentNode) {
                            const newContainer = document.createElement('div');
                            newContainer.className = 'children-container';
                            newContainer.setAttribute('data-parent-id', nodeId);

                            node.children.forEach(child => {
                                this.renderNode(child, newContainer, parseInt(parentNode.getAttribute('data-level')) + 1);
                            });

                            parentNode.appendChild(newContainer);
                            if (expandBtn) expandBtn.classList.add('expanded');
                            if (node) node.expanded = true;
                        }
                    }
                },

                // پیدا کردن نود
                findNodeById: function(nodeId, nodes = window.orgData) {
                    for (let node of nodes) {
                        if (node.id === nodeId) return node;
                        if (node.children) {
                            const found = this.findNodeById(nodeId, node.children);
                            if (found) return found;
                        }
                    }
                    return null;
                },

                // رندر نود
                renderNode: function(node, container, level) {
                const nodeDiv = document.createElement('div');
                nodeDiv.className = 'tree-node';
                nodeDiv.setAttribute('data-node-id', node.id);
                nodeDiv.setAttribute('data-level', level);

                const hasChildren = node.children && node.children.length > 0;
                    const isExpanded = node.expanded === true;
                    const isSelected = node.selected || false;

                nodeDiv.innerHTML = `
                    <div class="node-row ${isSelected ? 'selected' : ''}" data-id="${node.id}">
                        <div class="node-content">
                            <div class="node-expand">
                                ${hasChildren ?
                                    `<button type="button" class="expand-btn ${isExpanded ? 'expanded' : ''}"
                                             onclick="toggleCopyExpand('${node.id}')">
                                        <i class="fas fa-chevron-right"></i>
                                     </button>` :
                                    '<span class="expand-placeholder"></span>'
                                }
                            </div>
                            <div class="node-toggle">
                                    <input type="checkbox" class="node-checkbox" 
                                           id="copy-node-${node.id}" name="copy-node-${node.id}" 
                                           ${isSelected ? 'checked' : ''}
                                       onchange="toggleNode('${node.id}')">
                            </div>
                            <div class="node-name">${node.name}</div>
                            <div class="node-message">
                                    <input type="text" class="message-input" 
                                           id="message-${node.id}" name="message-${node.id}" 
                                           placeholder="پیام اختصاصی برای ${node.name}"
                                           maxlength="200" 
                                           oninput="updateCounter('${node.id}', this.value.length)"
                                       style="display: ${isSelected ? 'block' : 'none'}">
                            </div>
                            <div class="node-counter" style="display: ${isSelected ? 'block' : 'none'}">0/200</div>
                        </div>
                    </div>
                `;

                container.appendChild(nodeDiv);

                if (hasChildren) {
                    const childrenContainer = document.createElement('div');
                        childrenContainer.className = isExpanded ? 'children-container' : 'children-container hidden';
                    childrenContainer.setAttribute('data-parent-id', node.id);

                    node.children.forEach(child => {
                            this.renderNode(child, childrenContainer, level + 1);
                    });

                    container.appendChild(childrenContainer);
                }
                },

                // تغییر وضعیت انتخاب
                toggleSelection: function(nodeId) {
                    const checkbox = document.getElementById(`copy-node-${nodeId}`);
                    const row = checkbox.closest('.node-row');
                    const messageInput = document.getElementById(`message-${nodeId}`);
                    const counter = row.querySelector('.node-counter');

                    if (checkbox.checked) {
                        row.classList.add('selected');
                        messageInput.style.display = 'block';
                        counter.style.display = 'block';
                    } else {
                        row.classList.remove('selected');
                        messageInput.style.display = 'none';
                        counter.style.display = 'none';
                        messageInput.value = '';
                        counter.textContent = '0/200';
                        counter.className = 'node-counter';
                    }
                },

                // به‌روزرسانی شمارنده
                updateCounter: function(nodeId, length) {
                    const counter = document.getElementById(`copy-node-${nodeId}`).closest('.node-row').querySelector('.node-counter');
                    counter.textContent = length + '/200';
                    counter.className = 'node-counter';
                    if (length > 150) counter.classList.add('text-warning');
                    if (length > 195) counter.classList.add('text-danger');
                }
            };

            // در دسترس قراردادن توابع سایر گیرندگان
            window.toggleCopyExpand = function(nodeId) {
                console.log('toggleCopyExpand called for:', nodeId);
                CopyReceiverTree.toggleExpand(nodeId);
            };
            window.toggleNode = function(nodeId) {
                console.log('toggleNode called for:', nodeId);
                CopyReceiverTree.toggleSelection(nodeId);
            };
            window.updateCounter = function(nodeId, length) {
                CopyReceiverTree.updateCounter(nodeId, length);
            };

            /* === اسکریپت مستقل برای گیرنده اصلی === */
            const MainReceiverTree = {
                // تابع باز/بسته کردن
                toggleExpand: function(nodeId) {
                    const expandBtn = document.querySelector(`button[onclick="MainReceiverTree.toggleExpand('${nodeId}')"]`);
                const childrenContainer = document.querySelector(`.children-container[data-parent-id="${nodeId}"]`);
                    const node = this.findNodeById(nodeId);

                if (childrenContainer) {
                        const isHidden = childrenContainer.classList.contains('hidden');
                        
                        if (isHidden) {
                            // باز کردن
                            childrenContainer.classList.remove('hidden');
                        if (expandBtn) {
                            expandBtn.classList.add('expanded');
                            }
                            if (node) node.expanded = true;
                    } else {
                            // بسته کردن
                            childrenContainer.classList.add('hidden');
                        if (expandBtn) {
                            expandBtn.classList.remove('expanded');
                            }
                            if (node) node.expanded = false;
                        }
                    } else if (node && node.children && node.children.length > 0) {
                        // ساخت جدید
                        const parentNode = document.querySelector(`[data-node-id="${nodeId}"]`);
                        if (parentNode) {
                            const newContainer = document.createElement('div');
                            newContainer.className = 'children-container';
                            newContainer.setAttribute('data-parent-id', nodeId);

                            node.children.forEach(child => {
                                this.renderNode(child, newContainer, parseInt(parentNode.getAttribute('data-level')) + 1);
                            });

                            parentNode.parentNode.insertBefore(newContainer, parentNode.nextSibling);
                            if (expandBtn) expandBtn.classList.add('expanded');
                            if (node) node.expanded = true;
                        }
                    }
                },

                // پیدا کردن نود
                findNodeById: function(nodeId, nodes = window.orgData) {
                for (let node of nodes) {
                        if (node.id === nodeId) return node;
                    if (node.children) {
                            const found = this.findNodeById(nodeId, node.children);
                        if (found) return found;
                    }
                }
                return null;
                },

                // رندر نود
                renderNode: function(node, container, level) {
                    const nodeDiv = document.createElement('div');
                    nodeDiv.className = 'tree-node';
                    nodeDiv.setAttribute('data-node-id', node.id);
                    nodeDiv.setAttribute('data-level', level);

                    const hasChildren = node.children && node.children.length > 0;
                    const isExpanded = node.expanded === true;

                    nodeDiv.innerHTML = `
                        <div class="node-row" data-id="${node.id}">
                            <div class="node-content">
                                <div class="node-expand">
                                    ${hasChildren ?
                                        `<button type="button" class="expand-btn ${isExpanded ? 'expanded' : ''}"
                                                 onclick="toggleReceiverExpand('${node.id}')">
                                            <i class="fas fa-chevron-right"></i>
                                         </button>` :
                                        '<span class="expand-placeholder"></span>'
                                    }
                                </div>
                                <div class="node-toggle">
                                    <input type="radio" name="receiverSelection" class="node-radio" 
                                           value="${node.id}"
                                           onchange="selectReceiver('${node.id}', '${node.name}')">
                                </div>
                                <div class="node-name">${node.name}</div>
                            </div>
                        </div>
                    `;

                    container.appendChild(nodeDiv);

                    if (hasChildren) {
                        const childrenContainer = document.createElement('div');
                        childrenContainer.className = isExpanded ? 'children-container' : 'children-container hidden';
                        childrenContainer.setAttribute('data-parent-id', node.id);

                        node.children.forEach(child => {
                            this.renderNode(child, childrenContainer, level + 1);
                        });

                        container.appendChild(childrenContainer);
                    }
                },

                // انتخاب گیرنده
                selectReceiver: function(nodeId, nodeName) {
                    // فقط یک سازمان انتخاب شود
                    $('input[name="receiverSelection"]').prop('checked', false);
                    $(`input[value="${nodeId}"]`).prop('checked', true);

                    $('#Receiver').val(nodeId);

                    // ساخت نام کامل با سلسله مراتب
                    const fullName = this.getFullOrganizationName(nodeId);
                    $('#ReceiverText').val(fullName);

                    // بازسازی درخت رونوشت بدون نمایش گیرنده اصلی
                    buildTree(nodeId);

                    const el = document.getElementById('ReceiverSelectModal');
                    if (window.bootstrap && bootstrap.Modal) {
                        bootstrap.Modal.getOrCreateInstance(el).hide();
                    }
                },

                // ساخت نام کامل سازمان
                getFullOrganizationName: function(nodeId) {
                    const node = this.findNodeById(nodeId);
                    if (!node) return '';

                    const path = [];
                    let currentNode = node;

                    while (currentNode) {
                        path.unshift(currentNode.name);

                        if (currentNode.level > 0) {
                            const parentId = this.findParentId(currentNode.id);
                            currentNode = parentId ? this.findNodeById(parentId) : null;
                    } else {
                            break;
                        }
                    }

                    return path.join('-');
                },

                // پیدا کردن والد
                findParentId: function(nodeId, nodes = window.orgData, parentId = null) {
                    for (let node of nodes) {
                        if (node.id === nodeId) return parentId;
                        if (node.children) {
                            const found = this.findParentId(nodeId, node.children, node.id);
                            if (found) return found;
                        }
                    }
                    return null;
                }
            };

            // در دسترس قراردادن توابع گیرنده اصلی
            window.toggleReceiverExpand = function(nodeId) {
                console.log('toggleReceiverExpand called for:', nodeId);
                MainReceiverTree.toggleExpand(nodeId);
            };
            window.selectReceiver = function(nodeId, nodeName) {
                console.log('selectReceiver called for:', nodeId, nodeName);
                MainReceiverTree.selectReceiver(nodeId, nodeName);
            };

            // استفاده از CopyReceiverTree.findNodeById

            // حذف شد - از CopyReceiverTree.toggleSelection استفاده می‌شود

            // حذف شد - از CopyReceiverTree.updateCounter استفاده می‌شود

            // جستجو
            $("#treeSearch").on("keyup", function() {
                const searchTerm = $(this).val().toLowerCase();

                if (searchTerm === '') {
                    // اگر جستجو خالی است، همه را نمایش بده
                    $('.tree-node').show();
                    $('.children-container').show();
                    return;
                }

                // ابتدا همه را مخفی کن
                $('.tree-node').hide();
                $('.children-container').hide();

                // سپس موارد مطابق را نمایش بده
                $('.node-row').each(function() {
                    const nodeName = $(this).find('.node-name').text().toLowerCase();
                    if (nodeName.includes(searchTerm)) {
                        // نمایش خود نود
                        $(this).closest('.tree-node').show();

                        // نمایش والدین
                        $(this).closest('.tree-node').parents('.children-container').show();
                        $(this).closest('.tree-node').parents('.tree-node').show();

                        // نمایش فرزندان
                        $(this).closest('.tree-node').find('.children-container').show();
                        $(this).closest('.tree-node').find('.tree-node').show();
                    }
            });
        });

            // حذف شد - اکنون از کلاس‌های مستقل استفاده می‌شود

            // مقداردهی اولیه درخت
            buildTree($("#Receiver").val() || '');
            
            // مقداردهی درخت گیرنده اصلی بعد از تعریف orgData
            console.log('orgData loaded:', window.orgData);
            buildReceiverTree();

            // تابع ساخت درخت گیرنده اصلی
            function buildReceiverTree() {
                const container = document.getElementById('receiverTreeContainer');
                container.innerHTML = '';

                console.log('buildReceiverTree called, orgData:', window.orgData);

                if (!window.orgData || window.orgData.length === 0) {
                    container.innerHTML = '<div class="text-center text-muted">هیچ سازمانی یافت نشد</div>';
                    return;
                }

                window.orgData.forEach(org => {
                    MainReceiverTree.renderNode(org, container, 0);
                });
            }

            // تابع انتخاب گیرنده اصلی
            window.selectReceiver = function(nodeId, nodeName) {
                // فقط یک سازمان انتخاب شود
                $('input[name="receiverSelection"]').prop('checked', false);
                $(`input[value="${nodeId}"]`).prop('checked', true);
                
                $('#Receiver').val(nodeId);
                
                // ساخت نام کامل با سلسله مراتب
                const fullName = getFullOrganizationName(nodeId);
                $('#ReceiverText').val(fullName);

                // بازسازی درخت رونوشت بدون نمایش گیرنده اصلی
                buildTree(nodeId);

                const el = document.getElementById('ReceiverSelectModal');
                if (window.bootstrap && bootstrap.Modal) {
                    bootstrap.Modal.getOrCreateInstance(el).hide();
                }
            };

            // تابع ساخت نام کامل سازمان با سلسله مراتب
            function getFullOrganizationName(nodeId) {
                const node = findReceiverNodeById(nodeId);
                if (!node) return '';

                const path = [];
                let currentNode = node;
                
                // جمع‌آوری مسیر از نود فعلی تا ریشه
                while (currentNode) {
                    path.unshift(currentNode.name);
                    
                    // پیدا کردن والد
                    if (currentNode.level > 0) {
                        currentNode = findParentNode(currentNode.id);
                    } else {
                        currentNode = null;
                    }
                }
                
                return path.join('-');
            }

            // تابع پیدا کردن والد یک نود
            function findParentNode(nodeId) {
                for (let org of window.orgData) {
                    if (org.children) {
                        const found = findParentInChildren(org, nodeId);
                        if (found) return found;
                    }
                }
                return null;
            }

            // استفاده از MainReceiverTree.findNodeById

            // تابع جستجوی والد در فرزندان
            function findParentInChildren(parent, targetId) {
                if (parent.children) {
                    for (let child of parent.children) {
                        if (child.id === targetId) {
                            return parent;
                        }
                        const found = findParentInChildren(child, targetId);
                        if (found) return found;
                    }
                }
                return null;
            }

            // حذف شد - اکنون از MainReceiverTree استفاده می‌شود

            // تابع رندر نود گیرنده اصلی (استفاده از کلاس MainReceiverTree)
            function renderReceiverNode(node, container, level) {
                MainReceiverTree.renderNode(node, container, level);
            }

            // جستجو در درخت گیرنده اصلی
            $("#receiverTreeSearch").on("keyup", function() {
                const searchTerm = $(this).val().toLowerCase();

                if (searchTerm === '') {
                    $('.tree-node').show();
                    $('.children-container').show();
                    return;
                }

                $('.tree-node').hide();
                $('.children-container').hide();

                $('.node-row').each(function() {
                    const nodeName = $(this).find('.node-name').text().toLowerCase();
                    if (nodeName.includes(searchTerm)) {
                        $(this).closest('.tree-node').show();
                        $(this).closest('.tree-node').parents('.children-container').show();
                        $(this).closest('.tree-node').parents('.tree-node').show();
                        $(this).closest('.tree-node').find('.children-container').show();
                        $(this).closest('.tree-node').find('.tree-node').show();
                    }
                });
            });

            // تأیید انتخاب گیرنده اصلی
            $("#confirmReceiverSelection").click(function() {
                const selectedRadio = $('input[name="receiverSelection"]:checked');
                if (selectedRadio.length > 0) {
                    const nodeId = selectedRadio.val();
                    const nodeName = selectedRadio.closest('.node-row').find('.node-name').text();
                    selectReceiver(nodeId, nodeName);
                } else {
                    Swal.fire({
                        title: 'خطا!',
                        text: 'لطفاً یک سازمان انتخاب کنید.',
                        icon: 'warning',
                        confirmButtonText: 'باشه'
                    });
                }
            });
        });
