        function uploadSingleFile(file, index, callback) {
            const formData = new FormData();
            formData.append('file', file);

            const xhr = new XMLHttpRequest();
            xhr.open('POST', '/Letter/UploadFile', true);

            xhr.onload = function() {
                const fileItem = document.querySelectorAll('.file-item')[index];
                const statusSpan = fileItem.querySelector('.file-status');

                if (xhr.status === 200) {
                    const response = JSON.parse(xhr.responseText);
                    if (response.success) {
                        fileItem.classList.add('success');
                        statusSpan.textContent = 'آپلود شد';
                        statusSpan.className = 'file-status success';
                        uploadedFiles.push({
                            id: response.filePath, // استفاده از filePath به عنوان id یکتا
                            name: file.name,
                            path: response.filePath,
                            size: file.size
                        });
                        callback(true);
                } else {
                        fileItem.classList.add('error');
                        statusSpan.textContent = 'خطا';
                        statusSpan.className = 'file-status error';
                        callback(false);
                    }
                } else {
                    fileItem.classList.add('error');
                    statusSpan.textContent = 'خطا';
                    statusSpan.className = 'file-status error';
                    callback(false);
                }
            };

            xhr.onerror = function() {
                const fileItem = document.querySelectorAll('.file-item')[index];
                const statusSpan = fileItem.querySelector('.file-status');
                fileItem.classList.add('error');
                statusSpan.textContent = 'خطا';
                statusSpan.className = 'file-status error';
                callback(false);
            };

            xhr.send(formData);
        }

