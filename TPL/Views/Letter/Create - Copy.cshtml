            $('#selectFileCodeBtn').on('click', function(){
                var checkedBoxes = $('#FileCodeSelectModal tbody tr input[type="checkbox"]:checked');
                if (checkedBoxes.length === 0) return;

                var selectedCodes = [];
                var selectedNames = [];
                checkedBoxes.each(function(){
