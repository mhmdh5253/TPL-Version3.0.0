    <script>
        var dt;
        $(document).ready(function(){
            // Initialize DataTable with Persian language
            dt = $('#dataTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/fa.json'
                },
                responsive: true,
                pageLength: 25,
                order: [[0, 'desc']],
                columnDefs: [
                    { orderable: false, targets: [1, 2, -1] } // Disable sorting for status, read status, priority, and actions columns
                ]
            });

            // Apply small controls on mobile and manage on resize
            function applyTopbarSizing() {
                const isMobile = window.matchMedia('(max-width: 768px)').matches;
                const $filterInput = $('.dataTables_wrapper .dataTables_filter input');
                const $lengthSelect = $('.dataTables_wrapper .dataTables_length select');
                if (isMobile) {
                    $filterInput.addClass('form-control-sm');
                    $lengthSelect.addClass('form-select-sm');
                } else {
                    $filterInput.removeClass('form-control-sm');
                    $lengthSelect.removeClass('form-select-sm');
                }
            }
            applyTopbarSizing();
            $(window).on('resize', applyTopbarSizing);

            // Initialize tooltips
            initializeTooltips();

            // Add animation to status badges
            setInterval(function() {
                $('.status-badge').addClass('animate__pulse');
                setTimeout(function() {
                    $('.status-badge').removeClass('animate__pulse');
                }, 1000);
            }, 3000);

            // Priority badge animations
            initializeEnhancedAnimations();

            // Row hover effects
            $('.letter-row').hover(
                function() {
                    $(this).addClass('animate__pulse');
                },
                function() {
                    $(this).removeClass('animate__pulse');
                }
            );

            // Update letter count
            updateLetterCount();
        });

        // Enhanced Priority and Status Animations
        function initializeEnhancedAnimations() {
            // Add staggered animation delays for priority badges
            $('.priority-badge').each(function(index) {
                $(this).css('animation-delay', `${index * 0.1}s`);
            });

            // Add hover effects for status badges
            $('.status-badge').hover(
                function() {
                    $(this).addClass('animate__pulse');
                },
                function() {
                    $(this).removeClass('animate__pulse');
                }
            );

            // Add click effects for priority badges
            $('.priority-badge').click(function() {
                $(this).addClass('animate__bounce');
                setTimeout(() => {
                    $(this).removeClass('animate__bounce');
                }, 600);
            });

            // Add floating animation for read status
            $('.read-status').addClass('animate__animated animate__fadeIn');
        }

        // Initialize tooltips
        function initializeTooltips() {
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl, {
                    placement: 'top',
                    trigger: 'hover'
                });
            });
        }

        // Enhanced letter count update
        function updateLetterCount() {
            const totalLetters = $('.letter-row').length;
            const unreadLetters = $('.read-unopened').length;
            const urgentLetters = $('.priority-urgent').length;
            const highPriorityLetters = $('.priority-high').length;
            
            // Update the main badge
            $('#letterCount').html(`<i class="fas fa-envelope me-2"></i>${totalLetters} نامه`);
            
            // Add priority indicators to header
            updatePriorityIndicators(unreadLetters, urgentLetters, highPriorityLetters);
        }

        function updatePriorityIndicators(unread, urgent, high) {
            // Clear existing indicators
            $('.priority-indicators').remove();
            
            // Create priority indicators container
            const indicatorsContainer = $('<div class="priority-indicators d-flex gap-2"></div>');
            
            if (unread > 0) {
                indicatorsContainer.append(`
                    <div class="priority-indicator unread" data-bs-toggle="tooltip" title="${unread} نامه خوانده نشده">
                        <i class="fas fa-envelope text-warning"></i>
                        <span class="count">${unread}</span>
                    </div>
                `);
            }
            
            if (urgent > 0) {
                indicatorsContainer.append(`
                    <div class="priority-indicator urgent" data-bs-toggle="tooltip" title="${urgent} نامه با اولویت آنی">
                        <i class="fas fa-bolt text-danger"></i>
                        <span class="count">${urgent}</span>
                    </div>
                `);
            }
            
            if (high > 0) {
                indicatorsContainer.append(`
                    <div class="priority-indicator high" data-bs-toggle="tooltip" title="${high} نامه با اولویت بالا">
                        <i class="fas fa-exclamation-triangle text-warning"></i>
                        <span class="count">${high}</span>
                    </div>
                `);
            }
            
            // Add to header actions area if there are indicators
            if (indicatorsContainer.children().length > 0) {
                const $target = $('#header-actions');
                if ($target.length) {
                    $target.prepend(indicatorsContainer);
                    initializeTooltips();
                }
            }
        }

        function showNotification(message, type = 'info') {
            const alertClass = `alert-${type}`;
            const iconClass = type === 'success' ? 'fa-check-circle' : 
                             type === 'warning' ? 'fa-exclamation-triangle' : 
                             type === 'error' ? 'fa-times-circle' : 'fa-info-circle';
            
            const notification = $(`
                <div class="alert ${alertClass} alert-dismissible fade show position-fixed" 
                     style="top: 20px; right: 20px; z-index: 9999; min-width: 300px;">
                    <i class="fas ${iconClass} me-2"></i>
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `);
            
            $('body').append(notification);
            
            // Auto-remove after 4 seconds
            setTimeout(function() {
                notification.alert('close');
            }, 4000);
        }

        async function showReturnReason(letterId) {
            try {
                const res = await fetch('@Url.Action("GetActions", "LetterApprovalFlow")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value },
                    body: JSON.stringify(letterId),
                    credentials: 'include'
                });
                const data = await res.json();
                if (!data || data.Success === false) throw new Error(data?.Message || 'خطا در دریافت اقدامات');
                const actions = data.Data?.Actions || [];
                const ret = actions.find(a => (a.ActionDescription||'').includes('عودت')) || actions[0];
                const desc = ret ? ret.ActionDescription : 'علت عودت ثبت نشده است';
                await Swal.fire({
                    title: 'علت/شرح عودت',
                    text: desc,
                    icon: 'info',
                    confirmButtonText: 'بستن'
                });
            } catch (e) {
                showNotification(e.message || 'خطا', 'error');
            }
        }

        $(document).on('click', '.mark-dashboard-read', function(){
            var id = $(this).data('id');
            var $tr = $(this).closest('tr');
            
            // Show loading state
            $(this).html('<i class="fas fa-spinner fa-spin"></i>');
            $(this).prop('disabled', true);
            
            fetch('/Letter/MarkDashboardRead/' + id, { 
                method: 'POST', 
                headers: { 'X-Requested-With': 'XMLHttpRequest' } 
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    showNotification('نامه با موفقیت علامت‌گذاری شد', 'success');
                    if (dt) {
                        dt.row($tr).remove().draw(false);
                    } else {
                        $tr.fadeOut(500, function() {
                            $(this).remove();
                        });
                    }
                    updateLetterCount();
                } else {
                    showNotification('خطا در علامت‌گذاری نامه', 'error');
                }
            })
            .catch((error) => {
                console.error('Error:', error);
                showNotification('خطا در ارتباط با سرور', 'error');
            })
            .finally(() => {
                // Reset button state
                $(this).html('<i class="fas fa-check"></i>');
                $(this).prop('disabled', false);
            });
        });

        // Keyboard shortcuts
        $(document).keydown(function(e) {
            // Ctrl+F to focus search
            if (e.ctrlKey && e.key === 'f') {
                e.preventDefault();
                $('.dataTables_filter input').focus();
            }
            
            // Ctrl+N to create new letter
            if (e.ctrlKey && e.key === 'n') {
                e.preventDefault();
                $('a[asp-action="Create"]').click();
            }
        });

        // Add loading animation to buttons
        $('.btn').click(function() {
            const btn = $(this);
            if (!btn.hasClass('disabled')) {
                btn.addClass('btn-loading');
                setTimeout(() => btn.removeClass('btn-loading'), 200);
            }
        });
    </script>
}