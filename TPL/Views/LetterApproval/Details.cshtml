@using BE.LetterAutomation
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model BE.LetterAutomation.LetterApproval

<div class="card border-0 shadow-lg">
    <div class="card-header bg-gradient-info text-white">
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <div class="header-icon me-3">
                    <i class="fas fa-file-alt fa-2x"></i>
                </div>
                <div>
                    <h3 class="card-title mb-1">جزئیات درخواست تایید</h3>
                    <p class="mb-0 opacity-75">
                        <i class="fas fa-info-circle me-1"></i>مشاهده اطلاعات کامل درخواست تایید
                    </p>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-light btn-lg px-4">
                    <i class="fas fa-arrow-left me-2"></i>بازگشت به لیست
                </a>
            </div>
        </div>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">شماره نامه:</dt>
            <dd class="col-sm-9">@Model?.Letter?.LetterNumber</dd>

            <dt class="col-sm-3">موضوع نامه:</dt>
            <dd class="col-sm-9">@Model?.Letter?.Subject</dd>

            <dt class="col-sm-3">درخواست کننده:</dt>
            <dd class="col-sm-9">@Model?.Requester?.FirstName @Model?.Requester?.LastName</dd>

            <dt class="col-sm-3">تاییدکننده:</dt>
            <dd class="col-sm-9">@Model?.Approver?.FirstName @Model?.Approver?.LastName</dd>

            <dt class="col-sm-3">سازمان:</dt>
            <dd class="col-sm-9">@Model?.Organization?.Name</dd>

            <dt class="col-sm-3">سطح تایید:</dt>
            <dd class="col-sm-9">@Model?.ApprovalLevel</dd>

            <dt class="col-sm-3">وضعیت:</dt>
            <dd class="col-sm-9">
                                                @switch (Model?.Status)
                                {
                                    case ApprovalStatus.Pending:
                                        <span class="badge bg-warning">
                                            <i class="fas fa-clock me-1"></i>در انتظار
                                        </span>
                                        break;
                                    case ApprovalStatus.Approved:
                                        <span class="badge bg-success">
                                            <i class="fas fa-check-circle me-1"></i>تایید شده
                                        </span>
                                        break;
                                    case ApprovalStatus.Rejected:
                                        <span class="badge bg-danger">
                                            <i class="fas fa-times-circle me-1"></i>رد شده
                                        </span>
                                        break;
                                    case ApprovalStatus.Returned:
                                        <span class="badge bg-info">
                                            <i class="fas fa-undo me-1"></i>بازگشت داده شده
                                        </span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">
                                            <i class="fas fa-question-circle me-1"></i>نامشخص
                                        </span>
                                        break;
                                }
            </dd>

            <dt class="col-sm-3">تاریخ درخواست:</dt>
            <dd class="col-sm-9">@Model!.RequestDate</dd>

            <dt class="col-sm-3">تاریخ اقدام:</dt>
            <dd class="col-sm-9">@(Model.ActionDate.ToString() ?? "-")</dd>

            <dt class="col-sm-3">توضیحات:</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Comment) ? "-" : Model.Comment)</dd>
        </dl>

        <div class="text-center mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                <i class="fas fa-arrow-left me-2"></i>بازگشت به لیست
            </a>
        </div>
    </div>
</div>

<style>
    .bg-gradient-info {
        background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);
    }
    
    .header-icon {
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(10px);
    }
    
    .card {
        border-radius: 16px;
        border: none;
        overflow: hidden;
    }
    
    .card-header {
        border-bottom: none;
        padding: 2rem;
    }
    
    .card-body {
        padding: 2rem;
    }
    
    .btn {
        border-radius: 12px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        transition: all 0.3s ease;
        border: none;
    }
    
    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }
    
    .btn-outline-light {
        border: 2px solid rgba(255, 255, 255, 0.7);
        color: white;
    }
    
    .btn-outline-light:hover {
        background: white;
        color: #17a2b8;
        border-color: white;
    }
    
    .btn-outline-secondary {
        border: 2px solid #6c757d;
        color: #6c757d;
    }
    
    .btn-outline-secondary:hover {
        background: #6c757d;
        color: white;
        transform: translateY(-3px);
    }
    
    .badge {
        font-size: 0.875rem;
        padding: 0.5rem 0.75rem;
        border-radius: 20px;
    }
    
    .bg-warning {
        background: linear-gradient(135deg, #ffc107 0%, #fd7e14 100%) !important;
        color: #000 !important;
    }
    
    .bg-success {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%) !important;
    }
    
    .bg-danger {
        background: linear-gradient(135deg, #dc3545 0%, #fd7e14 100%) !important;
    }
    
    .bg-info {
        background: linear-gradient(135deg, #17a2b8 0%, #20c997 100%) !important;
    }
    
    .bg-secondary {
        background: linear-gradient(135deg, #6c757d 0%, #495057 100%) !important;
    }
    
    dl.row {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 1.5rem;
        margin: 0;
    }
    
    dt {
        font-weight: 600;
        color: #495057;
        padding: 0.5rem 0;
    }
    
    dd {
        padding: 0.5rem 0;
        margin-bottom: 0.5rem;
    }
    
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .fade-in-up {
        animation: fadeInUp 0.6s ease;
    }
    
    .card {
        animation: fadeInUp 0.6s ease;
    }
    
    dl.row {
        animation: fadeInUp 0.6s ease;
        animation-delay: 0.2s;
    }
</style>