@using Microsoft.AspNetCore.Mvc.TagHelpers
@model BE.LetterAutomation.LetterApproval

<div class="card border-0 shadow-lg">
    <div class="card-header bg-gradient-warning text-white">
        <div class="d-flex align-items-center">
            <div class="header-icon me-3">
                <i class="fas fa-cogs fa-2x"></i>
            </div>
            <div>
                <h3 class="card-title mb-1">پردازش درخواست تایید</h3>
                <p class="mb-0 opacity-75">
                    <i class="fas fa-info-circle me-1"></i>اقدام بر روی درخواست تایید نامه
                </p>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="info-card">
                    <h5 class="mb-3">
                        <i class="fas fa-file-alt me-2 text-primary"></i>اطلاعات نامه
                    </h5>
                    <div class="info-item">
                        <i class="fas fa-hashtag me-2 text-info"></i>
                        <strong>شماره نامه:</strong> @Model?.Letter?.LetterNumber
                    </div>
                    <div class="info-item">
                        <i class="fas fa-heading me-2 text-success"></i>
                        <strong>موضوع:</strong> @Model?.Letter?.Subject
                    </div>
                    <div class="info-item">
                        <i class="fas fa-calendar me-2 text-warning"></i>
                        <strong>تاریخ ثبت:</strong> @Model?.Letter?.RegistrationDate
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="info-card">
                    <h5 class="mb-3">
                        <i class="fas fa-user-check me-2 text-primary"></i>اطلاعات درخواست
                    </h5>
                    <div class="info-item">
                        <i class="fas fa-user me-2 text-info"></i>
                        <strong>درخواست کننده:</strong> @Model?.Requester?.FirstName @Model?.Requester?.LastName
                    </div>
                    <div class="info-item">
                        <i class="fas fa-layer-group me-2 text-success"></i>
                        <strong>سطح تایید:</strong> @Model?.ApprovalLevel
                    </div>
                    <div class="info-item">
                        <i class="fas fa-building me-2 text-warning"></i>
                        <strong>سازمان:</strong> @Model?.Organization?.Name
                    </div>
                </div>
            </div>
        </div>

        <form asp-action="Process" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-4">
                <label asp-for="Comment" class="form-label fw-bold">
                    <i class="fas fa-comment me-2"></i>توضیحات
                </label>
                <div class="input-group">
                    <span class="input-group-text bg-light">
                        <i class="fas fa-comment text-primary"></i>
                    </span>
                    <textarea asp-for="Comment" class="form-control" rows="3" 
                              placeholder="توضیحات خود را در این قسمت وارد کنید..."></textarea>
                </div>
                <span asp-validation-for="Comment" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label class="form-label fw-bold mb-3">
                    <i class="fas fa-tasks me-2"></i>عملیات
                </label>
                <div class="d-flex gap-3 flex-wrap">
                    <button type="submit" name="action" value="approve" class="btn btn-success btn-lg px-4">
                        <i class="fas fa-check me-2"></i>تایید نامه
                    </button>
                    <button type="submit" name="action" value="reject" class="btn btn-danger btn-lg px-4">
                        <i class="fas fa-times me-2"></i>رد نامه
                    </button>
                    <button type="submit" name="action" value="return" class="btn btn-info btn-lg px-4">
                        <i class="fas fa-undo me-2"></i>بازگشت به سطح قبل
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                        <i class="fas fa-times me-2"></i>انصراف
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<style>
    .bg-gradient-warning {
        background: linear-gradient(135deg, #ffc107 0%, #fd7e14 100%);
    }
    
    .header-icon {
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(10px);
    }
    
    .card {
        border-radius: 16px;
        border: none;
        overflow: hidden;
    }
    
    .card-header {
        border-bottom: none;
        padding: 2rem;
    }
    
    .card-body {
        padding: 2rem;
    }
    
    .info-card {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 1.5rem;
        border: 1px solid #e9ecef;
        height: 100%;
    }
    
    .info-item {
        padding: 0.5rem 0;
        border-bottom: 1px solid #e9ecef;
    }
    
    .info-item:last-child {
        border-bottom: none;
    }
    
    .form-label {
        color: #495057;
        margin-bottom: 0.75rem;
    }
    
    .form-control {
        border-radius: 12px;
        border: 2px solid #e9ecef;
        padding: 0.75rem 1rem;
        font-size: 1rem;
        transition: all 0.3s ease;
    }
    
    .form-control:focus {
        border-color: #ffc107;
        box-shadow: 0 0 0 0.2rem rgba(255, 193, 7, 0.25);
        transform: translateY(-2px);
    }
    
    .input-group-text {
        border-radius: 12px 0 0 12px;
        border: 2px solid #e9ecef;
        border-right: none;
        background: #f8f9fa;
        color: #6c757d;
    }
    
    .input-group .form-control {
        border-radius: 0 12px 12px 0;
        border-left: none;
    }
    
    .btn {
        border-radius: 12px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        transition: all 0.3s ease;
        border: none;
    }
    
    .btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }
    
    .btn-success {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        box-shadow: 0 4px 15px rgba(40, 167, 69, 0.4);
    }
    
    .btn-danger {
        background: linear-gradient(135deg, #dc3545 0%, #fd7e14 100%);
        box-shadow: 0 4px 15px rgba(220, 53, 69, 0.4);
    }
    
    .btn-info {
        background: linear-gradient(135deg, #17a2b8 0%, #20c997 100%);
        box-shadow: 0 4px 15px rgba(23, 162, 184, 0.4);
    }
    
    .btn-outline-secondary {
        border: 2px solid #6c757d;
        color: #6c757d;
    }
    
    .btn-outline-secondary:hover {
        background: #6c757d;
        color: white;
        transform: translateY(-3px);
    }
    
    .text-danger {
        font-size: 0.875rem;
        margin-top: 0.5rem;
    }
    
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .fade-in-up {
        animation: fadeInUp 0.6s ease;
    }
    
    .card {
        animation: fadeInUp 0.6s ease;
    }
    
    .info-card {
        animation: fadeInUp 0.6s ease;
        animation-delay: 0.2s;
    }
</style>